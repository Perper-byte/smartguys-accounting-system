generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------
// 1. SYSTEM ACCESS & SECURITY
// ------------------------------------------
model User {
  id            String   @id @default(uuid()) @db.VarChar(50)
  username      String   @unique @db.VarChar(100)
  password_hash String   @db.VarChar(255)
  role          Role     @default(CASHIER) 
  is_active     Boolean  @default(true) 

  journal_entries JournalEntry[]
  audit_logs      AuditLog[]

  @@map("users")
}

enum Role {
  CASHIER
  ACCOUNTANT
  MANAGER
  IT_PERSONNEL
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  timestamp  DateTime @default(now())
  user_id    String   @db.VarChar(50)
  action     String   @db.VarChar(100)
  details    String   @db.Text

  user       User     @relation(fields: [user_id], references: [id])

  @@index([timestamp])
  @@map("audit_logs")
}

// ------------------------------------------
// 2. CHART OF ACCOUNTS (Master Data)
// ------------------------------------------
model AccountType {
  id             String @id @default(uuid()) @db.VarChar(50)
  name           String @db.VarChar(100) 
  normal_balance String @db.VarChar(10) 

  accounts Account[]

  @@map("account_types")
}

model Account {
  code         String  @id @db.VarChar(50) 
  name         String  @db.VarChar(150)
  tax_category String? @db.VarChar(50) 
  type_id      String  @db.VarChar(50) 

  account_type  AccountType   @relation(fields: [type_id], references: [id])
  journal_lines JournalLine[]

  @@map("accounts")
}

// ------------------------------------------
// 3. TRANSACTIONS & BOOKKEEPING (Core Engine)
// ------------------------------------------
model Payee {
  id   String  @id @default(uuid()) @db.VarChar(50)
  name String  @db.VarChar(150)
  tin  String? @db.VarChar(50)

  journal_entries JournalEntry[]

  @@map("payees")
}

model JournalEntry {
  id           String   @id @default(uuid()) @db.VarChar(50)
  date         DateTime @db.DateTime
  reference_no String   @db.VarChar(100) 
  vat_type     String   @default("VATABLE") @db.VarChar(20) 
  description  String   @db.Text
  payee_id     String?  @db.VarChar(50) 
  user_id      String   @db.VarChar(50) 
  created_at   DateTime @default(now())

  // VOID SYSTEM STATUS
  status       String   @default("ACTIVE") @db.VarChar(20)
  void_reason  String?  @db.Text

  payee Payee?        @relation(fields: [payee_id], references: [id])
  user  User          @relation(fields: [user_id], references: [id])
  lines JournalLine[]

  @@index([date]) 
  @@index([reference_no]) 
  @@index([payee_id]) 
  @@index([created_at])
  @@map("journal_entries")
}

model JournalLine {
  id         String  @id @default(uuid()) @db.VarChar(50)
  debit      Decimal @default(0.00) @db.Decimal(15, 2)
  credit     Decimal @default(0.00) @db.Decimal(15, 2)
  entry_id   String  @db.VarChar(50) 
  account_id String  @db.VarChar(50) 

  entry   JournalEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [account_id], references: [code])

  @@index([account_id]) 
  @@index([entry_id]) 
  @@map("journal_lines")
}