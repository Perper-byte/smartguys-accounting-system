generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------
// 1. SYSTEM ACCESS & SECURITY
// ------------------------------------------
model User {
  id            String   @id @default(uuid()) @db.VarChar(50)
  username      String   @unique @db.VarChar(100)
  password_hash String   @db.VarChar(255)
  role          Role     @default(CASHIER) 
  is_active     Boolean  @default(true) 

  journal_entries JournalEntry[]
  audit_logs      AuditLog[]
  reconciliations Reconciliation[]

  @@map("users")
}

enum Role {
  CASHIER
  ACCOUNTANT
  MANAGER
  IT_PERSONNEL
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  timestamp  DateTime @default(now())
  user_id    String   @db.VarChar(50)
  action     String   @db.VarChar(100)
  details    String   @db.Text

  user       User     @relation(fields: [user_id], references: [id])

  @@index([timestamp])
  @@map("audit_logs")
}

// ------------------------------------------
// 2. CHART OF ACCOUNTS (Master Data)
// ------------------------------------------
model AccountType {
  id             String @id @default(uuid()) @db.VarChar(50)
  name           String @db.VarChar(100) 
  normal_balance String @db.VarChar(10) 

  accounts Account[]

  @@map("account_types")
}

model Account {
  code         String  @id @db.VarChar(50) 
  name         String  @db.VarChar(150)
  tax_category String? @db.VarChar(50) 
  type_id      String  @db.VarChar(50) 

  account_type  AccountType   @relation(fields: [type_id], references: [id])
  journal_lines JournalLine[]
  bank_accounts BankAccount[]

  @@map("accounts")
}

// ------------------------------------------
// 3. TRANSACTIONS & BOOKKEEPING (Core Engine)
// ------------------------------------------
model Payee {
  id           String  @id @default(uuid()) @db.VarChar(50)
  name         String  @db.VarChar(150)
  tin          String? @db.VarChar(50)
  type         String  @default("PATIENT") @db.VarChar(50) 
  
  // ---> NEW CRM FIELDS <---
  email        String? @db.VarChar(100)
  phone_number String? @db.VarChar(50)
  address      String? @db.Text

  journal_entries JournalEntry[]
  @@map("payees")
}

model JournalEntry {
  id           String   @id @default(uuid()) @db.VarChar(50)
  date         DateTime @db.DateTime
  reference_no String   @db.VarChar(100) 
  vat_type     String   @default("VATABLE") @db.VarChar(20) 
  description  String   @db.Text
  payee_id     String?  @db.VarChar(50) 
  user_id      String   @db.VarChar(50) 
  created_at   DateTime @default(now())

  // VOID SYSTEM STATUS
  status       String   @default("ACTIVE") @db.VarChar(20)
  void_reason  String?  @db.Text

  payee Payee?        @relation(fields: [payee_id], references: [id])
  user  User          @relation(fields: [user_id], references: [id])
  lines JournalLine[]
  reconciliation Reconciliation?

  @@index([date]) 
  @@index([reference_no]) 
  @@index([payee_id]) 
  @@index([created_at])
  @@map("journal_entries")
}

model JournalLine {
  id         String  @id @default(uuid()) @db.VarChar(50)
  debit      Decimal @default(0.00) @db.Decimal(15, 2)
  credit     Decimal @default(0.00) @db.Decimal(15, 2)
  entry_id   String  @db.VarChar(50) 
  account_id String  @db.VarChar(50) 

  entry   JournalEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [account_id], references: [code])

  @@index([account_id]) 
  @@index([entry_id]) 
  @@map("journal_lines")
}

// ------------------------------------------
// 4. HR & PAYROLL MODULE
// ------------------------------------------
model Employee {
  id             Int      @id @default(autoincrement())
  first_name     String   @db.VarChar(100)
  last_name      String   @db.VarChar(100)
  position       String   @db.VarChar(100) // e.g., "Head Nurse", "Receptionist"
  monthly_salary Decimal  @default(0.00) @db.Decimal(15, 2)
  
  // Government IDs
  tin            String?  @db.VarChar(50)
  sss_no         String?  @db.VarChar(50)
  philhealth_no  String?  @db.VarChar(50)
  pagibig_no     String?  @db.VarChar(50)

  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  @@map("employees")
}

model BankAccount {
  id              String            @id @default(uuid()) @db.VarChar(50)
  name            String            @db.VarChar(150)
  account_number  String?           @db.VarChar(100)
  ledger_account  String            @db.VarChar(50)
  created_at      DateTime          @default(now())

  ledger_account_ref Account          @relation(fields: [ledger_account], references: [code])
  transactions       BankTransaction[]

  @@index([ledger_account])
  @@map("bank_accounts")
}

model BankTransaction {
  id               String          @id @default(uuid()) @db.VarChar(50)
  bank_account_id  String          @db.VarChar(50)
  transaction_date DateTime        @db.DateTime
  description      String          @db.Text
  reference_no     String?         @db.VarChar(100)
  amount           Decimal         @db.Decimal(15, 2)
  status           String          @default("UNMATCHED") @db.VarChar(20)
  created_at       DateTime        @default(now())
  removed_at       DateTime?

  bank_account   BankAccount     @relation(fields: [bank_account_id], references: [id], onDelete: Cascade)
  reconciliation Reconciliation?

  @@index([bank_account_id, transaction_date])
  @@index([status])
  @@map("bank_transactions")
}

model Reconciliation {
  id                  String          @id @default(uuid()) @db.VarChar(50)
  bank_transaction_id String          @unique @db.VarChar(50)
  journal_entry_id    String          @unique @db.VarChar(50)
  matched_at          DateTime        @default(now())
  matched_by          String          @db.VarChar(50)

  bank_transaction BankTransaction @relation(fields: [bank_transaction_id], references: [id], onDelete: Cascade)
  journal_entry    JournalEntry    @relation(fields: [journal_entry_id], references: [id])
  user             User            @relation(fields: [matched_by], references: [id])

  @@map("reconciliations")
}