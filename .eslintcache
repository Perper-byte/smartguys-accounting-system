6,12846],[37,38],[84,86],[87,88],[122,124],[125,126],[156,157],[158,204],"  // 1. Function to secretly record actions",[205,276],"  async logAction(userId: string, action: string, details: string) {",[277,291],"    try {",[292,388],"      // First, verify the user actually exists in the DB to prevent Foreign Key crashes!",[395,477],"const userExists = await prisma.user.findUnique({ where: { id: userId } })",[478,491],[492,579],"      // If the user doesn't exist, we look for the SYSTEM user we just created.",[580,618],"      let validUserId = userId",[619,650],"      if (!userExists) {",[651,748],"        const sysUser = await prisma.user.findUnique({ where: { username: 'SYSTEM' } })",[749,845],"        if (!sysUser) return // If there is no SYSTEM user either, just quietly abort.",[846,888],"        validUserId = sysUser.id",[889,903],[904,905],[906,949],"      await prisma.auditLog.create({",[950,974],"        data: {",[975,1017],"          user_id: validUserId,",[1028,1046],"action,",[1047,1075],"          details",[1076,1094],"        }",[1095,1111],"      })",[1112,1138],"    } catch (error) {",[1139,1206],"      console.error('Failed to write to audit log:', error)",[1207,1217],"    }",[1218,1225],"  },",[1226,1227],[1228,1281],"  // 2. Function for the IT Admin to view the logs",[1282,1349],"  async getAuditLogs(startDateStr: string, endDateStr: string) {",[1350,1400],"    const startDate = new Date(startDateStr)",[1401,1441],"    startDate.setHours(0, 0, 0, 0)",[1442,1488],"    const endDate = new Date(endDateStr)",[1489,1532],"    endDate.setHours(23, 59, 59, 999)",[1533,1534],[1535,1583],"    return await prisma.auditLog.findMany({",[1584,1652],"      where: { timestamp: { gte: startDate, lte: endDate } },",[1653,1690],"      include: { user: true },",[1691,1734],"      orderBy: { timestamp: 'desc' }",[1735,1747],[1748,1754],[1756,1757],[41,42],[87,89],[90,91],[174,175],[229,230],[231,232],[275,276],[279,341],"test('Password hashing should be consistent', () => {",[342,389],"    const password = 'securePassword123!'",[390,448],"    const hash1 = AuthService.hashPassword(password)",[449,507],"    const hash2 = AuthService.hashPassword(password)",[508,509],[510,578],"    // The hash should always be the same for the same password",[583,614],"expect(hash1).toBe(hash2)",[615,623],[624,625],[626,692],"  test('Should throw error on empty credentials', async () => {",[693,753],"    // Expect the login function to reject empty string",[754,842],"    await expect(AuthService.login('', '')).rejects.toThrow('Invalid Credentials')",[845,853],[856,857],[27,29],[57,59],[105,107],[108,109],[143,145],[168,170],[171,172],[199,200],[269,270],[356,358],[390,424],"'Invalid username or password.')",[425,426],[490,491],[559,561],[562,563],[587,588],[637,638],[727,729],[730,731],[786,787],[831,917],"Buffer.from(legacyHash), Buffer.from(user.password_hash))",[918,919],[954,988],[989,990],[1061,1062],[1136,1138],[1171,1172],[1204,1205],[1252,1253],[1262,1264],[1265,1266],[1284,1286],[1299,1300],[1362,1363],[1439,1441],[1476,1510],[1511,1512],[1530,1532],[1538,1539],[1543,1544],[1545,1546],[1614,1615],[1647,1648],[1658,1659],[1708,1709],[1783,1784],[1792,1794],[1795,1796],[1823,1889],"prisma.$queryRaw`SELECT 1`, timeout])",[1890,1891],[1922,1924],{"messageId":"71332","fix":"71466","desc":"71334"},{"messageId":"71335","fix":"71467","desc":"71337"},[1951,1952],[2006,2008],[2014,2015],[2019,2020],[2022,2022],[43,44],[93,95],[120,122],[151,153],[154,155],[235,236],[239,313],"const testBackupPath = path.join(__dirname, 'test_integrity_scan.sql')",[314,315],[316,338],"  afterEach(() => {",[343,386],"// Clean up test file after scan tests",[387,432],"    if (fs.existsSync(testBackupPath)) {",[433,476],"      fs.unlinkSync(testBackupPath)",[477,487],[488,496],[497,498],[499,575],"  test('❌ FAIL: Integrity scan should fail on empty files', async () => {",[576,648],"    fs.writeFileSync(testBackupPath, '') // Create empty mock file",[649,732],"    const isValid = await BackupService.verifyBackupIntegrity(testBackupPath)",[737,770],"expect(isValid).toBe(false)",[771,779],[780,781],[782,862],"  test('❌ FAIL: Integrity scan should fail on truncated files', async () => {",[863,964],"    fs.writeFileSync(testBackupPath, 'INSERT INTO users VALUES (1, \"admin\");') // Truncated sql",[965,1048],[1049,1086],"    expect(isValid).toBe(false)",[1087,1095],[1096,1097],[1098,1196],"  test('✅ SUCCESS: Integrity scan should pass with a valid completion signature', async () => {",[1197,1307],"    const validMockContent =\n      'INSERT INTO users VALUES (1, \"admin\");\\n\\n-- Dump completed on 2026-06-23'",[1308,1368],"    fs.writeFileSync(testBackupPath, validMockContent)",[1369,1452],[1453,1489],"    expect(isValid).toBe(true)",[1490,1498],[1501,1502],[40,42],[67,69],[98,100],[139,141],[142,143],[172,173],[176,286],"private static parseDatabaseUrl(): {\n    user: string\n    pass: string\n    host: string\n    port: string\n    db: string\n  } {",[291,339],"const url = process.env.DATABASE_URL || ''",[340,415],"    const regex = /mysql:\\/\\/([^:]+):?([^@]+)?@([^:]+):?(\\d+)?\\/(.+)/",[416,458],"    const matches = url.match(regex)",[459,460],[465,485],"if (!matches) {",[486,568],"      throw new Error('System Error: Invalid database URL configuration.')",[569,579],[580,581],[582,599],"    return {",[600,630],"      user: matches[1],",[631,667],"      pass: matches[2] || '',",[668,698],"      host: matches[3],",[705,739],"port: matches[4] || '3306',",[740,768],"      db: matches[5]",[769,780],[781,787],[788,789],[790,911],"  static async executeBackup(): Promise<{\n    success: boolean\n    filePath?: string\n    error?: string\n    timestamp?: string\n  }> {",[912,926],[927,981],"      const dbConfig = this.parseDatabaseUrl()",[982,983],[984,1047],"      const { filePath } = await dialog.showSaveDialog({",[1048,1097],"        title: 'Create Database Backup',",[1098,1193],"        defaultPath: `smartguys_backup_${new Date().toISOString().split('T')[0]}.sql`,",[1194,1269],"        filters: [{ name: 'SQL Dump Files', extensions: ['sql'] }]",[1270,1286],[1287,1288],[1289,1388],"      if (!filePath) return { success: false, error: 'Backup cancelled by administrator.' }",[1389,1390],[1391,1437],"      let dumpExecutable = 'mysqldump'",[1438,1439],[1446,1513],"// OS Check: Only apply XAMPP fallback if running on Windows",[1514,1562],"      if (process.platform === 'win32') {",[1563,1637],"        const xamppPath = 'C:\\\\xampp\\\\mysql\\\\bin\\\\mysqldump.exe'",[1638,1686],"        if (fs.existsSync(xamppPath)) {",[1687,1735],"          dumpExecutable = xamppPath",[1736,1754],[1755,1769],[1770,1771],[1772,1845],"      // Using an arguments array prevents Shell/Command Injection",[1846,1873],"      const args = [",[1882,1911],"`-h`,\n        dbConfig.host,",[1920,1949],"`-P`,\n        dbConfig.port,",[1958,1987],"`-u`,\n        dbConfig.user,",[1988,2033],"        `--result-file=${filePath}`,",[2034,2062],"        dbConfig.db",[2063,2078],"      ]",[2079,2080],[2081,2134],"      // Insert password securely if it exists",[2135,2207],"      if (dbConfig.pass) args.splice(4, 0, `-p${dbConfig.pass}`)",[2208,2209],[2210,2256],"      return new Promise((resolve) => {",[2257,2309],"        // execFile is much safer than exec",[2318,2374],"execFile(dumpExecutable, args, async (err) => {",[2375,2476],"          if (err) return resolve({ success: false, error: `CLI Error: ${err.message}` })",[2477,2478],[2479,2559],"          const isValid = await this.verifyBackupIntegrity(filePath)",[2560,2561],[2562,2597],"          if (isValid) {",[2598,2700],"            resolve({ success: true, filePath, timestamp: new Date().toLocaleString() })",[2701,2730],"          } else {",[2731,2809],"            if (fs.existsSync(filePath)) fs.unlinkSync(filePath)",[2810,2912],"            resolve({ success: false, error: 'Integrity Scan Failed: Truncated file.' })",[2913,2935],"          }",[2936,2956],"        })",[2957,2973],[2974,3001],"    } catch (e: any) {",{"messageId":"71332","fix":"71468","desc":"71334"},{"messageId":"71335","fix":"71469","desc":"71337"},[3002,3059],"      return { success: false, error: e.message }",[3060,3070],[3071,3077],[3078,3079],[3080,3190],"  static async executeScheduledBackup(): Promise<{\n    success: boolean\n    filePath?: string\n    error?: string\n  }> {",[3191,3205],[3206,3260],[3261,3262],[3263,3372],"      // Automatically create an \"AutomatedBackups\" folder inside the app's hidden user data directory",[3373,3459],"      const backupDir = path.join(app.getPath('userData'), 'AutomatedBackups')",[3460,3505],"      if (!fs.existsSync(backupDir)) {",[3506,3568],"        fs.mkdirSync(backupDir, { recursive: true })",[3569,3583],[3584,3585],[3586,3637],"      // Name the file based on today's date",[3638,3738],"      const fileName = `smartguys_auto_backup_${new Date().toISOString().split('T')[0]}.sql`",[3739,3800],"      const filePath = path.join(backupDir, fileName)",[3801,3802],[3803,3849],[3856,3898],"if (process.platform === 'win32') {",[3899,3973],[3974,4048],"        if (fs.existsSync(xamppPath)) dumpExecutable = xamppPath",[4049,4063],[4064,4065],[4066,4093],[4102,4131],[4140,4169],[4178,4207],[4208,4253],[4254,4282],[4283,4298],[4299,4300],[4301,4373],[4374,4375],[4376,4422],[4423,4487],"        execFile(dumpExecutable, args, async (err) => {",[4488,4573],"          if (err) return resolve({ success: false, error: err.message })",[4574,4575],[4576,4656],[4657,4692],[4693,4755],"            resolve({ success: true, filePath })",[4756,4785],[4786,4864],[4865,4950],"            resolve({ success: false, error: 'Integrity Scan Failed' })",[4951,4973],[4974,4994],[4995,5011],[5012,5039],{"messageId":"71332","fix":"71470","desc":"71334"},{"messageId":"71335","fix":"71471","desc":"71337"},[5040,5097],[5102,5108],[5111,5115],[5116,5117],[5118,5202],"  public static async verifyBackupIntegrity(filePath: string): Promise<boolean> {",[5203,5255],"    if (!fs.existsSync(filePath)) return false",[5256,5257],[5258,5303],"    const stats = fs.statSync(filePath)",[5304,5348],"    if (stats.size === 0) return false",[5349,5350],[5351,5405],"    const fileBuffer = fs.readFileSync(filePath)",[5406,5494],"    const tail = fileBuffer.toString('utf8', Math.max(0, fileBuffer.length - 200))",[5495,5496],[5497,5551],"    return tail.includes('-- Dump completed on')",[5552,5558],[5559,5560],[5561,5663],"  static async executeRestore(sqlFilePath: string): Promise<{ success: boolean; error?: string }> {",[5664,5678],[5679,5733],[5734,5777],"      let mysqlExecutable = 'mysql'",[5778,5779],[5780,5828],[5837,5899],"const xamppPath = 'C:\\\\xampp\\\\mysql\\\\bin\\\\mysql.exe'",[5908,5975],"if (fs.existsSync(xamppPath)) mysqlExecutable = xamppPath",[5976,5990],[5991,5992],[5993,6122],"      // MySQL expects forward slashes for the 'source' command, otherwise Windows backslashes get interpreted as escapes.",[6123,6190],"      const formattedPath = sqlFilePath.replace(/\\\\/g, '/')",[6191,6192],[6193,6220],[6229,6258],[6267,6296],[6305,6334],[6343,6416],"`-e`,\n        `source ${formattedPath}`, // Executes the SQL file safely",[6417,6445],[6446,6461],[6462,6463],[6464,6536],[6537,6538],[6539,6585],[6586,6645],"        execFile(mysqlExecutable, args, (err) => {",[6646,6752],"          if (err) return resolve({ success: false, error: `Restore failed: ${err.message}` })",[6753,6801],"          resolve({ success: true })",[6802,6822],[6823,6839],[6840,6867],{"messageId":"71332","fix":"71472","desc":"71334"},{"messageId":"71335","fix":"71473","desc":"71337"},[6868,6925],[6926,6936],[6937,6943],[6945,6945],[38,39],[73,75],[100,102],[137,139],[190,192],[193,194],[223,224],[225,233],"  /**",[234,319],"   * Generates an Excel spreadsheet for the Trial Balance and prompts user to save",[320,328],"   */",[331,405],"static async exportTrialBalanceToExcel(year?: number, month?: number) {",[406,465],"    // 1. Setup the Date Filters and the Subtitle Text",[466,487],"    let endDate",[488,523],"    let dateText = 'All-Time'",[524,593],"    let filenameSuffix = new Date().toISOString().split('T')[0]",[594,595],[596,625],"    if (year && month) {",[626,686],"      endDate = new Date(year, month, 0, 23, 59, 59)",[687,790],"      const monthName = new Date(2000, month - 1, 1).toLocaleString('en-US', { month: 'long' })",[791,844],"      dateText = `As of ${monthName} ${year}`",[851,894],"filenameSuffix = `${year}_${month}`",[895,905],[906,907],[908,947],"    // 2. Fetch the filtered data!",[948,1027],"    const data = await ReportsService.getTrialBalance(undefined, endDate)",[1028,1029],[1030,1079],"    // 3. Prompt user where to save the file",[1080,1139],"    const { filePath } = await dialog.showSaveDialog({",[1140,1183],"      title: 'Export Trial Balance',",[1184,1249],"      defaultPath: `Trial_Balance_${filenameSuffix}.xlsx`,",[1256,1324],"filters: [{ name: 'Excel Worksheets', extensions: ['xlsx'] }]",[1325,1337],[1338,1339],[1340,1426],"    if (!filePath) return { success: false, error: 'Export cancelled by user.' }",[1427,1428],[1433,1468],"// 4. Build the Excel Workbook",[1469,1518],"    const workbook = new ExcelJS.Workbook()",[1519,1585],"    const worksheet = workbook.addWorksheet('Trial Balance')",[1586,1587],[1588,1612],"    // Title Header",[1613,1652],"    worksheet.mergeCells('A1:D1')",[1653,1704],"    const titleCell = worksheet.getCell('A1')",[1705,1770],"    titleCell.value = 'SmartGuys Community Healthcare Inc.'",[1771,1837],"    titleCell.font = { name: 'Arial', size: 14, bold: true }",[1838,1894],"    titleCell.alignment = { horizontal: 'center' }",[1895,1896],[1897,1939],"    // Subtitle Header with the Date!",[1940,1979],"    worksheet.mergeCells('A2:D2')",[1980,2034],"    const subtitleCell = worksheet.getCell('A2')",[2035,2134],"    subtitleCell.value = `Trial Balance Report - ${dateText}` // 🔥 Added the Date Text here!",[2135,2206],"    subtitleCell.font = { name: 'Arial', size: 11, italic: true }",[2207,2266],"    subtitleCell.alignment = { horizontal: 'center' }",[2267,2268],[2269,2299],"    worksheet.addRow([])",[2300,2397],"    const headerRow = worksheet.addRow(['Account Code', 'Account Name', 'Debit', 'Credit'])",[2398,2464],"    headerRow.font = { name: 'Arial', size: 11, bold: true }",[2465,2466],[2467,2511],"    data.lines.forEach((line: any) => {",{"messageId":"71332","fix":"71474","desc":"71334"},{"messageId":"71335","fix":"71475","desc":"71337"},[2512,2543],"      worksheet.addRow([",[2544,2586],"        Number(line.accountCode),",[2587,2621],"        line.accountName,",[2622,2674],"        line.debit > 0 ? line.debit : null,",[2675,2728],"        line.credit > 0 ? line.credit : null",[2729,2745],"      ])",[2746,2758],[2759,2760],[2761,2856],"    const totalRow = worksheet.addRow(['', 'Total', data.totalDebits, data.totalCredits])",[2857,2922],"    totalRow.font = { name: 'Arial', size: 11, bold: true }",[2923,2924],[2925,3025],"    worksheet.getColumn(3).numFmt = '_(\"₱\"* #,##0.00_);_(\"₱\"* (#,##0.00);_(\"₱\"* \"-\"??_);_(@_)'",[3026,3126],"    worksheet.getColumn(4).numFmt = '_(\"₱\"* #,##0.00_);_(\"₱\"* (#,##0.00);_(\"₱\"* \"-\"??_);_(@_)'",[3127,3128],[3129,3198],"    worksheet.getColumn(1).alignment = { horizontal: 'center' }",[3199,3200],[3201,3244],"    worksheet.columns.forEach((col) => {",[3245,3273],"      col.width = 25",[3274,3286],[3287,3288],[3289,3347],"    const buffer = await workbook.xlsx.writeBuffer()",[3348,3405],"    fs.writeFileSync(filePath, Buffer.from(buffer))",[3406,3407],[3408,3452],"    return { success: true, filePath }",[3453,3459],[3461,3461],[41,42],[88,90],[91,92],[126,128],[129,130],[162,163],[164,219],"  static async updateItem(id: string, data: any) {",{"messageId":"71332","fix":"71476","desc":"71334"},{"messageId":"71335","fix":"71477","desc":"71337"},[220,234],[235,296],"      const item = await prisma.inventoryItem.update({",[297,328],"        where: { id },",[329,353],[354,391],"      