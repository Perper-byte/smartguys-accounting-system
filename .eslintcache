ystem\\src\\renderer\\src\\components\\VoidApprovalsView.tsx:68:9\n  66 |     // Initial Fetch + refetch on tab switch\n  67 |     useEffect(() => {\n> 68 |         refresh();\n     |         ^^^^^^^ Avoid calling setState() directly within an effect\n  69 |     }, [viewMode]);\n  70 |\n  71 |     // Auto-dismiss success banner after 4 seconds","Replace `··},·[viewMode]);␍` with `},·[viewMode])`",{"range":"70138","text":"70139"},"React Hook useEffect has a missing dependency: 'refresh'. Either include it or remove the dependency array.",["70140"],{"range":"70141","text":"45467"},"Replace `····//·Auto-dismiss·success·banner·after·4·seconds␍` with `··//·Auto-dismiss·success·banner·after·4·seconds`",{"range":"70142","text":"70143"},{"range":"70144","text":"51552"},"Replace `········if·(status?.type·===·'success')·{␍` with `····if·(status?.type·===·'success')·{`",{"range":"70145","text":"70146"},"Replace `············const·timer·=·setTimeout(()·=>·setStatus(null),·4000);␍` with `······const·timer·=·setTimeout(()·=>·setStatus(null),·4000)`",{"range":"70147","text":"70148"},"Replace `············return·()·=>·clearTimeout(timer);␍` with `······return·()·=>·clearTimeout(timer)`",{"range":"70149","text":"70150"},{"range":"70151","text":"47904"},"Replace `····},·[status]);␍` with `··},·[status])`",{"range":"70152","text":"70153"},{"range":"70154","text":"45467"},"Replace `····//·Opens·the·custom·modal␍` with `··//·Opens·the·custom·modal`",{"range":"70155","text":"70156"},"Replace `····const·initiateAction·=·(id:·string,·action:·'APPROVE'·|·'REJECT')·=>·{␍` with `··const·initiateAction·=·(id:·string,·action:·'APPROVE'·|·'REJECT')·=>·{`",{"range":"70157","text":"70158"},"Replace `········setConfirmDialog({·isOpen:·true,·action,·id·});␍` with `····setConfirmDialog({·isOpen:·true,·action,·id·})`",{"range":"70159","text":"70160"},"Replace `········setStatus(null);·//·Clear·previous·alerts␍` with `····setStatus(null)·//·Clear·previous·alerts`",{"range":"70161","text":"70162"},{"ran