335","fix":"71649","desc":"71337"},[9415,9510],"      setStatus({ type: 'error', msg: err.message || 'Failed to submit to database.' })",[9515,9531],"} finally {",[9532,9563],[9564,9574],[9575,9582],[9583,9584],[9585,9633],"  const filteredPayees = payees.filter((p) => {",[9634,9675],"    if (!p || !p.name) return false",[9676,9776],"    return String(p.name)\n      .toLowerCase()\n      .includes(String(payeeSearchQuery || '').toLowerCase())",[9777,9785],[9786,9787],[9788,9893],"  const selectedPayeeName =\n    payees.find((p) => p.id === payeeId)?.name || '-- No Sub-Account Tagged --'",[9894,9895],[9898,9909],"return (",[9910,10025],"    <div className=\"w-full min-h-[calc(100vh-64px)] p-6 md:p-10 bg-[#f9fafb] animate-in fade-in duration-300\">",[10026,10134],"      <div className=\"max-w-5xl mx-auto bg-white border border-[#B0DCDA] rounded-xl p-8 shadow-sm\">",[10143,10166],"{/* HEADER */}",[10167,10271],"        <div className=\"flex justify-between items-center mb-6 border-b border-[#B0DCDA] pb-4\">",[10282,10387],"<h2 className=\"text-xl font-extrabold text-gray-800 tracking-wide\">\n            Record Adjusting Entry",[10398,10548],"</h2>\n          <span className=\"bg-[#E9FAFA] text-[#1B9387] text-xs px-4 py-1.5 rounded-full font-bold uppercase tracking-widest border border-[#B0DCDA]\">",[10549,10591],"            Adjusting Journal",[10592,10620],"          </span>",[10629,10644],[10645,10646],[10647,10676],"        {status && (",[10687,10889],"<div\n            className={`mb-6 p-4 rounded-md text-sm font-bold ${status.type === 'success' ? 'bg-[#E9FAFA] text-[#1B9387] border border-[#B0DCDA]' : 'bg-red-50 text-red-600 border border-red-200'}`}",[10900,10969],">\n            {status.type === 'success' ? '✅ ' : '⚠️ '}\n            {status.msg}",[10970,10997],"          </div>",[10998,11017],"        )}",[11018,11019],[11020,11082],"        <div className=\"grid gap-6 mb-6 grid-cols-2\">",[11093,11109],"<div>",[11110,11234],"            <label className=\"block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2\">\n              Date\n            </label>",[11247,11591],"<input\n              type=\"date\"\n              value={date}\n              onChange={(e) => setDate(e.target.value)}\n              className={`w-full bg-[#FBF8F8] border ${isLocked ? 'border-red-300 focus:ring-red-100' : 'border-[#B0DCDA] focus:ring-[#E9FAFA]'} rounded-md p-3 text-sm text-gray-800 font-medium focus:border-[#1B9387] focus:ring-2 outline-none transition cursor-pointer`}",[11604,11619],"/>\n          </div>",[11620,11621],[11622,11669],"          <div className=\"relative\">",[11670,11816],"            <label className=\"block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2\">\n              Reference No. (Correction)",[11829,12001],"</label>\n            <div className=\"flex bg-[#FBF8F8] border border-[#B0DCDA] rounded-md focus-within:border-[#1B9387] focus-within:ring-2 focus-within:ring-[#E9FAFA] transition\">",[12002,12194],"              <span className=\"bg-gray-50 border-r border-[#B0DCDA] rounded-l-md px-4 py-3 text-xs font-bold text-gray-600 flex items-center justify-center pointer-events-none\">",[12195,12232],"                ADJ-",[12247,12269],"</span>",[12270,12306],"              <input",[12307,12352],"                type=\"text\"",[12353,12406],"                value={refSequence}",[12423,12520],"onChange={(e) => {\n                  setRefSequence(e.target.value)\n                  setIsRefDropdownOpen(true)",[12537,12596],"}}\n                onFocus={() => setIsRefDropdownOpen(true)}",[12597,12695],"                onBlur={() => setTimeout(() => setIsRefDropdownOpen(false), 200)}",[12696,12765],"                placeholder=\"Search (e.g. OR-1001)\"",[12766,12892],"                className=\"w-full bg-transparent p-3 text-sm font-mono text-gray-800 font-bold outline-none\"",[12893,12924],"              />",[12925,12962],"              <button",[12963,13010],"                type=\"button\"",[13011,13072],"                onClick={fetchNextSequence}",[13073,13218],"                className=\"px-3 text-gray-400 hover:text-[#1B9387] bg-white border-l border-[#B0DCDA] transition cursor-pointer\"",[13219,13287],"                title=\"Auto-Generate Next Sequence\"",[13288,13318],"              >",[13319,13375],"                <RefreshCw size={14} />",[13376,13414],"              </button>",[13429,13682],"<button\n                type=\"button\"\n                onClick={() => setIsRefDropdownOpen(!isRefDropdownOpen)}\n                className=\"px-4 text-gray-400 hover:text-[#1B9387] bg-white border-l border-[#B0DCDA] rounded-r-md transition cursor-pointer\"\n                title=\"Search Past Transactions\"",[13697,13718],">\n                🔍",[13733,13757],[13758,13789],"            </div>",[13790,13791],[13792,13840],"            {isRefDropdownOpen && (",[13841,13991],"              <ul className=\"absolute z-50 w-full mt-1 bg-white border border-[#B0DCDA] rounded-md shadow-xl max-h-60 overflow-y-auto\">",[13992,14179],"                <li className=\"p-2 bg-gray-50 border-b border-gray-100 text-xs font-bold text-gray-400 uppercase tracking-wider sticky top-0\">\n                  Recent Database Entries",[14196,14225],"</li>\n                {pastEntries",[14244,14386],".filter(\n                    (e) =>\n                      e &&\n                      e.reference_no &&\n                      String(e.reference_no)\n                        .toLowerCase()\n                        .includes(String(refSequence || '').toLowerCase())",[14405,14439],")\n                  .map((entry) => (",[14440,14484],"                    <li",[14485,14544],"                      key={entry.id}",[14545,14610],"                      onMouseDown={() => {",[14611,14682],"                        // 1. Set the sequence",[14683,14796],"                        const cleanRef = String(entry.reference_no).replace('ADJ-', '')",[14797,14871],"                        setRefSequence(cleanRef)",[14872,14921],[14922,14996],"                        // 2. Set the description",[14997,15088],"                        if (description === 'Adjusting Entry: ') {",[15089,15237],"                          setDescription(\n                            `Adjusting Entry to correct ${entry.reference_no}: ${entry.description || ''}`",[15263,15288]," )\n                        }",[15289,15290],[15291,15361],"                        // 3. AUTO-FILL PAYEE",[15362,15484],"                        if (entry.payee_id || entry.payeeId || (entry.payee && entry.payee.id)) {",[15485,15600],"                          setPayeeId(entry.payee_id || entry.payeeId || entry.payee.id)",[15601,15651],"                        }",[15652,15653],[15654,15749],"                        // 🔥 4. AUTO-FILL JOURNAL LINES (BULLETPROOF)",[15750,15843],"                        if (entry.lines && entry.lines.length > 0) {",[15844,15949],"                          const prefilledLines = entry.lines.map((l: any) => {",{"messageId":"71332","fix":"71650","desc":"71334"},{"messageId":"71335","fix":"71651","desc":"71337"},[15950,16063],"                            // Find the account code from wherever Prisma stashed it",[16064,16140],"                            let foundCode = ''",[16141,16241],"                            if (l.account_id) foundCode = l.account_id",[16242,16345],"                            else if (l.accountId) foundCode = l.accountId",[16346,16468],"                            else if (l.account && l.account.code) foundCode = l.account.code",[16469,16526],[16527,16592],"                            return {",[16593,16676],"                              accountId: foundCode,",[16677,16766],"                              debit: Number(l.debit) || 0,",[16767,16857],"                              credit: Number(l.credit) || 0",[16858,16917],"                            }",[16918,16974],"                          })",[16975,17028],[17029,17147],"                          // Ensure there are always at least 2 empty boxes for UI purposes",[17148,17236],"                          while (prefilledLines.length < 2) {",[17237,17354],"                            prefilledLines.push({ accountId: '', debit: 0, credit: 0 })",[17355,17409],"                          }",[17410,17488],"                          setLines(prefilledLines)",[17489,17539],[17540,17587],"                      }}",[17588,17774],"                      className=\"p-3 text-sm text-gray-800 hover:bg-[#E9FAFA] hover:text-[#1B9387] cursor-pointer transition border-b border-gray-50 last:border-0\"",[17775,17817],"                    >",[17818,17919],"                      <div className=\"flex justify-between items-center mb-1\">",[17920,18049],"                        <span className=\"font-mono font-bold text-[#1B9387]\">\n                          {entry.reference_no}",[18074,18203],"</span>\n                        <span className=\"text-[10px] text-gray-400 font-bold\">\n                          {new Date(entry.date).toLocaleDateString()}",[18227,18255]," </span>\n                      </div>",[18256,18374],"                      <span className=\"text-gray-500 truncate block\">{entry.description}</span>",[18375,18421],"                    </li>",[18422,18462],"                  ))}",[18463,18497],"              </ul>",[18498,18525],"            )}",[18526,18553],[18554,18577],[18578,18579],[18580,18620],"        {/* OVERRIDE PIN UI */}",[18621,18652],"        {isLocked && (",[18653,18812],"          <div className=\"mb-6 bg-red-50 border border-red-200 rounded-lg p-4 animate-in fade-in flex items-center justify-between gap-4 shadow-sm\">",[18813,18862],"            <div className=\"flex-1\">",[18863,18963],"              <h4 className=\"text-red-700 font-bold text-sm flex items-center gap-2\">",[18964,19032],"                <Lock size={16} /> Period is Locked",[19033,19067],"              </h4>",[19068,19153],"              <p className=\"text-xs text-red-600/80 font-medium mt-1\">",[19154,19274],"                You are backdating into a closed accounting period. A Manager Override PIN is",[19291,19308],"required.\n              </p>",[19309,19340],[19341,19373],"            <input",[19374,19419],"              type=\"password\"",[19420,19473],"              placeholder=\"Enter PIN\"",[19474,19522],"              value={overridePin}",[19523,19598],"              onChange={(e) => setOverridePin(e.target.value)}",[19599,19819],"              className=\"w-40 bg-white border border-red-300 rounded p-2.5 text-sm font-mono font-bold text-center text-gray-800 outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 shadow-sm\"",[19820,19847],"            />",[19848,19875],[19876,19895],[19896,19897],[19898,19977],"        <div className=\"mb-6 border-b border-[#B0DCDA] pb-6 relative\">",[19978,20021],"          <div className=\"mb-6\">",[20022,20100],"            <div className=\"flex justify-between items-end mb-2\">",[20101,20252],"              <label className=\"block text-xs font-bold text-gray-500 uppercase tracking-wider\">\n                Contact / Subsidiary (For AR/AP)\n              </label>",[20267,20481],"<button\n                type=\"button\"\n                onClick={() => setIsNewContactModalOpen(true)}\n                className=\"bg-[#1B9387] hover:bg-[#28958B] text-white text-xs font-bold px-4 py-2 rounded-md transition shadow-sm cursor-pointer\"",[20496,20528],">\n                + New Contact",[20529,20567],[20568,20599],[20600,20601],[20602,20658],"            <div className=\"relative mt-2\">",[20673,20979],"<div\n                onClick={() => setIsPayeeDropdownOpen(!isPayeeDropdownOpen)}\n                className={`w-full bg-[#FBF8F8] border ${isPayeeDropdownOpen ? 'border-[#1B9387] ring-2 ring-[#E9FAFA]' : 'border-[#B0DCDA]'} rounded-md p-3 text-sm text-gray-800 transition cursor-pointer flex justify-between items-center`}",[20994,21113],">\n                <span className={payeeId ? 'text-gray-800 font-medium' : 'text-gray-400'}>\n                  {selectedPayeeName}",[21130,21149],"</span>\n              </div>",[21150,21151],[21152,21206],"              {isPayeeDropdownOpen && (",[21207,21353],"                <div className=\"absolute z-20 w-full mt-1 bg-white border border-[#B0DCDA] rounded-md shadow-xl overflow-hidden\">",[21354,21449],"                  <div className=\"p-2 border-b border-[#B0DCDA] bg-gray-50\">",[21470,21735],"<input\n                      type=\"text\"\n                      autoFocus\n                      placeholder=\"🔍 Search contact name...\"\n                      value={payeeSearchQuery}\n                      onChange={(e) => setPayeeSearchQuery(e.target.value)}\n                      className=\"w-full bg-transparent p-2 text-sm text-gray-800 outline-none placeholder-gray-400\"",[21754,21779],"  />\n                  </div>",[21780,21858],"                  <ul className=\"max-h-48 overflow-y-auto\">",[21878,22112]," <li\n                      onClick={() => {\n                        setPayeeId('')\n                        setIsPayeeDropdownOpen(false)\n                        setPayeeSearchQuery('')\n                      }}\n                      className=\"p-3 text-sm text-gray-500 hover:bg-[#E9FAFA] hover:text-[#1B9387] cursor-pointer transition font-medium\"",[22133,22185],">\n                      -- No Sub-Account Tagged --",[22186,22232],[22233,22307],"                    {filteredPayees.map((p: any) => (",{"messageId":"71332","fix":"71652","desc":"71334"},{"messageId":"71335","fix":"71653","desc":"71337"},[22330,22590],"<li\n                        key={p.id}\n                        onClick={() => {\n                          setPayeeId(p.id)\n                          setIsPayeeDropdownOpen(false)\n                          setPayeeSearchQuery('')\n                        }}\n                        className=\"p-3 text-sm text-gray-800 hover:bg-[#E9FAFA] hover:text-[#1B9387] cursor-pointer transition border-t border-gray-50\"",[22613,22648],">\n                        {p.name}",[22649,22699],"                      </li>",[22700,22744],"                    ))}",[22745,22787],"                  </ul>",[22804,22827],[22842,22859],")}",[22860,22891],[22892,22919],[22920,22921],[22922,22948],"          <div>",[22949,23087],"            <label className=\"block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2\">\n              Description / Memo",[23100,23442],"</label>\n            <textarea\n              value={description}\n              onChange={(e) => setDescription(e.target.value)}\n              placeholder=\"Type transaction details here...\"\n              className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-3 text-sm text-gray-800 h-20 resize-none font-medium focus:border-[#1B9387] focus:ring-2 focus:ring-[#E9FAFA] outline-none transition\"",[23453,23470],"  />\n          </div>",[23479,23494],[23495,23496],[23505,23607],"<div className=\"border border-[#B0DCDA] rounded-md bg-white overflow-visible mb-6 shadow-sm\">",[23608,23655],"          <table className=\"w-full\">",[23656,23737],"            <thead className=\"bg-gray-50 border-b border-[#B0DCDA]\">",[23738,23840],"              <tr className=\"text-left text-gray-500 text-xs uppercase tracking-wider\">",[23841,23960],"                <th className=\"p-3.5 pl-5 font-extrabold border-r border-[#B0DCDA] w-1/2\">\n                  Account",[23977,24084],"</th>\n                <th className=\"p-3.5 w-1/4 text-right font-extrabold border-r border-[#B0DCDA]\">\n                  Debit",[24101,24209],"</th>\n                <th className=\"p-3.5 w-1/4 text-right font-extrabold border-r border-[#B0DCDA]\">\n                  Credit",[24226,24275],"</th>\n                <th className=\"p-3.5 w-12\"></th>",[24290,24310],"</tr>",[24311,24344],"            </thead>",[24345,24414],"            <tbody className=\"divide-y divide-gray-100\">",[24415,24471],"              {lines.map((line, idx) => (",[24487,24593]," <tr\n                  key={idx}\n                  className=\"even:bg-gray-50 odd:bg-white hover:bg-[#E9FAFA]/50 transition\"",[24610,24696],">\n                  <td className=\"p-0 border-r border-[#B0DCDA] relative align-top\">",[24697,24767],"                    {activeAccountRow === idx ? (",[24768,24948],"                      <div className=\"absolute z-50 left-0 top-0 w-full min-w-[350px] bg-white border border-[#1B9387] shadow-xl rounded-md overflow-hidden\">",[24949,25058],"                        <div className=\"p-2 bg-[#FBF8F8] border-b border-[#B0DCDA]\">",[25085,25423],"<input\n                            type=\"text\"\n                            autoFocus\n                            placeholder=\"🔍 Type account code or name...\"\n                            value={accountSearchQuery}\n                            onChange={(e) => setAccountSearchQuery(e.target.value)}\n                            onBlur={() => setTimeout(() => setActiveAccountRow(null), 200)}\n                            className=\"w-full bg-transparent p-1.5 text-sm text-gray-800 outline-none font-medium\"",[25450,25479],"/>\n                        </div>",[25480,25579],"                        <ul className=\"max-h-48 overflow-y-auto bg-white\">",[25606,25776],"{accounts\n                            .filter(\n                              (a) =>\n                                a &&\n                                a.name &&\n                                `${a.code} ${a.name}`\n                                  .toLowerCase()\n                                  .includes(String(accountSearchQuery || '').toLowerCase())\n                            )\n                            .map((acc) => (",[25805,26104],"  <li\n                                key={acc.code}\n                                onMouseDown={() => {\n                                  updateLine(idx, 'accountId', acc.code)\n                                  setActiveAccountRow(null)\n                                }}\n                                className=\"p-3 text-sm text-gray-700 hover:bg-[#E9FAFA] hover:text-[#1B9387] cursor-pointer transition border-b border-gray-50 last:border-0 flex items-center\"",[26135,26254],">\n                                <span className=\"font-mono font-bold text-[#1B9387] w-14 inline-block\">\n                                  {acc.code}",[26287,26363],"</span>\n                                <span className=\"font-medium\">{acc.name}</span>",[26364,26426],"                              </li>\n                            ))}",[26451,26483],"</ul>\n                      </div>",[26504,26538],") : (\n                      <div",[26563,26637],"onClick={() => {\n                          setActiveAccountRow(idx)\n                          setAccountSearchQuery('')",[26662,26885],"}}\n                        className=\"w-full h-full min-h-[44px] p-3.5 pl-5 text-sm text-gray-800 cursor-text flex justify-between items-center group\"",[26908,26954],">\n                        {line.accountId ? (",[26955,27014],"                          <span>",[27015,27158],"                            <span className=\"font-mono font-extrabold text-[#1B9387] mr-3\">\n                              {line.accountId}",[27187,27320],"</span>\n                            <span className=\"font-medium text-gray-800\">\n                              {accounts.find((a) => a.code === line.accountId)?.name}",[27349,27381],"</span>\n                          </span>",[27406,27615],") : (\n                          <span className=\"text-gray-400 italic font-medium\">\n                            Type to search account...\n                          </span>\n                        )}",[27632,27658],"      </div>\n                    )}",[27677,27752],"</td>\n                  <td className=\"p-0 border-r border-[#B0DCDA] align-top\">",[27753,27845],"                    <div className=\"relative flex items-center h-full\">",[27846,27965],"                      <span className=\"absolute left-3 text-gray-400 font-mono text-xs\">₱</span>",[27988,28371],"<input\n                        type=\"number\"\n                        min=\"0\"\n                        step=\"0.01\"\n                        value={line.debit === 0 ? '' : line.debit}\n                        placeholder=\"0.00\"\n                        onChange={(e) => updateLine(idx, 'debit', parseFloat(e.target.value) || 0)}\n                        className=\"w-full h-full min-h-[44px] bg-transparent pl-8 pr-3 text-sm text-right text-gray-800 font-mono font-bold outline-none placeholder-gray-300 focus:bg-[#E9FAFA] transition\"",[28392,28419],"  />\n                    </div>",[28420,28462],"                  </td>",[28463,28556],"                  <td className=\"p-0 border-r border-[#B0DCDA] align-top\">",[28557,28649],[28650,28769],[28792,29178],"<input\n                        type=\"number\"\n                        min=\"0\"\n                        step=\"0.01\"\n                        value={line.credit === 0 ? '' : line.credit}\n                        placeholder=\"0.00\"\n                        onChange={(e) => updateLine(idx, 'credit', parseFloat(e.target.value) || 0)}\n                        className=\"w-full h-full min-h-[44px] bg-transparent pl-8 pr-3 text-sm text-right text-gray-800 font-mono font-bold outline-none placeholder-gray-300 focus:bg-[#E9FAFA] transition\"",[29200,29226]," />\n                    </div>",[29227,29269],[29270,29352],"                  <td className=\"p-2 text-center align-middle\">",[29373,29587],"<button\n                      type=\"button\"\n                      onClick={() => removeLine(idx)}\n                      disabled={lines.length <= 2}\n                      className=\"text-red-400 hover:text-red-600 disabled:opacity-20 transition cursor-pointer font-bold\"",[29608,29630],">\n                      ✕",[29651,29702],"</button>\n                  </td>\n                </tr>",[29717,29736],"))}\n            </tbody>",[29737,29766],"          </table>",[29767,29790],[29791,29792],[29793,29832],"        <div className=\"mb-6\">",[29833,29960],"          <label className=\"block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2\">\n            Attachments",[29971,29987],"</label>\n          <div",[29988,30077],"            onDragOver={(e) => {\n              e.preventDefault()\n              setIsDragging(true)",[30090,30169],"}}\n            onDragLeave={(e) => {\n              e.preventDefault()\n              setIsDragging(false)",[30182,30214],"}}\n            onDrop={handleDrop}",[30215,30450],"            className={`mt-2 border-2 border-dashed rounded-xl p-8 flex flex-col items-center justify-center transition-all ${isDragging ? 'bg-[#E9FAFA] border-[#1B9387]' : 'bg-gray-50 border-gray-300 hover:bg-gray-100'}`}",[30451,30473],"          >",[30474,30594],"            <UploadCloud\n              className={`mb-3 ${isDragging ? 'text-[#1B9387]' : 'text-gray-400'}`}\n              size={32}",[30607,30711],"/>\n            <p className=\"text-sm font-bold text-gray-600\">\n              Drag and drop or upload attachments here",[30724,30823],"</p>\n            <p className=\"text-xs text-gray-400 mt-1\">JPG, PNG, PDF, XLSX, ZIP. Max 10mb each.</p>\n",[30836,30849],"<input\n              type=\"file\"",[30864,31014],"multiple\n              id=\"file-upload-adj\"\n              className=\"hidden\"\n              onChange={handleFileSelect}\n              accept=\".jpg,.jpeg,.png,.pdf,.zip,.xlsx\"",[31027,31248],"/>\n            <label\n              htmlFor=\"file-upload-adj\"\n              className=\"mt-4 cursor-pointer bg-white border border-gray-300 text-gray-700 px-5 py-2 rounded-md text-xs font-bold hover:bg-gray-50 transition shadow-sm\"\n            >\n              Browse Files",[31261,31276],"</label>\n          </div>",[31277,31278],[31279,31328],"          {attachments.length > 0 && (",[31329,31399],"            <div className=\"mt-4 grid grid-cols-2 gap-3\">",[31400,31460],"              {attachments.map((file, i) => (",[31477,31611],"<div\n                  key={i}\n                  className=\"flex justify-between items-center p-3 bg-white border border-[#B0DCDA] rounded-lg shadow-sm\"",[31628,31706],">\n                  <div className=\"flex items-center gap-3 overflow-hidden\">",[31707,31900],"                    {file.type.includes('image') ? (\n                      <ImageIcon size={18} className=\"text-[#1B9387] shrink-0\" />\n                    ) : (\n                      <FileIcon size={18} className=\"text-[#1B9387] shrink-0\" />",[31921,31989],")}\n                    <div className=\"flex flex-col overflow-hidden\">",[31990,32112],"                      <span className=\"text-sm font-bold text-gray-700 truncate\">{file.name}</span>",[32113,32160],"                    </div>",[32161,32204],"                  </div>",[32223,32437],"<button\n                    type=\"button\"\n                    onClick={() => removeAttachment(i)}\n                    className=\"p-1.5 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-md transition cursor-pointer shrink-0\"",[32456,32510],">\n                    <X size={16} />\n                  </button>",[32527,32542],"</div>\n              ))}",[32555,32590],"</div>\n          )}\n        </div>",[32591,32592],[32593,32663],"        <div className=\"flex justify-between items-end mt-6\">",[32674,32897],"<button\n            type=\"button\"\n            onClick={addLine}\n            className=\"text-[#1B9387] text-sm font-bold hover:bg-[#E9FAFA] px-5 py-2.5 rounded-md transition border border-transparent hover:border-[#B0DCDA] shadow-sm cursor-pointer\"",[32908,32933],">\n            + Add Line",[32934,32964],"          </button>",[32965,32966],[32967,33092],"          <div className=\"text-right bg-[#E9FAFA] p-5 rounded-md border border-[#B0DCDA] min-w-[300px] shadow-sm\">",[33093,33169],"            <div className=\"flex justi