0', name: 'Expanded Withholding Tax (EWT) Payable', type_id: 'type-liability' },",[2820,2901],"    { code: '2100', name: 'Bank Loans Payable', type_id: 'type-liability' },",[2902,2978],"    { code: '3010', name: \"Owner's Capital\", type_id: 'type-equity' },",[2979,3056],"    { code: '3020', name: \"Owner's Drawings\", type_id: 'type-equity' },",[3057,3135],"    { code: '4010', name: 'Consultation Fees', type_id: 'type-revenue' },",[3136,3227],"    { code: '4020', name: 'Laboratory / Diagnostic Income', type_id: 'type-revenue' },",[3228,3314],"    { code: '4030', name: 'Medicine / Pharmacy Sales', type_id: 'type-revenue' },",[3315,3400],"    { code: '4040', name: 'Medical Certificate Fees', type_id: 'type-revenue' },",[3401,3486],"    { code: '5010', name: 'Medical Supplies Expense', type_id: 'type-expense' },",[3487,3565],"    { code: '5020', name: 'Utilities Expense', type_id: 'type-expense' },",[3566,3652],"    { code: '5030', name: 'Professional Fees Expense', type_id: 'type-expense' },",[3653,3726],"    { code: '5040', name: 'Rent Expense', type_id: 'type-expense' },",[3727,3808],"    { code: '5050', name: 'Depreciation Expense', type_id: 'type-expense' },",[3813,3888],"{ code: '5100', name: 'Salaries and Wages', type_id: 'type-expense' }",[3889,3896],"  ]",[3897,4018],"  for (const acc of accounts) {\n    await prisma.account.upsert({ where: { code: acc.code }, update: {}, create: acc })\n  }",[4019,4067],"  console.log('✅ Chart of Accounts seeded.')",[4068,4069],[4072,4091],"// 3. Seed Users",[4092,4143],"  const dummyAccountantPassword = 'password123'",[4144,4244],"  const passwordHash = crypto.createHash('sha256').update(dummyAccountantPassword).digest('hex')",[4245,4265],"  const users = [",[4266,4349],"    { username: 'SYSTEM', role: 'IT_PERSONNEL' }, // 🔥 Added the SYSTEM user!",[4350,4401],"    { username: 'cashier', role: 'CASHIER' },",[4402,4459],"    { username: 'accountant', role: 'ACCOUNTANT' },",[4460,4511],"    { username: 'manager', role: 'MANAG