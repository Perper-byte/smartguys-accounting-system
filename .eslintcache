ses = 0",[4400,4401],[4402,4451],"    for (const line of trialBalance.lines) {",[4458,4502],"if (line.accountType === 'Revenue') {",[4503,4560],"        const amount = line.credit - line.debit",[4561,4632],"        revenueLines.push({ name: line.accountName, amount })",[4633,4673],"        totalRevenue += amount",[4674,4731],"      } else if (line.accountType === 'Expense') {",[4732,4789],"        const amount = line.debit - line.credit",[4790,4861],"        expenseLines.push({ name: line.accountName, amount })",[4862,4903],"        totalExpenses += amount",[4904,4918],[4919,4929],[4930,4931],[4932,4949],[4950,4985],"      revenue: revenueLines,",[4986,5022],"      expenses: expenseLines,",[5023,5082],"      totalRevenue: Number(totalRevenue.toFixed(2)),",[5083,5144],"      totalExpenses: Number(totalExpenses.toFixed(2)),",[5145,5219],"      netIncome: Number((totalRevenue - totalExpenses).toFixed(2))",[5220,5231],[5232,5238],[5239,5240],[5241,5307],"  static async getBalanceSheet(year?: number, month?: number) {",[5308,5329],[5330,5359],[5360,5420],[5421,5431],[5432,5433],[5434,5511],"    const trialBalance = await this.getTrialBalance(undefined, endDate)",[5512,5588],"    const incomeStatement = await this.getIncomeStatement(year, month)",[5589,5590],[5591,5629],"    const assetLines: any[] = []",{"messageId":"71332","fix":"71518","desc":"71334"},{"messageId":"71335","fix":"71519","desc":"71337"},[5630,5672],"    const liabilityLines: any[] = []",{"messageId":"71332","fix":"71520","desc":"71334"},{"messageId":"71335","fix":"71521","desc":"71337"},[5673,5712],"    const equityLines: any[] = []",{"messageId":"71332","fix":"71522","desc":"71334"},{"messageId":"71335","fix":"71523","desc":"71337"},[5713,5781],"    let totalAssets = 0,\n      totalLiabilities = 0,\n      totalEquity = 0",[5786,5841],"let cumulativeRevenue = 0,\n      cumulativeExpenses = 0",[5842,5843],[5844,5893],[5900,5942],"if (line.accountType === 'Asset') {",[5943,6000],[6001,6070],"        assetL