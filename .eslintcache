) => setStatus(null), 4000)",[5185,5211],[5212,5291],"      setStatus({ type: 'error', msg: 'Failed to create new record.' })",[5292,5343],"    } finally {\n      setIsSubmittingPayee(false)",[5349,5353],[5356,5379],"}\n\n  // Live Calculations",[5380,5440],"  const grossAmount = Math.abs(Number(amountToPay) || 0)",[5441,5503],"  const ewtAmount = grossAmount * (selectedATC.rate / 100)",[5504,5551],"  const netAmount = grossAmount - ewtAmount",[5552,5698],"  const formatCurrency = (val: number) =>\n    `₱ ${Math.abs(val).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`",[5699,5700],[5701,5741],[5742,5778],"    setShowConfirmModal(false)",[5779,5804],[5805,5806],[5807,5821],[5822,5852],"      setLoading(true)",[5853,5881],[5882,5952],"        { accountId: '2010', debit: grossAmount, credit: 0 },",[5953,6027],"        { accountId: sourceAccount, debit: 0, credit: netAmount }",[6028,6043],[6044,6147],"      if (ewtAmount > 0) lines.splice(1, 0, { accountId: '2050', debit: 0, credit: ewtAmount })",[6148,6149],[6150,6220],[6221,6304],[6305,6306],[6307,6339],"      const entryData = {",[6348,6392],"date: new Date(date).toISOString(),",[6393,6439],[6440,6550],"        description: `Payout to ${selectedPayee?.name} - ${remarks} (Less ${selectedATC.rate}% EWT)`,",[6551,6633],"        vatType: 'EXEMPT',\n        userId: userId,\n        payeeId: payeeId,\n        lines: lines",[6634,6649],[6650,6651],[6652,6728],{"messageId":"71332","fix":"71898","desc":"71334"},{"messageId":"71335","fix":"71899","desc":"71337"},{"messageId":"71332","fix":"71900","desc":"71334"},{"messageId":"71335","fix":"71901","desc":"71337"},[6729,6799],"      const response = await api.submitJournalEntry(entryData)",[6800,6889],"      if (response && response.success === false) throw new Error(response.error)",[6890,6891],[6892,7023],"      setStatus({\n        type: 'success',\n        msg: `Voucher ${fullReferenceNo} recorded! Net Payout: ${formatCurrency(netAmount)}.`",[7030,7174],"})\n      setGenerated2307({\n        payee: selectedPayee,\n        date: new Date(date),\n        gross: grossAmount,\n        tax: ewtAmount,\n        net: netAmount,\n        atc: selectedATC",[7181,7196],"})\n\n      // Reset",[7203,7283],"setAmountToPay('')\n      setRemarks('')\n      setPayeeId('')\n      setPaymentMethod('')",[7284,7308],"      loadData()",[7309,7362],"      setTimeout(() => setStatus(null), 6000)",[7363,7394],{"messageId":"71332","fix":"71902","desc":"71334"},{"messageId":"71335","fix":"71903","desc":"71337"},[7395,7499],"      setStatus({ type: 'error', msg: error.message || 'System Error: Could not save payout.' })",[7500,7541],[7547,7551],[7554,7629],"}\n\n  // 🔥 Form is valid as long as required fields are filled and amount > 0",[7632,7663],"const isFormValid = Boolean(",[7664,7784],"    payeeId && paymentMethod && sourceAccount && refSequence && grossAmount > 0",[7785,7792],[7793,7794],[7795,7837],"  // 🔥 Informative Button Label Helper",[7838,7873],"  const getButtonLabel = () => {",[7874,7919],"    if (loading) return 'Processing...'",[7920,7968],"    if (!payeeId) return 'Select a Doctor'",[7973,8029],"if (!paymentMethod) return 'Select Payment Method'",[8030,8091],"    if (!sourceAccount) return 'Select Source of Funds'",[8092,8158],"    if (!refSequence) return 'Enter Reference / Voucher No.'",[8159,8225],"    if (grossAmount <= 0) return 'Enter Gross Payout Amount'",[8226,8290],"    return `✓ ISSUE PAYOUT — ${formatCurrency(netAmount)}`",[8291,8298],[8299,8300],[8301,8363],[8364,8365],[8368,8379],[8380,8511],[8512,8642],[8649,8678],[8679,8814],"        <h2 className=\"text-2xl font-extrabold text-gray-800 tracking-wide\">\n          Doctor OR Landlord Payouts/ & Withholding Tax",[8823,8953],"</h2>\n        <p className=\"text-sm text-gray-500 mt-1 font-medium\">\n          Settle Accounts Payable and generate BIR Form 2307 equivalents.",[8962,8973],"</p>\n      </div>",[8974,8975],[8976,9050],[9051,9098],[9107,9226],"<div className=\"flex-1 w-full bg-white border border-[#B0DCDA] rounded-xl shadow-sm relative overflow-hidden\">",[9227,9350],"          <div className=\"bg-[#FBF8F8] border-b border-[#B0DCDA] px-6 py-4 flex justify-between items-center\">",[9351,9444],"            <h3 className=\"text-lg font-extrabold text-gray-800\">New Payout</h3>",[9445,9612],[9613,9661],"              💸 Professional Fee",[9662,9694],"            </span>",[9695,9722],[9723,9724],[9725,9758],[9771,9982],"<div\n              className={`m-6 mb-0 p-4 rounded-md text-sm font-bold shadow-sm border ${status.type === 'success' ? 'bg-[#E9FAFA] text-[#1B9387] border-[#B0DCDA]' : 'bg-red-50 text-red-600 border-red-200'}`}",[9995,10066],">\n              {status.type === 'success' ? '✅ ' : '⚠️ '}",[10081,10098],"{status.msg}\n            </div>",[10099,10122],[10123,10124],[10135,10266],"<form\n            className=\"p-6 space-y-6\"\n            onSubmit={(e) => {\n              e.preventDefault()\n              if (isFormValid) setShowConfirmModal(true)\n            }}",[10277,10322],">\n            {/* ROW 1: PAYEE SELECTION */}",[10323,10403],"            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">",[10404,10475],"              <div className=\"col-span-2 relative z-20\">",[10476,10564],"                <div className=\"flex justify-between items-end mb-1.5\">",[10565,10723],"                  <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider\">\n                    Search Doctor/Landlord\n                  </label>",[10742,10956],"<button\n                    type=\"button\"\n                    onClick={() => setShowAddPayee(!showAddPayee)}\n                    className=\"text-[10px] font-extrabold text-[#1B9387] hover:text-[#28958B] transition uppercase tracking-wider cursor-pointer\"",[10975,11037],">\n                    {showAddPayee ? 'Cancel' : '+ Add New'}",[11038,11084],"                  </button>",[11085,11124],[11125,11126],[11143,11178],"{showAddPayee && (",[11179,11316],"                  <div className=\"mb-2 p-2.5 bg-[#E9FAFA] border border-[#B0DCDA] rounded-md flex gap-2 shadow-inner\">",[11337,11587],"<input\n                      type=\"text\"\n                      placeholder=\"e.g. Dr. Smith\"\n                      value={newPayeeName}\n                      onChange={(e) => setNewPayeeName(e.target.value)}\n                      className=\"flex-1 bg-white border border-[#B0DCDA] rounded px-3 text-sm text-gray-800 outline-none\"\n                      autoFocus",[11608,11849],"/>\n                    <button\n                      type=\"button\"\n                      onClick={handleCreatePayee}\n                      disabled={isSubmittingPayee || !newPayeeName.trim()}\n                      className=\"bg-[#1B9387] hover:bg-[#28958B] text-white text-xs font-bold px-4 py-1.5 rounded transition\"\n                    >",[11867,11893],"     Save\n                    </button>",[11912,11929],[11930,11931],[11948,12252],"<div\n                  onClick={() => setIsPayeeDropdownOpen(!isPayeeDropdownOpen)}\n                  className={`w-full bg-[#FBF8F8] border ${isPayeeDropdownOpen ? 'border-[#1B9387] ring-1 ring-[#1B9387]' : 'border-[#B0DCDA]'} rounded-md p-3 text-sm transition cursor-pointer flex justify-between items-center shadow-sm`}",[12269,12427],">\n                  <span\n                    className={payeeId ? 'text-gray-800 font-bold' : 'text-gray-400 font-medium'}\n                  >\n                    {selectedPayee?.name || '-- Select Doctor --'}",[12446,12513],"</span>\n                  <span className=\"text-xs text-gray-400\">▼</span>",[12514,12553],[12554,12555],[12556,12614],"                {isPayeeDropdownOpen && (",[12633,12760],"<div className=\"absolute w-full mt-1 bg-white border border-[#B0DCDA] rounded-md shadow-xl overflow-hidden\">",[12761,12862],"                    <div className=\"p-2 border-b border-[#B0DCDA] bg-[#FBF8F8]\">",[12885,13174],"<input\n                        type=\"text\"\n                        autoFocus\n                        placeholder=\"🔍 Search doctors...\"\n                        value={payeeSearchQuery}\n                        onChange={(e) => setPayeeSearchQuery(e.target.value)}\n                        className=\"w-full bg-white border border-gray-200 rounded p-2 text-sm text-gray-800 outline-none focus:border-[#1B9387]\"",[13197,13222],"/>\n                    </div>",[13223,13305],"                    <ul className=\"max-h-48 overflow-y-auto\">",[13327,13589]," <li\n                        onClick={() => {\n                          setPayeeId('')\n                          setIsPayeeDropdownOpen(false)\n                          setPayeeSearchQuery('')\n                        }}\n                        className=\"p-3 text-sm text-gray-500 hover:bg-[#E9FAFA] hover:text-[#1B9387] cursor-pointer transition font-medium\"\n                      >\n                        -- Clear Selection --",[13612,13728],"</li>\n                      {payees\n                        .filter((p) =>\n                          p.name.toLowerCase().includes(payeeSearchQuery.toLowerCase())\n                        )\n                        .map((p) => (",[13755,14059],"<li\n                            key={p.id}\n                            onClick={() => {\n                              setPayeeId(p.id)\n                              setIsPayeeDropdownOpen(false)\n                              setPayeeSearchQuery('')\n                            }}\n                            className=\"p-3 text-sm text-gray-800 font-bold hover:bg-[#E9FAFA] hover:text-[#1B9387] cursor-pointer transition border-t border-gray-50 flex justify-between items-center\"",[14084,14134],"  >\n                            <span>{p.name}</span>",[14135,14189],"                          </li>",[14190,14238],"                        ))}",[14239,14285],"                    </ul>",[14286,14329],[14330,14365],[14366,14401],[14402,14403],[14418,14476],"<div className=\"flex flex-col justify-end\">",[14493,14676],"<div\n                  className={`p-2.5 rounded-md border text-center relative ${payeeId && payableBalance > 0 ? 'bg-orange-50 border-orange-200' : 'bg-[#FBF8F8] border-[#B0DCDA]'}`}",[14693,14820],">\n                  <p className=\"text-[10px] text-gray-500 uppercase tracking-wider font-extrabold mb-0.5\">\n                    Unpaid Balance\n                  </p>",[14821,14822],[14841,14995],"<p\n                    className={`text-xl font-black font-mono ${!payeeId ? 'text-gray-300' : payableBalance > 0 ? 'text-orange-500' : 'text-gray-400'}`}",[15014,15085],">\n                    {payeeId ? formatCurrency(payableBalance) : '—'}",[15086,15127],"                  </p>",[15128,15129],[15130,15202],"                  {payeeId && payableBalance > 0 && (",[15223,15467],"<button\n                      type=\"button\"\n                      onClick={() => setAmountToPay(payableBalance)}\n                      className=\"absolute -top-3 -right-2 bg-orange-500 hover:bg-orange-600 text-white text-[9px] font-extrabold uppercase px-2 py-1 rounded shadow transition\"",[15488,15524],">\n                      Pay In Full",[15525,15575],[15576,15615],[15616,15655],[15656,15691],[15692,15723],[15724,15725],[15726,15789],"            {/* ROW 2: PAYMENT METHOD & SOURCE */}",[15790,15870],"            <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">",[15871,15905],[15906,16049],"                <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                  Date\n                </label>",[16066,16319],"<input\n                  type=\"date\"\n                  required\n                  value={date}\n                  onChange={(e) => setDate(e.target.value)}\n                  className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-2.5 text-sm text-gray-800 font-medium focus:border-[#1B9387] outline-none shadow-sm\"",[16336,16355],"/>\n              </div>",[16356,16390],[16391,16544],"                <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                  Payment Method\n                </label>",[16561,16839],"<select\n                  required\n                  value={paymentMethod}\n                  onChange={(e) => setPaymentMethod(e.target.value as any)}\n                  className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-2.5 text-sm text-gray-800 font-bold focus:border-[#1B9387] outline-none shadow-sm cursor-pointer\"",{"messageId":"71332","fix":"71904","desc":"71334"},{"messageId":"71335","fix":"71905","desc":"71337"},[16856,16962],">\n                  <option value=\"\" disabled className=\"text-gray-400 font-normal\">\n                    -- Select --",[16981,17036],"</option>\n                  <option value=\"check\">Check</option>",[17037,17121],"                  <option value=\"transfer\">Bank Transfer</option>",[17122,17193],"                  <option value=\"cash\">Cash</option>",[17194,17236],[17237,17272],[17273,17307],[17308,17457],"                <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                  {refLabel}",[17474,17523],"</label>\n                <div className=\"flex shadow-sm\">",[17542,17742],"<span\n                    className={`bg-[#FBF8F8] border border-[#B0DCDA] border-r-0 rounded-l-md px-3 py-2.5 text-sm font-extrabold select-none ${paymentMethod ? 'text-gray-500' : 'text-gray-300'}`}",[17761,17819],">\n                    {paymentMethod ? refPrefix : '---'}",[17838,17864],"</span>\n                  <input",[17885,18218],"type=\"text\"\n                    required\n                    disabled={!paymentMethod}\n                    value={refSequence}\n                    onChange={(e) => setRefSequence(e.target.value)}\n                    className=\"w-full bg-white border border-[#B0DCDA] rounded-r-md p-2.5 text-sm font-mono font-bold text-[#1B9387] focus:border-[#1B9387] outline-none disabled:bg-gray-50 disabled:text-gray-400\"",[18237,18258],[18259,18294],[18295,18329],[18330,18484],"                <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                  Source of Funds\n                </label>",[18485,18772],"                <select\n                  required\n                  value={sourceAccount}\n                  onChange={(e) => setSourceAccount(e.target.value)}\n                  className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-2.5 text-sm text-gray-800 font-bold focus:border-[#1B9387] outline-none shadow-sm cursor-pointer\"",[18789,18909],">\n                  {cashAccounts.map((acc) => (\n                    <option key={acc.code} value={acc.code}>\n                      {acc.code} - {acc.name}",[18910,18952],"                    </option>",[18971,19022],"))}\n                </select>\n              </div>",[19035,19076],"</div>\n\n            {/* ROW 3: ATC & REMARKS */}",[19077,19157],"            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">",[19158,19192],[19193,19346],"                <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                  ATC (Tax Code)\n                </label>",[19363,19678],"<select\n                  value={selectedATC.code}\n                  onChange={(e) =>\n                    setSelectedATC(\n                      ATC_CODES.find((atc) => atc.code === e.target.value) || ATC_CODES[3]\n                    )\n                  }\n                  className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-2.5 text-sm text-gray-800 font-bold focus:border-[#1B9387] outline-none shadow-sm cursor-pointer\"",[19695,19849],">\n                  {ATC_CODES.map((atc) => (\n                    <option key={atc.code} value={atc.code}>\n                      {atc.code} - {atc.rate}% ({atc.desc.split('-')[0].trim()})",[19850,19892],[19911,19963],[19978,20110],"<div>\n                <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                  Remarks\n                </label>",[20127,20426],"<input\n                  type=\"text\"\n                  value={remarks}\n                  onChange={(e) => setRemarks(e.target.value)}\n                  placeholder=\"e.g., PF Settlement for Aug Week 1\"\n                  className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-2.5 text-sm text-gray-800 font-medium focus:border-[#1B9387] outline-none shadow-sm\"",[20442,20462],[20463,20494],[20495,20496],[20497,20562],"            {/* ROW 4: INTEGRATED PAYOUT SUMMARY */}",[20563,20692],"            <div className=\"bg-[#FBF8F8] border border-[#B0DCDA] rounded-xl p-6 shadow-inner max-w-xl mx-auto mt-4\">",[20693,20789],"              <div className=\"flex justify-between items-center mb-3 relative\">",[20790,20931],"                <label className=\"text-xs font-extrabold text-gray-700 uppercase tracking-widest\">\n                  Gross Payout (A/P)",[20948,21006],"</label>\n                <div className=\"relative w-48 shadow-sm\">",[21007,21128],"                  <span className=\"absolute left-3 top-2.5 text-gray-400 font-mono font-bold\">",[21149,21172],"₱\n                  </span>",[21191,21227],"<input\n                    type=\"number\"",[21228,21277],"                    required",[21278,21329],"                    min=\"0.01\"",[21330,21382],"                    step=\"0.01\"",[21383,21443],"                    value={amountToPay}",[21444,21501],"                    onChange={(e) => {",[21502,21586],"                      const val = parseFloat(e.target.value)",[21587,21680],"                      setAmountToPay(isNaN(val) ? '' : Math.abs(val))",[21681,21724],"                    }}",[21725,21937],"                    cla