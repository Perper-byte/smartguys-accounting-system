case tracking-wider border-r border-[#B0DCDA]\"\n                      >\n                        Total",[14226,14380],"</td>\n                      <td className=\"p-4 text-right font-mono font-bold text-[#1B9387] border-r border-[#B0DCDA]\">\n                        {formatCurrency(data.totalDebits)}",[14403,14537],"</td>\n                      <td className=\"p-4 pr-5 text-right font-mono font-bold text-[#1B9387]\">\n                        {formatCurrency(data.totalCredits)}",[14560,14584],"</td>\n                    </tr>",[14585,14630],[14647,14672],"</table>",[14673,14708],[14709,14740],[14741,14764],[14765,14766],[14767,14833],"          {/* =========================================",[14877,14878],[14944,14945],[14946,14999],"          {statementType === 'income' && (",[15000,15079],"            <div className=\"space-y-8 bg-white max-w-3xl mx-auto\">",[15080,15170],[15171,15298],[15315,15406],"</h2>\n                <h3 className=\"text-lg font-bold text-gray-600 mt-1\">Income Statement</h3>",[15407,15557],"                <p className=\"text-sm text-gray-500 mt-1 italic\">\n                  For the month ended {getMonthName(selectedMonth)} {selectedYear}",[15574,15593],[15594,15595],[15596,15630],[15631,15792],"                <h3 className=\"text-sm font-extrabold uppercase tracking-wider text-[#1B9387] border-b border-[#B0DCDA] pb-2 mb-3\">\n                  Revenues",[15809,15947],"</h3>\n                {data.revenue?.length === 0 && (\n                  <p className=\"text-sm text-gray-400 px-4 pl-8 italic\">\n                    No revenue recorded this month.\n                  </p>",[15964,16028],")}\n                {data.revenue?.map((rev: any, idx: number) => (",{"messageId":"71332","fix":"71926","desc":"71334"},{"messageId":"71335","fix":"71927","desc":"71337"},[16047,16154],"<div\n                    key={idx}\n                    className=\"flex justify-between text-sm py-2 px-4 pl-8 hover:bg-gray-50\"",[16173,16257],">\n                  