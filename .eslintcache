64588","64589"],{"range":"64590","text":"45467"},{"range":"64591","text":"45467"},{"range":"64592","text":"45467"},{"range":"64593","text":"45467"},"Replace `·revAccounts.find((a:·any)·=>·a.code·===·'4010')?.code·||·revAccounts[0].code␍` with `⏎············revAccounts.find((a:·any)·=>·a.code·===·'4010')?.code·||·revAccounts[0].code`",{"range":"64594","text":"64595"},["64596","64597"],"Replace `{·id:·1,·accountCode:·defaultAccount,·description:·'',·quantity:·1,·price:·500,·isVatable:·false,·isHmoCovered:·false,·hmoCoverage:·''·}])␍` with `⏎············{⏎··············id:·1,⏎··············accountCode:·defaultAccount,⏎··············description:·'',⏎··············quantity:·1,⏎··············price:·500,⏎··············isVatable:·false,⏎··············isHmoCovered:·false,⏎··············hmoCoverage:·''⏎············}⏎··········])`",{"range":"64598","text":"64599"},{"range":"64600","text":"45467"},{"range":"64601","text":"45467"},"Replace `·console.error(error)·}␍` with `⏎······console.error(error)⏎····}`",{"range":"64602","text":"64603"},{"range":"64604","text":"45467"},{"range":"64605","text":"45467"},"Replace `·loadInitialData()·},·[])␍` with `⏎····loadInitialData()⏎··},·[])`",{"range":"64606","text":"64607"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\MY PC\\Desktop\\lol\\smartguys-accounting-system\\src\\renderer\\src\\components\\POSBillingView.tsx:83:21\n  81 |   }\n  82 |\n> 83 |   useEffect(() => { loadInitialData() }, [])\n     |                     ^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  84 |\n  85 |   // Automatically fetch the next sequence number (e.g. 001) for the POS\n  86 |   useEffect(() => {","React Hook useEffect has a missing dependency: 'loadInitialData'. Either include it or remove the dependency array.",["64608"],{"range":"64609","text":"45467"},{"range":"64610","text":"45467"},{"range":"64611","text":"45467"},{"range":"64612","text":"45467"},{"range":"64613","text":"45467"},["64614","64615"],["64616","64617"],{"range":"64618","text":"45467"},{"range":"64619","text":"45467"},{"range":"64620","text":"45467"},"Replace `·console.error(error)·}␍` with `⏎········console.error(error)⏎······}`",{"range":"64621","text":"64622"},{"range":"64623","text":"45467"},{"range":"64624","text":"45467"},{"range":"64625","text":"45467"},{"range":"64626","text":"45467"},{"range":"64627","text":"45467"},{"range":"64628","text":"45467"},{"range":"64629","text":"45467"},{"range":"64630","text":"45467"},{"range":"64631","text":"45467"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\MY PC\\Desktop\\lol\\smartguys-accounting-system\\src\\renderer\\src\\components\\POSBillingView.tsx:102:7\n  100 |   useEffect(() => {\n  101 |     if (!patientId) {\n> 102 |       setPayeeId('')\n      |       ^^^^^^^^^^ Avoid calling setState() directly within an effect\n  103 |       return\n  104 |     }\n  105 |",{"range":"64632","text":"45467"},{"range":"64633","text":"45467"},{"range":"64634","text":"45467"},{"range":"64635","text":"45467"},{"range":"64636","text":"45467"},{"range":"64637","text":"45467"},{"range":"64638","text":"45467"},{"range":"64639","text":"45467"},"Replace `␍⏎········selectedPatient.hmo_name·||·␍⏎········selectedPatient.hmoName;␍` with `selectedPatient.hmo_name·||·selectedPatient.hmoName`",{"range":"64640","text":"64641"},{"range":"64642","text":"45467"},{"range":"64643","text":"45467"},{"range":"64644","text":"45467"},"Replace `␍` with `(p)·=>`",{"range":"64645","text":"64646"},"Replace `·(p)·=>·p.name·?·String(p.name).toLowerCase().trim()·===·hmoSearchStr·:·false␍` with `·p.name·?·String(p.name).toLowerCase().trim()·===·hmoSearchStr·:·false`",{"range":"64647","text":"64648"},{"range":"64649","text":"45467"},{"range":"64650","text":"45467"},{"range":"64651","text":"45467"},{"range":"64652","text":"45467"},{"range":"64653","text":"45467"},{"range":"64654","text":"45467"},{"range":"64655","text":"45467"},{"range":"64656","text":"45467"},{"range":"64657","text":"45467"},{"range":"64658","text":"45467"},{"range":"64659","text":"45467"},{"range":"64660","text":"45467"},{"range":"64661","text":"45467"},"'newName' is defined but never used.",{"range":"64662","text":"45467"},{"range":"64663","text":"45467"},{"range":"64664","text":"45467"},{"range":"64665","text":"45467"},{"range":"64666","text":"45467"},{"range":"64667","text":"45467"},{"range":"64668","text":"45467"},{"range":"64669","text":"45467"},{"range":"64670","text":"45467"},{"range":"64671","text":"45467"},"Replace `·revenueAccounts.find((a)·=>·a.code·===·'4010')?.code·||·(revenueAccounts.length·>·0·?·revenueAccounts[0].code·:·'')␍` with `⏎······revenueAccounts.find((a)·=>·a.code·===·'4010')?.code·||⏎····