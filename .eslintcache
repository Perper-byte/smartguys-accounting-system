ource",[32420,32504],"</h1>\n                <p className=\"font-bold text-sm\">(BIR Form No. 2307 Equivalent)</p>",[32505,32540],[32541,32652],"              <div className=\"grid grid-cols-2 gap-4 border-b-2 border-black pb-4 mb-4 text-sm\">",[32653,32894],"                <div>\n                  <p className=\"font-bold text-xs uppercase text-gray-600\">\n                    Payee (Doctor/Supplier):\n                  </p>\n                  <p className=\"font-bold\">{generated2307.payee?.name}</p>\n                  <p>TIN: {generated2307.payee?.tin || 'Not Provided'}</p>\n                </div>",[32911,33119],"<div>\n                  <p className=\"font-bold text-xs uppercase text-gray-600\">Payor (Clinic):</p>\n                  <p className=\"font-bold\">SMARTGUYS CLINIC INC.</p>\n                  <p>Date: {generated2307.date.toLocaleDateString()}</p>",[33120,33155],[33170,33271],"</div>\n              <table className=\"w-full text-sm text-left border-collapse border border-black mb-12\">",[33272,33608],"                <thead className=\"bg-gray-100\">\n                  <tr>\n                    <th className=\"border border-black p-2\">Income Payment</th>\n                    <th className=\"border border-black p-2 text-center\">ATC</th>\n                    <th className=\"border border-black p-2 text-right\">Gross Amount</th>\n                    <th className=\"border border-black p-2 text-right\">Tax Withheld</th>\n                  </tr>\n                </thead>",[33625,34120],"<tbody>\n                  <tr>\n                    <td className=\"border border-black p-2\">{generated2307.atc.desc}</td>\n                    <td className=\"border border-black p-2 text-center font-bold\">\n                      {generated2307.atc.code}\n                    </td>\n                    <td className=\"border border-black p-2 text-right font-mono\">\n                      ₱ {generated2307.gross.toLocaleString('en-US', { minimumFractionDigits: 2 })}\n   