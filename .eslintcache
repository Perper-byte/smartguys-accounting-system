-50' : 'bg-emerald-50'}`}",[4865,4893],">\n            {lockDate ? (",[4894,4925],"              <>",[4926,5074],"                <div className=\"w-16 h-16 bg-red-100 text-red-500 rounded-full flex items-center justify-center mb-4 shadow-inner\">",[5075,5130],"                  <Lock size={28} />",[5131,5170],[5171,5305],"                <h3 className=\"text-red-700 font-extrabold uppercase tracking-widest text-sm mb-1\">\n                  Period Locked",[5322,5439],"</h3>\n                <p className=\"text-xs font-bold text-red-500/70\">\n                  As of {new Date(lockDate).toLocaleDateString()}",[5456,5493],"</p>\n                {hasExistingPin && (",[5494,5709],"                  <span className=\"mt-4 bg-white/50 text-red-600 border border-red-200 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest flex items-center gap-1.5 shadow-sm\">",[5710,5784],"                    <KeyRound size={12} /> PIN Active",[5785,5829],[5830,5865],[5866,5898],"              </>",[5899,5929],[5930,5961],[5962,6118],"                <div className=\"w-16 h-16 bg-emerald-100 text-emerald-500 rounded-full flex items-center justify-center mb-4 shadow-inner\">",[6119,6176],"                  <Unlock size={28} />",[6177,6216],[6217,6350],"                <h3 className=\"text-emerald-700 font-extrabold uppercase tracking-widest text-sm mb-1\">\n                  Unlocked",[6367,6455],"</h3>\n                <p className=\"text-xs font-bold text-emerald-500/70\">All dates open</p>",[6456,6488],[6489,6516],[6517,6544],[6545,6546],[6547,6586],"          {/* Input Side */}",[6587,6645],"          <div className=\"w-full md:w-2/3 p-8\">",[6646,6759],"            <h3 className=\"text-lg font-extrabold text-gray-800 mb-2\">Month-End Accounting Lock</h3>",[6760,6855],"            <p className=\"text-sm text-gray-500 font-medium mb-6 leading-relaxed\">",[6856,7072],"              Set a date below to prevent anyone from adding, editing, or voiding transactions on or\n              before that date. This ensures your reconciled data and filed taxes are never\n              accidentally modified.",[7073,7102],[7103,7104],[7105,7157],"            <div className=\"space-y-6\">",[7158,7236],"              {/* MANUAL LOCK */}",[7237,7332],"              <div className=\"bg-gray-50 border border-gray-200 p-5 rounded-xl\">",[7333,7494],"                <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-2\">\n                  Current Global Lock Date",[7511,7556],"</label>\n                <div className=\"flex gap-3\">",[7557,7601],[7602,7655],"                    type=\"date\"",[7656,7714],"                    value={lockDate}",[7715,7800],"                    onChange={(e) => setLockDate(e.target.value)}",[7801,8021],"                    className=\"w-full max-w-xs bg-white border border-gray-300 rounded-md p-3 text-sm font-bold text-gray-800 focus:border-[#1B9387] outline-none transition cursor-pointer shadow-sm\"",[8022,8061],[8062,8113],"                  {lockDate && (",[8114,8163],[8164,8241],"                      onClick={() => setLockDate('')}",[8242,8457],"                      className=\"px-4 text-xs font-bold text-red-500 hover:text-red-700 hover:bg-red-50 rounded-md uppercase tracking-wider transition cursor-pointer border border-transparent\"",[8458,8500],[8501,8557],"                      Remove Lock",[8558,8608],[8609,8648],[8649,8688],[8689,8724],[8725,8726],[8727,8778],"              {/* AUTOMATIC LOCK */}",[8779,8880],"              <div className=\"bg-[#E9FAFA]/50 border border-[#B0DCDA] p-5 rounded-xl\">",[8881,8960],"                <div className=\"flex items-center gap-2 mb-2\">",[8961,9052],"                  <CalendarClock size={16} className=\"text-[#1B9387]\" />",[9053,9221],"                  <label className=\"block text-[10px] font-extrabold text-[#1B9387] uppercase tracking-wider\">\n                    Automate Closing (Grace Period)",[9240,9261],"</label>\n                </div>",[9262,9429],"                <p className=\"text-xs text-gray-500 mb-3\">\n                  Automatically lock the previous month after this many days have passed in the new",[9430,9463],"                  month.",[9480,9538],"</p>\n\n                <div className=\"flex items-center gap-3\">",[9557,9584],"<select",[9585,9645],"                    value={autoLockDay}",[9666,9770],"onChange={(e) =>\n                      setAutoLockDay(e.target.value === '' ? '' : Number(e.target.value))",[9791,9980],"}\n                    className=\"w-full max-w-xs bg-white border border-[#B0DCDA] rounded-md p-3 text-sm font-bold text-gray-800 focus:border-[#1B9387] outline-none cursor-pointer shadow-sm\"",[9981,10019],"                  >",[10020,10114],"                    <option value=\"\">Disabled (Manual Lock Only)</option>",[10115,10211],"                    <option value={3}>Lock on the 3rd of the month</option>",[10212,10308],"                    <option value={5}>Lock on the 5th of the month</option>",[10309,10405],"                    <option value={7}>Lock on the 7th of the month</option>",[10406,10504],"                    <option value={10}>Lock on the 10th of the month</option>",[10505,10551],[10552,10591],[10592,10627],[10628,10629],[10630,10679],"              {/* OVERRIDE PIN */}",[10680,10776],"              <div className=\"bg-red-50/50 border border-red-200 p-5 rounded-xl\">",[10777,10933],"                <label className=\"block text-[10px] font-extrabold text-red-600 uppercase tracking-wider mb-2\">\n                  Manager Override PIN",[10950,11141],"</label>\n                <p className=\"text-xs text-red-500/80 mb-3 font-medium\">\n                  Required to backdate Adjusting Entries or Void transactions in a locked period.\n                  Leave blank to retain current PIN.",[11158,11182],"</p>\n                <input",[11183,11236],"                  type=\"password\"",[11237,11294],"                  value={overridePin}",[11295,11379],"                  onChange={(e) => setOverridePin(e.target.value)}",[11380,11495],"                  placeholder={hasExistingPin ? '•••• (PIN is set)' : 'Enter 4 to 6 digit PIN'}",[11496,11693],"                  className=\"w-full max-w-xs bg-white border border-red-200 rounded-md p-3 text-sm font-mono font-bold text-gray-800 focus:border-red-500 outline-none shadow-sm\"",[11694,11729],[11730,11765],[11766,11767],[11768,11816],"              {/* SAVE BUTTON */}",[11817,11917],"              <div className=\"flex items-center gap-4 pt-4 border-t border-gray-100\">",[11918,11959],[11960,12027],"                  disabled={!isDirty || loading}",[12028,12086],"                  onClick={handleSave}",[12087,12322],"                  className=\"px-8 py-3 bg-[#1B9387] hover:bg-[#28958B] text-white rounded-md text-sm font-bold uppercase tracking-wider shadow-sm transition disabled:opacity-50 flex items-center gap-2 cursor-pointer\"",[12323,12357],[12358,12436],"                  <Save size={16} /> Save Security Settings",[12437,12479],[12480,12515],[12516,12547],[12548,12575],[12576,12599],[12600,12621],[12626,12637],[12640,12645],[12647,12647],[30,32],[76,78],[79,80],[98,99],[102,155],"{ id: 'billing', label: 'Patient Billing (POS)' },",[158,210],"{ id: 'collections', label: 'Receive Payments' },",[213,264],"{ id: 'directory', label: 'Contact Directory' },",[267,322],"{ id: 'disbursement', label: 'Cash Disbursements' },",[325,371],"{ id: 'payouts', label: 'Doctor Payouts' },",[372,426],"  { id: 'aging', label: 'Aged Receivables (HMO)' },",[427,476],"  { id: 'tracker', label: 'Invoice Tracker' },",[477,527],"  { id: 'history', label: 'My Sales History' },",[528,574],"  { id: 'payroll', label: 'HR & Payroll' },",[575,622],"  { id: 'journal', label: 'Journal Entry' },",[623,676],"  { id: 'adjusting', label: 'Adjusting Entries' },",[677,724],"  { id: 'ledger', label: 'General Ledger' },",[725,785],"  { id: 'reconciliation', label: 'Bank Reconciliation' }