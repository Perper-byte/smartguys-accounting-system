 some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\MY PC\\Desktop\\lol\\smartguys-accounting-system\\src\\renderer\\src\\components\\BIRReportsView.tsx:70:9\n  68 |     // Refetch data when year, quarter, month, or view changes\n  69 |     useEffect(() => {\n> 70 |         fetchTaxData();\n     |         ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  71 |     }, [year, quarter, month, view]);\n  72 |\n  73 |     const formatCurrency = (val: number | null | undefined) => {","Replace `····},·[year,·quarter,·month,·view]);␍` with `··},·[year,·quarter,·month,·view])`",{"range":"53030","text":"53031"},"React Hook useEffect has a missing dependency: 'fetchTaxData'. Either include it or remove the dependency array.",["53032"],{"range":"53033","text":"45467"},"Replace `····const·formatCurrency·=·(val:·number·|·null·|·undefined)·=>·{␍` with `··const·formatCurrency·=·(val:·number·|·null·|·undefined)·=>·{`",{"range":"53034","text":"53035"},"Replace `········if·(!val·||·val·===·0)·return·null;␍` with `····if·(!val·||·val·===·0)·return·null`",{"range":"53036","text":"53037"},"Replace `········return·`₱·${val.toLocaleString(undefined,·{·minimumFractionDigits:·2,·maximumFractionDigits:·2·})}`;␍` with `····return·`₱·${val.toLocaleString(undefined,·{·minimumFractionDigits:·2,·maximumFractionDigits:·2·})}``",{"range":"53038","text":"53039"},{"range":"53040","text":"45556"},{"range":"53041","text":"45467"},"Replace `····const·handleExportPDF·=·()·=>·{␍` with `··const·handleExportPDF·=·()·=>·{`",{"range":"53042","text":"53043"},"Replace `········window.print();␍` with `····window.print()`",{"range":"53044","text":"53045"},{"range":"53046","text":"45556"},{"range":"53047","text":"45467"},"Replace `····const·handleDownloadSLSP·=·