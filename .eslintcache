87]·bg-white·border-[#B0DCDA]·rounded·cursor-pointer·focus:ring-[#1B9387]\"`",{"range":"69764","text":"69765"},"Replace `··············<label·htmlFor=\"isActive\"·className=\"ml-3·text-sm·font-bold·text-gray-700·cursor-pointer\">Account·is·Active</label>␍` with `/>⏎··············<label⏎················htmlFor=\"isActive\"⏎················className=\"ml-3·text-sm·font-bold·text-gray-700·cursor-pointer\"⏎··············>⏎················Account·is·Active`",{"range":"69766","text":"69767"},"Replace `··········</div>␍` with `</label>⏎············</div>`",{"range":"69768","text":"69769"},{"range":"69770","text":"45467"},"Replace `············<button·type=\"submit\"·disabled={loading·||·!newUser.username·||·!newUser.password}·className=\"w-full·bg-[#1B9387]·hover:bg-[#28958B]·text-white·font-bold·py-3·rounded-md·transition·mt-6·cursor-pointer·shadow-sm·uppercase·tracking-wider·text-sm·disabled:opacity-50·disabled:cursor-not-allowed\">␍` with `<button⏎··············type=\"submit\"⏎··············disabled={loading·||·!newUser.username·||·!newUser.password}⏎··············className=\"w-full·bg-[#1B9387]·hover:bg-[#28958B]·text-white·font-bold·py-3·rounded-md·transition·mt-6·cursor-pointer·shadow-sm·uppercase·tracking-wider·text-sm·disabled:opacity-50·disabled:cursor-not-allowed\"`",{"range":"69771","text":"69772"},"Replace `················{loading·?·'Processing...'·:·'Create·Account'}␍` with `>⏎··············{loading·?·'Processing...'·:·'Create·Account'}`",{"range":"69773","text":"69774"},{"range":"69775","text":"53173"},{"range":"69776","text":"54622"},{"range":"69777","text":"51431"},{"range":"69778","text":"45467"},{"range":"69779","text":"68562"},"Replace `····················<div·className=\"p-4·border-b·border-[#B0DCDA]·bg-[#FBF8F8]·flex·justify-between·items-center\">␍` with `··········<div·className=\"p-4·border-b·border-[#B0DCDA]·bg-[#FBF8F8]·flex·justify-between·items-center\">`",{"range":"69780","text":"69781"},"Replace `························<h3·className=\"text-