,{"range":"55353","text":"55354"},"Replace `··const·[highlightCode,·setHighlightCode]·=·useState<string·|·null>(null);␍` with `const·[highlightCode,·setHighlightCode]·=·useState<string·|·null>(null)`",{"range":"55355","text":"55356"},{"range":"55357","text":"45467"},"Replace `····//·New·Account·Form·State␍` with `··//·New·Account·Form·State`",{"range":"55358","text":"55359"},"Replace `····const·[newAccount,·setNewAccount]·=·useState({·code:·'',·name:·'',·type_id:·''·});␍` with `··const·[newAccount,·setNewAccount]·=·useState({·code:·'',·name:·'',·type_id:·''·})`",{"range":"55360","text":"55361"},"Replace `····const·[touched,·setTouched]·=·useState<{·code:·boolean;·name:·boolean;·type_id:·boolean·}>({·code:·false,·name:·false,·type_id:·false·});␍` with `··const·[touched,·setTouched]·=·useState<{·code:·boolean;·name:·boolean;·type_id:·boolean·}>({⏎····code:·false,⏎····name:·false,⏎····type_id:·false⏎··})`",{"range":"55362","text":"55363"},{"range":"55364","text":"45467"},"Replace `····//·Edit·Modal·State␍` with `··//·Edit·Modal·State`",{"range":"55365","text":"55366"},"Replace `····const·[editingAccount,·setEditingAccount]·=·useState<any·|·null>(null);␍` with `··const·[editingAccount,·setEditingAccount]·=·useState<any·|·null>(null)`",{"range":"55367","text":"55368"},["55369","55370"],"Replace `····const·[editForm,·setEditForm]·=·useState({·code:·'',·name:·'',·type_id:·''·});␍` with `··const·[editForm,·setEditForm]·=·useState({·code:·'',·name:·'',·type_id:·''·})`",{"range":"55371","text":"55372"},"Replace `····const·[editLoading,·setEditLoading]·=·useState(false);␍` with `··const·[editLoading,·setEditLoading]·=·useState(false)`",{"range":"55373","text":"55374"},{"range":"55375","text":"45467"},"Replace `····const·codeInputRef·=·useRef<HTMLInputElement>(null);␍` with `··const·codeInputRef·=·useRef<HTMLInputElement>(null)`",{"range":"55376","text":"55377"},{"range":"55378","text":"45467"},"Replace `····const·fetchData·=·async·()·=>·{␍` with `··const·fetchData·=·async·()·=>·{`",{"range":"55379","text":"55380"},{"range":"55381","text":"51360"},{"range":"55382","text":"48982"},"Replace `······const·api·=·(window·as·any).api·||·(window·as·any).electronAPI;␍` with `const·api·=·(window·as·any).api·||·(window·as·any).electronAPI`",{"range":"55383","text":"55384"},["55385","55386"],["55387","55388"],"Replace `············const·[accs,·types]·=·await·Promise.all([␍⏎················api.getAccounts(),␍⏎················api.getAccountTypes()␍⏎············]);␍` with `······const·[accs,·types]·=·await·Promise.all([api.getAccounts(),·api.getAccountTypes()])`",{"range":"55389","text":"55390"},"Replace `······setAccounts(accs·||·[]);␍` with `setAccounts(accs·||·[])`",{"range":"55391","text":"55392"},"Replace `············setAccountTypes(types·||·[]);␍` with `······setAccountTypes(types·||·[])`",{"range":"55393","text":"55394"},{"range":"55395","text":"47900"},"Replace `············console.error(\"Failed·to·fetch·COA·data\",·error);␍` with `······console.error('Failed·to·fetch·COA·data',·error)`",{"range":"55396","text":"55397"},{"range":"55398","text":"51857"},{"range":"55399","text":"51410"},{"range":"55400","text":"47904"},{"range":"55401","text":"45556"},{"range":"55402","text":"45467"},"Replace `····useEffect(()·=>·{·fetchData();·},·[]);␍` with `··useEffect(()·=>·{⏎····fetchData()⏎··},·[])`",{"range":"55403","text":"55404"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\MY PC\\Desktop\\lol\\smartguys-accounting-system\\src\\renderer\\src\\components\\ChartOfAccountsView.tsx:43:23\n  41 |     };\n  42 |\n> 43 |     useEffect(() => { fetchData(); }, []);\n     |                       ^^^^^^^^^ Avoid calling setState() directly within an effect\n  44 |\n  45 |     // Close the edit modal on Escape\n  46 |     useEffect(() => {",{"range":"55405","text":"45467"},"Replace `····//·Close·the·edit·modal·on·Escape␍` with `··//·Close·the·edit·modal·on·Escape`",{"range":"55406","text":"55407"},{"range":"55408","text":"51552"},"Replace `········if·(!editingAccount)·return;␍` with `····if·(!editingAccount)·return`",{"range":"55409","text":"55410"},"Replace `········const·onKeyDown·=·(e:·KeyboardEvent)·=>·{␍` with `····const·onKeyDown·=·(e:·KeyboardEvent)·=>·{`",{"range":"55411","text":"55412"},"Replace `············if·(e.key·===·'Escape')·closeEditModal();␍` with `······if·(e.key·===·'Escape')·closeEditModal()`",{"range":"55413","text":"55414"},"react-hooks/immutability","Error: Cannot access variable before it is declared\n\n`closeEditModal` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Users\\MY PC\\Desktop\\lol\\smartguys-accounting-system\\src\\renderer\\src\\components\\ChartOfAccountsView.tsx:49:37\n  47 |         if (!editingAccount) return;\n  48 |         const onKeyDown = (e: KeyboardEvent) => {\n> 49 |             if (e.key === 'Escape') closeEditModal();\n     |                                     ^^^^^^^^^^^^^^ `closeEditModal` accessed before it is declared\n  50 |         };\n  51 |         window.addEventListener('keydown', onKeyDown);\n  52 |         return () => window.removeEventListener('keydown', onKeyDown);\n\nC:\\Users\\MY PC\\Desktop\\lol\\smartguys-accounting-system\\src\\renderer\\src\\components\\ChartOfAccountsView.tsx:114:5\n  112 |     };\n  113 |\n> 114 |     const closeEditModal = () => {\n      |     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 115 |         setEditingAccount(null);\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 116 |         setEditForm({ code: '', name: '', type_id: '' });\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 117 |     };\n      | ^^^^^^^ `closeEditModal` is declared here\n  118 |\n  119 |     const handleUpdateAccount = async (e: React.FormEvent) => {\n  120 |         e.preventDefault();",{"range":"55415","text":"47904"},"Replace `····window.addEventListener('keydown',·onKeyDown);␍` with `window.addEventListener('keydown',·onKeyDown)`",{"range":"55416","text":"55417"},"Replace `········return·()·=>·window.removeEventListener('keydown',·onKeyDown);␍` with `····return·()·=>·window.removeEventListener('keydown',·onKeyDown)`",{"range":"55418","text":"55419"},"Replace `····},·[editingAccount]);␍` with `··},·[editingAccount])`",{"range":"55420","text":"55421"},{"range":"55422","text":"45467"},"Replace `··//·----·Validation·helpers·----␍` with `//·----·Validation·helpers·----`",{"range":"55423","text":"55424"},"Replace `····const·existingCodes·=·useMemo(␍` with `··const·existingCodes·=·useMemo(`",{"range":"55425","text":"55426"},"Replace `········()·=>·new·Set(accounts.map(a·=>·String(a.code).toLowerCase())),␍` with `····()·=>·new·Set(accounts.map((a)·=>·String(a.code).toLowerCase())),`",{"range":"55427","text":"55428"},"Replace `········[accounts]␍` with `····[accounts]`",{"range":"55429","text":"55430"},{"range":"55431","text":"51476"},{"range":"55432","text":"45467"},"Replace `····const·isValidCodeFormat·=·(code:·string)·=>·/^[0-9]{3,6}$/.test(code);␍` with `··const·isValidCodeFormat·=·(code:·string)·=>·/^[0-9]{3,6}$/.test(code)`",{"range":"55433","text":"55434"},{"range":"55435","text":"45467"},"Replace `····const·codeError·=·(()·=>·{␍` with `··const·codeError·=·(()·=>·{`",{"range":"55436","text":"55437"},"Replace `········if·(!newAccount.code)·return·touched.code·?·'Account·code·is·required.'·:·null;␍` with `