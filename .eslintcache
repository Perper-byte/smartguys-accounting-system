c":"71337"},{"messageId":"71332","fix":"72352","desc":"71334"},{"messageId":"71335","fix":"72353","desc":"71337"},[5990,6043],"      // 🔥 Passed adminUser for the audit log",[6044,6158],"      const result = await api.updateUserPermissions(\n        userToEditPerms.id,\n        userToEditPerms.perms,\n        adminUser",[6159,6172],[6173,6207],"\n      if (result.success) {",[6208,6329],"        setStatusMessage({\n          type: 'success',\n          msg: `Custom permissions saved for ${userToEditPerms.username}!`",[6338,6360],[6361,6382],[6383,6472],"        setStatusMessage({ type: 'error', msg: 'Failed to save permissions.' })",[6473,6487],[6488,6514],[6515,6586],[6587,6607],[6608,6639],[6640,6678],"      setUserToEditPerms(null)",[6679,6689],[6690,6697],[6698,6699],[6700,6753],"  const togglePermission = (moduleId: string) => {",[6754,6792],[6793,6840],"    const current = userToEditPerms.perms",[6841,6883],"    if (current.includes(moduleId)) {",[6884,6986],"      setUserToEditPerms({ ...userToEditPerms, perms: current.filter((id) => id !== moduleId) })",[6987,7004],[7005,7092],"      setUserToEditPerms({ ...userToEditPerms, perms: [...current, moduleId] })",[7093,7103],[7106,7111],[7112,7113],[7114,7221],"  const filteredUsers = users.filter((u) =>\n    u.username.toLowerCase().includes(searchQuery.toLowerCase())\n  )",[7222,7223],[7224,7269],"  const getRoleBadge = (role: string) => {",[7270,7293],"    switch (role) {",[7294,7376],"      case 'MANAGER':\n        return 'bg-amber-50 text-amber-600 border-amber-200'",[7377,7465],"      case 'ACCOUNTANT':\n        return 'bg-purple-50 text-purple-600 border-purple-200'",[7466,7545],"      case 'CASHIER':\n        return 'bg-blue-50 text-blue-600 border-blue-200'",[7546,7630],"      case 'IT_PERSONNEL':\n        return 'bg-rose-50 text-rose-600 border-rose-200'",[7631,7703],"      default:\n        return 'bg-gray-50 text-gray-600 border-gray-200'",[7704,7714],[7715,7722],[7723,7724],[7725,7738],[7739,7828],[7829,7926],[7927,7949],[7950,8077],"          <h2 className=\"text-2xl font-extrabold text-gray-800 tracking-wide\">\n            System Settings / User Management",[8088,8223],"</h2>\n          <p className=\"text-sm text-gray-500 mt-1 font-medium\">\n            Create and manage access credentials and fine-grained permissions.",[8233,8247],[8248,8267],[8268,8269],[8270,8302],[8311,8521],[8530,8611],[8612,8635],[8636,8651],[8652,8653],[8654,8737],[8738,8847],[8848,8980],"          <h3 className=\"text-lg font-extrabold text-gray-800 mb-5 border-b border-gray-100 pb-3\">\n            Create New Account",[8991,9002],"</h3>",[9003,9080],"\n          <form onSubmit={handleCreateUser} className=\"space-y-4\">",[9081,9111],[9112,9255],"              <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                Username\n              </label>",[9270,9626],"<input\n                type=\"text\"\n                required\n                placeholder=\"e.g. juan_cashier\"\n                value={newUser.username}\n                onChange={(e) =>\n                  setNewUser({\n                    ...newUser,\n                    username: e.target.value.toLowerCase().replace(/\\s/g, '')\n                  })\n                }\n                className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-2.5 text-sm text-gray-800 font-medium focus:border-[#1B9387] outline-none transition\"",[9639,9658],"  />\n            </div>",[9659,9689],[9690,9843],"              <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                Temporary Password\n              </label>",[9858,10184],"<input\n                type=\"text\"\n                required\n                placeholder=\"Set initial password\"\n                value={newUser.password}\n                onChange={(e) => setNewUser({ ...newUser, password: e.target.value })}\n                className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-2.5 text-sm text-gray-800 font-medium focus:border-[#1B9387] outline-none transition\"",[10197,10216],[10217,10247],[10248,10402],"              <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                Default System Role\n              </label>",[10417,10693],"<select\n                value={newUser.role}\n                onChange={(e) => setNewUser({ ...newUser, role: e.target.value })}\n                className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-2.5 text-sm text-gray-800 font-medium focus:border-[#1B9387] outline-none transition cursor-pointer\"",[10694,10783],"              >\n                <option value=\"CASHIER\">Cashier (Billing & POS)</option>",[10784,10882],"                <option value=\"ACCOUNTANT\">Accountant (Ledger & Reports)</option>",[10883,10980],"                <option value=\"MANAGER\">Manager (Analytics & Approvals)</option>",[10981,11082],"                <option value=\"IT_PERSONNEL\">IT / Admin (Settings & Backup)</option>",[11083,11121],[11134,11153],[11154,11179],[11180,11250],"            <div className=\"flex items-center mt-2 pt-2\">",[11265,11520],"<input\n                type=\"checkbox\"\n                id=\"isActive\"\n                checked={newUser.isActive}\n                onChange={(e) => setNewUser({ ...newUser, isActive: e.target.checked })}\n                className=\"w-4 h-4 text-[#1B9387] bg-white border-[#B0DCDA] rounded cursor-pointer focus:ring-[#1B9387]\"",[11535,11665],"/>\n              <label\n                htmlFor=\"isActive\"\n                className=\"ml-3 text-sm font-bold text-gray-700 cursor-pointer\"\n              >\n                Account is Active",[11680,11697],"</label>\n            </div>",[11698,11699],[11712,12018],"<button\n              type=\"submit\"\n              disabled={loading || !newUser.username || !newUser.password}\n              className=\"w-full bg-[#1B9387] hover:bg-[#28958B] text-white font-bold py-3 rounded-md transition mt-6 cursor-pointer shadow-sm uppercase tracking-wider text-sm disabled:opacity-50 disabled:cursor-not-allowed\"",[12031,12094],">\n              {loading ? 'Processing...' : 'Create Account'}",[12095,12129],[12130,12158],[12159,12182],[12183,12184],[12185,12314],[12315,12430],"          <div className=\"p-4 border-b border-[#B0DCDA] bg-[#FBF8F8] flex justify-between items-center\">",[12431,12540],"            <h3 className=\"text-lg font-extrabold text-gray-800 tracking-wide\">System Users</h3>",[12553,12857],"<input\n              type=\"text\"\n              placeholder=\"🔍 Search username...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-64 bg-white border border-[#B0DCDA] rounded-md px-3 py-1.5 text-sm focus:outline-none focus:border-[#1B9387] text-gray-800 transition-colors shadow-sm\"",[12870,12885],[12886,12887],[12888,12947],[12960,13017],"<table className=\"w-full text-left text-sm\">",[13018,13123],[13124,13239],[13240,13335],"                  <th className=\"p-4 border-r border-gray-100\">Username</th>",[13336,13427],"                  <th className=\"p-4 border-r border-gray-100\">Role</th>",[13428,13533],"                  <th className=\"p-4 text-center border-r border-gray-100\">Status</th>",[13534,13614],"                  <th className=\"p-4 text-right\">Actions</th>",[13615,13653],[13654,13691],[13692,13765],[13766,13830],"                {filteredUsers.length === 0 ? (",[13849,13975],"<tr>\n                    <td colSpan={4} className=\"p-12 text-center text-gray-500 italic font-medium\">\n                      No users found.",[13996,14014],[14031,14078],") : (\n                  filteredUsers.map((u) => {",[14079,14158],"                    // 🔥 FIXED BULLETPROOF BOOLEAN LOGIC:",[14179,14298],"// Some databases return 1/0, strings '1'/'0', or true/false. This handles all of them accurately.",[14299,14409],"                    const dbValue = u.is_active !== undefined ? u.is_active : u.isActive",[14430,14545],"const isActive =\n                      dbValue === 1 || dbValue === '1' || dbValue === true || dbValue === 'true'",[14546,14587],[14588,14694],"                    const hasCustomPerms = u.permissions && u.permissions.length > 0",[14695,14696],[14697,14746],[14747,14854],"                      <tr key={u.id} className=\"hover:bg-gray-50 transition-colors\">",[14855,14949],"                        <td className=\"p-4 border-r border-gray-100\">",[14950,15079],"                          <span className=\"font-extrabold text-gray-800 text-base\">\n                            {u.username}",[15106,15299],"</span>\n                          {hasCustomPerms && (\n                            <span className=\"ml-2 bg-indigo-50 border border-indigo-200 text-indigo-600 text-[9px] px-2 py-0.5 rounded-full font-bold uppercase\">\n                              Custom",[15328,15354],"</span>\n                          )}",[15379,15449],"</td>\n                        <td className=\"p-4 border-r border-gray-100\">",[15450,15639],"                          <span\n                            className={`px-2.5 py-1 text-[10px] font-extrabold rounded-md uppercase tracking-wider border shadow-sm ${getRoleBadge(u.role)}`}",[15666,15723],">\n                            {u.role.replace('_', ' ')}",[15724,15784],[15785,15839],[15840,15946],"                        <td className=\"p-4 text-center border-r border-gray-100\">",[15947,16013],"                          {isActive ? (",[16014,16244],"                            <span className=\"px-2.5 py-1 bg-emerald-50 border border-emerald-200 text-emerald-600 text-[10px] font-extrabold rounded-md uppercase tracking-wider shadow-sm\">",[16275,16303],"Active\n                            </span>",[16330,16528],") : (\n                            <span className=\"px-2.5 py-1 bg-gray-100 border border-gray-300 text-gray-500 text-[10px] font-extrabold rounded-md uppercase tracking-wider shadow-sm\">",[16559,16639],"Disabled\n                            </span>\n                          )}",[16664,16730],"</td>\n                        <td className=\"p-4 text-right space-x-2\">",[16757,16792],"<button\n                            onClick={() =>",[16823,16948],"setUserToEditPerms({\n                                id: u.id,\n                                username: u.username,\n                                perms: u.permissions || []\n                              })",[16977,17194],"}\n                            className=\"text-[10px] font-extrabold uppercase tracking-wider px-3 py-1.5 rounded-md transition cursor-pointer shadow-sm bg-white border border-gray-300 text-[#1B9387] hover:bg-[#E9FAFA]\"",[17195,17249],[17250,17313],"                            Access",[17314,17376],[17377,17438],[17439,17562],"                            onClick={() => setUserToReset({ id: u.id, username: u.username })}",[17563,17805],"                            className=\"text-[10px] font-extrabold uppercase tracking-wider px-3 py-1.5 rounded-md transition cursor-pointer shadow-sm bg-white border border-gray-300 text-blue-600 hover:bg-blue-50\"",[17806,17860],[17861,17928],"                            Reset Pass",[17929,17991],[17992,18053],[18082,18188],"onClick={() =>\n                              setUserToToggle({ id: u.id, username: u.username, isActive })",[18217,18509],"}\n                            className={`text-[10px] font-extrabold uppercase tracking-wider px-3 py-1.5 rounded-md transition cursor-pointer shadow-sm border ${isActive ? 'bg-red-50 border-red-200 text-red-600 hover:bg-red-100' : 'bg-teal-600 border-teal-600 text-white hover:bg-teal-700'}`}",[18510,18564],[18565,18655],"                            {isActive ? 'Disable' : 'Enable'}",[18656,18718],[18719,18773],[18774,18824],[18825,18868],"                    )",[18869,18908],"                  })",[18909,18944],[18945,18982],[18983,19016],[19017,19044],[19045,19068],[19069,19088],[19089,19090],[19091,19125],"      {userToEditPerms && (",[19126,19245],"        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4\">",[19246,19422],"          <div className=\"bg-white border border-[#B0DCDA] rounded-xl shadow-2xl p-8 w-full max-w-2xl max-h-[90vh] flex flex-col animate-in zoom-in-95 duration-200\">",[19423,19509],"            <div className=\"border-b border-gray-100 pb-4 mb-4 shrink-0\">",[19510,19616],"              <h3 className=\"text-xl font-extrabold text-gray-800 uppercase tracking-wide\">",[19617,19691],"                Custom Access: {userToEditPerms.username}",[19692,19726],[19727,19810],"              <p className=\"text-sm text-gray-500 font-medium mt-1\">",[19811,19973],"                Check boxes to explicitly grant access. If you leave all boxes unchecked, the user\n                will revert to their default Role permissions.",[19988,20007],"</p>",[20008,20039],[20040,20065],[20066,20153],"            <div className=\"flex-1 overflow-y-auto pr-2 custom-scrollbar\">",[20154,20223],"              <div className=\"grid grid-cols-2 gap-4\">",[20224,20278],"                {MODULES.map((mod) => (",[20297,20505],"<div\n                    key={mod.id}\n                    className=\"flex items-center p-3 bg-[#FBF8F8] border border-gray-200 rounded-lg hover:border-[#1B9387] transition cursor-pointer\"\n                    onClick={() => togglePermission(mod.id)}",[20524,20554],">\n                    <input",[20555,20616],"                      type=\"checkbox\"",[20617,20711],"                      checked={userToEditPerms.perms.includes(mod.id)}",[20734,20765],"readOnly",[20788,20894],"className=\"w-5 h-5 text-[#1B9387] bg-white border-gray-300 rounded cursor-pointer\"",[20895,20938],[20939,21065],"                    <span className=\"ml-3 text-sm font-bold text-gray-700 select-none\">",[21088,21182],"{mod.label}\n                    </span>\n                  </div>\n                ))}\n              </div>",[21183,21214],[21215,21216],[21217,21326],"            <div className=\"flex justify-end gap-3 pt-6 border-t border-gray-100 mt-4 shrink-0\">",[21341,21553],"<button\n                onClick={() => setUserToEditPerms(null)}\n                className=\"px-5 py-2.5 bg-[#FBF8F8] border border-[#B0DCDA] hover:bg-gray-100 text-gray-600 rounded-md text-sm font-bold transition cursor-pointer\"",[21568,21593],[21594,21632],[21647,21873],"<button\n                onClick={handleSavePermissions}\n                disabled={loading}\n                className=\"px-5 py-2.5 bg-[#1B9387] hover:bg-[#28958B] text-white rounded-md text-sm font-bold transition cursor-pointer shadow-sm disabled:opacity-50\"",[21888,21951],">\n                {loading ? 'Saving...' : 'Save Permissions'}",[21952,21990],[21991,22022],[22033,22050],[22051,22074],[22075,22090],[22091,22092],[22093,22124],"      {userToToggle && (",[22125,22240],"        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm\">",[22241,22383],"          <div className=\"bg-white border border-[#B0DCDA] rounded-xl shadow-2xl p-8 w-[420px] animate-in zoom-in-95 duration-200\">",[22384,22560],"            <h3 className=\"text-xl font-extrabold text-gray-800 mb-2 uppercase tracking-wide\">\n              {userToToggle.isActive ? 'Disable Account?' : 'Enable Account?'}",[22573,23017],"</h3>\n            <p className=\"text-sm text-gray-600 mb-8 font-medium leading-relaxed\">\n              {userToToggle.isActive ? (\n                <>\n                  Are you sure you want to disable{' '}\n                  <strong className=\"text-gray-800\">{userToToggle.username}</strong>? They will be\n                  instantly logged out and prevented from signing in.\n                </>\n              ) : (\n                <>\n                  Are you sure you want to re-enable{' '}\n                  <strong className=\"text-gray-800\">{userToToggle.username}</strong>? They will be\n                  allowed to log into the system again.\n                </>\n              )}",[23030,23113],"</p>\n            <div className=\"flex justify-end gap-3 pt-4 border-t border-gray-100\">",[23128,23352],"<button\n                onClick={() => setUserToToggle(null)}\n                className=\"px-5 py-2.5 bg-[#FBF8F8] border border-[#B0DCDA] hover:bg-gray-100 text-gray-600 rounded-md text-sm font-bold transition cursor-pointer\"\n              >\n                Cancel\n              </button>",[23367,23680],"<button\n                onClick={confirmToggleStatus}\n                className={`px-5 py-2.5 text-white rounded-md text-sm font-bold transition cursor-pointer shadow-sm ${userToToggle.isActive ? 'bg-red-500 hover:bg-red-600' : 'bg-[#1B9387] hover:bg-[#28958B]'}`}\n              >\n                {userToToggle.isActive ? 'Disable User' : 'Enable User'}",[23695,23712],[23713,23740],[23741,23764],[23765,23780],[23781,23782],[23783,23813],"      {userToReset && (",[23814,23929],[23930,24072],[24073,24199],"            <h3 className=\"text-xl font-extrabold text-gray-800 mb-2 uppercase tracking-wide\">\n              Reset Password",[24212,24382],"</h3>\n            <p className=\"text-sm text-gray-600 mb-6 font-medium\">\n              Set a new temporary password for{' '}\n              <strong className=\"text-gray-800\">{userToReset.username}</strong>.",[24395,24446],"</p>\n            <form onSubmit={confirmResetPassword}>",[24447,24498],"              <div className=\"mb-8\">",[24499,24649],"                <label className=\"block text-[10px] font-extrabold text-[#1B9387] uppercase tracking-wider mb-2\">\n                  New Password\n                </label>",[24665,24990]," <input\n                  type=\"text\"\n                  autoFocus\n                  required\n                  placeholder=\"Enter new password\"\n                  value={newPassword}\n                  onChange={(e) => setNewPassword(e.target.value)}\n                  className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-3 text-sm text-gray-800 font-medium focus:border-[#1B9387] outline-none transition shadow-inner\"",[25007,25026],[25027,25126],[25143,25382],"<button\n                  type=\"button\"\n                  onClick={() => setUserToReset(null)}\n                  className=\"px-5 py-2.5 bg-[#FBF8F8] border border-[#B0DCDA] hover:bg-gray-100 text-gray-600 rounded-md text-sm font-bold transition cursor-pointer\"\n                >\n                  Cancel\n                </button>",[25399,25660],"<button\n                  type=\"submit\"\n                  disabled={!newPassword}\n                  className=\"px-5 py-2.5 bg-blue-600 hover:bg-blue-500 disabled:bg-gray-300 disabled:text-gray-500 text-white rounded-md text-sm font-bold transition cursor-pointer shadow-sm\"",[25677,25729],">\n                  Update Password\n                </button>",[25730,25757],[25758,25781],"            </form>\n          </div>",[25782,25797],"        </div>\n      )}",[25798,25813],[25816,25821],[25823,25823],[32,33],[34,35],[76,77],[141,142],[143,144],[155,156],[186,187],[261,262],[332,333],[395,396],[406,407],[411,412],[414,415],[416,417],[441,442],[52,53],[84,86],[130,132],[141,142],[143,158],"  RefreshCw,",[159,172],"  Loader2,",[173,191],"  CheckCircle2,",[194,209],"AlertCircle,",[210,220],"  Copy,",[221,232],"  Check,",[233,246],"  XCircle,",[247,259],"  Search,",[262,271],"Clock3",[293,295],[296,297],[335,337],[338,339],[407,408],[409,476],"  const [viewMode, setViewMode] = useState<ViewMode>('PENDING')",[477,528],"  const [voids, setVoids] = useState<any[]>([])",{"messageId":"71332","fix":"72354","desc":"71334"},{"messageId":"71335","fix":"72355","desc":"71337"},[529,584],"  const [history, setHistory] = useState<any[]>([])",{"messageId":"71332","fix":"72356","desc":"71334"},{"messageId":"713