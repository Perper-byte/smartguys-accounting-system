↻</span> Processing...\n                  </>\n                ) : (\n                  'Post Payroll'",[26070,26108],"                )}\n              </button>",[26109,26140],[26141,26168],[26169,26188],[26189,26190],[26191,26258],"        {/* ========================================== */}",[26267,26326],"{/* PAYSLIP HISTORY TAB                        */}",[26335,26394],[26403,26436],"{view === 'HISTORY' && (",[26437,26562],"          <div className=\"flex-1 flex flex-col animate-in fade-in duration-300 min-h-0 bg-[#FBF8F8] print:hidden\">",[26563,26687],"            <div className=\"p-6 border-b border-[#B0DCDA] flex justify-between items-center bg-white shrink-0\">",[26688,26723],[26740,26808],"type=\"text\"\n                placeholder=\"Search voucher or memo...\"",[26809,26906],"                value={histSearch}\n                onChange={(e) => setHistSearch(e.target.value)}",[26907,27062],"                className=\"w-80 bg-gray-50 border border-gray-300 rounded-md p-2.5 text-sm outline-none focus:border-[#1B9387] transition\"",[27063,27094],[27095,27126],[27127,27204],"            <div className=\"flex-1 overflow-auto p-6 space-y-4\">",[27205,27267],"              {filteredHistory.length === 0 ? (",[27268,27350],"                <div className=\"py-16 text-center text-gray-500\">",[27351,27436],"                  <span className=\"block text-4xl mb-3\">🕰️</span>",[27437,27566],"                  <span className=\"italic font-medium\">\n                    No payroll history found matching your criteria.",[27585,27606],[27607,27641],[27642,27705],"                filteredHistory.map((run) => {",[27706,27788],"                  const isEmptyRun = run.payslips.length === 0",[27789,27874],"                  const isExpanded = expandedHistoryId === run.id",[27875,27920],[27941,28193],"<div\n                      key={run.id || run.referenceNo}\n                      className={`bg-white border rounded-xl shadow-sm overflow-hidden transition-all duration-200 ${isExpanded ? 'border-[#1B9387] ring-1 ring-[#1B9387]' : 'border-gray-200 hover:border-gray-300'}`}",[28194,28243],"                    >\n                      <div",[28244,28357],"                        onClick={() => setExpandedHistoryId(isExpanded ? null : run.id)}",[28358,28491],"                        className=\"p-5 flex justify-between items-center cursor-pointer hover:bg-gray-50/50\"",[28492,28538],"                      >",[28539,28639],"                        <div className=\"flex items-center space-x-6 w-1/2\">",[28640,28787],"                          <span className=\"font-extrabold font-mono text-gray-800 text-lg w-20\">\n                            {run.referenceNo}",[28814,28959],"</span>\n                          <span className=\"text-gray-500 font-medium text-sm tabular-nums w-24\">\n                            {new Date(run.date).toLocaleDateString()}",[28986,29096],"</span>\n                          <span className=\"text-gray-800 font-bold text-sm truncate\">",[29125,29152],"{run.description}\n                          </span>",[29177,29247],"</div>\n                        <div className=\"flex items-center space-x-8\">",[29248,29389],"                          <span className=\"text-sm font-bold text-gray-500\">\n                            {run.payslips.length} Employees",[29416,29542],"</span>\n                          <span className=\"text-lg font-black text-gray-800 font-mono tabular-nums min-w-[120px] text-right\">",[29543,29682],"                            {formatCurrency(\n                              run.payslips.reduce((sum: number, p: any) => sum + p.net_pay, 0)",{"messageId":"71332","fix":"72183","desc":"71334"},{"messageId":"71335","fix":"72184","desc":"71337"},[29710,29743]," )}\n                          </span>",[29744,29745],[29746,29837],"                          {/* UX FIX: Distinct Status Badges */}",[29838,29906],"                          {isEmptyRun ? (",[29907,30143],"                            <span classN