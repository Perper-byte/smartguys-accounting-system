with `····················{new·Date(selectedInvoice.date).toLocaleDateString('en-US',·{⏎······················month:·'long',⏎······················day:·'numeric',⏎······················year:·'numeric'⏎····················})}⏎··················</span>`",{"range":"61278","text":"61279"},{"range":"61280","text":"54386"},"Replace `································<div·className=\"flex·flex-col·items-end\">␍` with `················<div·className=\"flex·flex-col·items-end\">`",{"range":"61281","text":"61282"},"Replace `····································<span·className=\"text-[10px]·font-bold·text-gray-500·uppercase·tracking-wider·mb-1\">Current·Status</span>␍` with `··················<span·className=\"text-[10px]·font-bold·text-gray-500·uppercase·tracking-wider·mb-1\">⏎····················Current·Status`",{"range":"61283","text":"61284"},"Replace `··················{renderStatusBadge(selectedInvoice.status)}␍` with `</span>⏎··················{renderStatusBadge(selectedInvoice.status)}`",{"range":"61285","text":"61286"},{"range":"61287","text":"54386"},{"range":"61288","text":"53341"},{"range":"61289","text":"45467"},"Replace `····························<div·className=\"bg-[#FBF8F8]·border·border-gray-200·rounded-lg·p-5\">␍` with `··············<div·className=\"bg-[#FBF8F8]·border·border-gray-200·rounded-lg·p-5\">`",{"range":"61290","text":"61291"},"Replace `································<div·className=\"flex·justify-between·items-center·mb-3·pb-3·border-b·border-gray-200·border-dashed\">␍` with `················<div·className=\"flex·justify-between·items-center·mb-3·pb-3·border-b·border-gray-200·border-dashed\">`",{"range":"61292","text":"61293"},"Replace `····································<span·className=\"text-sm·font-bold·text-gray-500\">Total·Billed</span>␍` with `··················<span·className=\"text-sm·font-bold·text-gray-500\">Total·Billed</span>`",{"range":"61294","text":"61295"},"Replace `····································<span·className=\"font-mono·fo