pan>Input·VAT:</span>·<span>{formatCurrency(inputVat)}</span></div>␍` with `</div>⏎················<div·className=\"flex·justify-between·mb-1\">⏎··················<span>Input·VAT:</span>·<span>{formatCurrency(inputVat)}</span>`",{"range":"54709","text":"54710"},"Replace `················<div·className=\"border-t·border-gray-300·my-2\"></div>␍` with `</div>⏎················<div·className=\"border-t·border-gray-300·my-2\"></div>`",{"range":"54711","text":"54712"},"Replace `································<div·className=\"flex·justify-between·text-lg·font-black·text-[#1B9387]\"><span·className=\"font-sans·uppercase\">Total:</span>·<span>{formatCurrency(totalCashOut)}</span></div>␍` with `················<div·className=\"flex·justify-between·text-lg·font-black·text-[#1B9387]\">⏎··················<span·className=\"font-sans·uppercase\">Total:</span>{'·'}⏎··················<span>{formatCurrency(totalCashOut)}</span>`",{"range":"54713","text":"54714"},"Replace `····························</div>␍` with `················</div>`",{"range":"54715","text":"54386"},"Replace `························</div>␍` with `··············</div>`",{"range":"54716","text":"53341"},"Replace `············<div·className=\"p-4·bg-gray-50·border-t·border-gray-200·flex·justify-end·space-x-3\">␍` with `</div>⏎············<div·className=\"p-4·bg-gray-50·border-t·border-gray-200·flex·justify-end·space-x-3\">`",{"range":"54717","text":"54718"},"Replace `··············<button·onClick={()·=>·setShowConfirmModal(false)}·className=\"px-5·py-2.5·rounded-md·font-bold·text-gray-600·bg-white·border·border-gray-300·hover:bg-gray-100·transition\">Cancel</button>␍` with `<button⏎················onClick={()·=>·setShowConfirmModal(false)}⏎················className=\"px-5·py-2.5·rounded-md·font-bold·text-gray-600·bg-white·border·border-gray-300·hover:bg-gray-100·transition\"⏎··············>⏎················Cancel⏎··············</button>`",{"range":"54719","text":"54720"},"Replace `··············<button·onClick={executeSubmit}·className=\"px-5·py-2.5·rounded-md·font-black·uppercase·tracking-wider·text-white·bg-[#1B9387]·hover:bg-[#28958B]·shadow-md·transition\">Confirm·&·Issue</button>␍` with `<button⏎················onClick={executeSubmit}⏎················className=\"px-5·py-2.5·rounded-md·font-black·uppercase·tracking-wider·text-white·bg-[#1B9387]·hover:bg-[#28958B]·shadow-md·transition\"⏎··············>⏎················Confirm·&·Issue`",{"range":"54721","text":"54722"},"Replace `··········</div>␍` with `</button>⏎············</div>`",{"range":"54723","text":"53231"},{"range":"54724","text":"51900"},{"range":"54725","text":"51431"},{"range":"54726","text":"51433"},{"range":"54727","text":"45467"},"Replace `············<NewContactModal·isOpen={showAddPayee}·onClose={()·=>·setShowAddPayee(false)}·onSaveSuccess={()·=>·{·loadData();·setStatus({·type:·'success',·msg:·'Vendor·successfully·added!'·});·}}·defaultType=\"SUPPLIER\"·/>␍` with `······<NewContactModal⏎········isOpen={showAddPayee}⏎········onClose={()·=>·setShowAddPayee(false)}⏎········onSaveSuccess={()·=>·{⏎··········loadData()⏎··········setStatus({·type:·'success',·msg:·'Vendor·successfully·added!'·})⏎········}}⏎········defaultType=\"SUPPLIER\"`",{"range":"54728","text":"54729"},{"range":"54730","text":"52420"},{"range":"54731","text":"51476"},{"range":"54732","text":"45546"},{"range":"54733","text":"45467"},{"range":"54734","text":"45467"},{"range":"54735","text":"45467"},{"range":"54736","text":"45467"},{"range":"54737","text":"45467"},["54738","54739"],{"range":"54740","text":"45467"},{"range":"54741","text":"45467"},{"range":"54742","text":"45467"},{"range":"54743","text":"45467"},{"range":"54744","text":"45467"},{"range":"54745","text":"45467"},{"range":"54746","text":"45467"},{"range":"54747","text":"45467"},{"range":"54748","text":"45467"},{"range":"54749","text":"45467"},["54750","54751"],{"range":"54752","text":"45467"},{"range":"54753","text":"45467"},{"range":"54754","text":"45467"},{"range":"54755","text":"45467"},{"range":"54756","text":"45467"},{"range":"54757","text":"45467"},{"range":"54758","text":"45467"},{"range":"54759","text":"45467"},{"range":"54760","text":"45467"},{"range":"54761","text":"45467"},{"range":"54762","text":"45467"},{"range":"54763","text":"45467"},{"range":"54764","text":"45467"},["54765","54766"],["54767","54768"],{"range":"54769","text":"45467"},{"range":"54770","text":"45467"},{"range":"54771","text":"45467"},{"range":"54772","text":"45467"},{"range":"54773","text":"45467"},{"range":"54774","text":"45467"},{"range":"54775","text":"45467"},{"range":"54776","text":"45467"},{"range":"54777","text":"45467"},{"range":"54778","text":"45467"},{"range":"54779","text":"45467"},{"range":"54780","text":"45467"},{"range":"54781","text":"45467"},{"range":"54782","text":"45467"},{"range":"54783","text":"45467"},{"range":"54784","text":"45467"},{"range":"54785","text":"45467"},{"range":"54786","text":"45467"},{"range":"54787","text":"45467"},{"range":"54788","text":"45467"},{"range":"54789","text":"45467"},{"range":"54790","text":"45467"},{"range":"54791","text":"45467"},["54792","54793"],{"range":"54794","text":"45467"},{"range":"54795","text":"45467"},{"range":"54796","text":"45467"},{"range":"54797","text":"45467"},{"range":"54798","text":"45467"},{"range":"54799","text":"45467"},{"range":"54800","text":"45467"},{"range":"54801","text":"45467"},{"range":"54802","text":"45467"},{"range":"54803","text":"45467"},{"range":"54804","text":"45467"},{"range":"54805","text":"45467"},{"range":"54806","text":"45467"},{"range":"54807","text":"45467"},{"range":"54808","text":"45467"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\MY PC\\Desktop\\lol\\smartguys-accounting-system\\src\\renderer\\src\\components\\CashierHistoryView.tsx:67:5\n  65 |\n  66 |   useEffect(() => {\n> 67 |     fetchHistory()\n     |     ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  68 |   }, [userId])\n  69 |\n  70 |   useEffect(() => {",{"range":"54809","text":"45467"},"React Hook useEffect has a missing dependency: 'fetchHistory'. Either include it or remove the dependency array.",["54810"],{"range":"54811","text":"45467"},{"range":"54812","text":"45467"},{"range":"54813","text":"45467"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\MY PC\\Desktop\\lol\\smartguys-accounting-system\\src\\renderer\\src\\components\\CashierHistoryView.tsx:71:5\n  69 |\n  70 |   useEffect(() => {\n> 71 |     setCurrentPage(1)\n     |     ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  72 |   }, [searchQuery, dateFilter])\n  73 |\n  74 |   useEffect(() => {",{"range":"54814","text":"45467"},{"range":"54815","text":"45467"},{"