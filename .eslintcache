es, { accountId: '', debit: 0, credit: 0 }])",[4533,4534],[4535,4606],"  const updateLine = (index: number, field: string, value: any) => {",{"messageId":"71332","fix":"71640","desc":"71334"},{"messageId":"71335","fix":"71641","desc":"71337"},[4607,4644],"    const newLines = [...lines]",[4645,4713],"    newLines[index][field as keyof (typeof newLines)[0]] = value",[4714,4786],"    if (field === 'debit' && value > 0) newLines[index].credit = 0",[4787,4859],"    if (field === 'credit' && value > 0) newLines[index].debit = 0",[4860,4888],"    setLines(newLines)",[4889,4896],[4897,4898],[4899,4943],"  const removeLine = (index: number) => {",[4944,4983],"    if (lines.length <= 2) return",[4984,5046],"    const newLines = lines.filter((_, i) => i !== index)",[5047,5075],[5076,5083],[5084,5085],[5086,5161],"  const handleFileSelect = (e: React.ChangeEvent<HTMLInputElement>) => {",[5162,5236],"    if (e.target.files) handleFilesAdded(Array.from(e.target.files))",[5237,5244],[5245,5246],[5247,5312],"  const handleDrop = (e: React.DragEvent<HTMLDivElement>) => {",[5313,5341],[5342,5372],"    setIsDragging(false)",[5373,5459],"    if (e.dataTransfer.files) handleFilesAdded(Array.from(e.dataTransfer.files))",[5460,5467],[5468,5469],[5470,5520],"  const handleFilesAdded = (files: File[]) => {",[5521,5571],"    const validFiles = files.filter((file) => {",[5572,5760],"      const isValidType = [\n        'image/jpeg',\n        'image/png',\n        'application/pdf',\n        'application/zip',\n        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'\n      ].includes(file.type)",[5761,5824],"      const isValidSize = file.size <= 10 * 1024 * 1024",[5831,5908],"if (!isValidType) alert(`${file.name} is not a supported file type.`)",[5909,5986],"      if (!isValidSize) alert(`${file.name} exceeds the 10MB limit.`)",[5987,6034],"      return isValidType && isValidSize",[6035,6047],[6048,6049],[6050,6109],"    if (attachments.length + validFiles.length > 10) {",[6110,6191],"      alert('You can only upload a maximum of 10 attachments per entry.')",[6192,6212],[6213,6223],[6224,6282],"    setAttachments((prev) => [...prev, ...validFiles])",[6283,6290],[6291,6292],[6295,6343],"const removeAttachment = (index: number) => {",[6344,6412],"    setAttachments((prev) => prev.filter((_, i) => i !== index))",[6413,6420],[6421,6422],[6423,6468],"  const processAttachments = async () => {",[6469,6530],"    return Promise.all(\n      attachments.map(async (file) => {",[6531,6666],"        return new Promise<{\n          name: string\n          type: string\n          size: number\n          data: string | ArrayBuffer | null\n        }>((resolve, reject) => {",[6667,6716],"          const reader = new FileReader()",[6717,6840],"          reader.onload = () =>\n            resolve({ name: file.name, type: file.type, size: file.size, data: reader.result })",[6841,6882],"          reader.onerror = reject",[6893,6927],"reader.readAsDataURL(file)",[6928,6944],[6945,6958],[6963,6968],[6971,7053],"}\n\n  const totalDebit = lines.reduce((sum, ln) => sum + (Number(ln.debit) || 0), 0)",[7054,7140],"  const totalCredit = lines.reduce((sum, ln) => sum + (Number(ln.credit) || 0), 0)",[7141,7232],"  const isBalanced = totalDebit > 0 && totalDebit.toFixed(2) === totalCredit.toFixed(2)",[7233,7238],[7239,7317],"  const isLocked = lockDate ? new Date(date) <= new Date(lockDate) : false",[7318,7319],[7320,7359],"  const handleSubmit = async () => {",[7360,7385],[7386,7412],"    setLoading(true)",[7413,7414],[7415,7429],[7436,7537],"if (!refSequence.trim()) throw new Error('Please enter a Sequence Number for the Reference.')",[7538,7551],[7552,7603],"      if (isLocked && !overridePin.trim()) {",[7604,7698],"        throw new Error('An Override PIN is required to post into a locked period.')",[7699,7713],[7714,7715],[7716,7819],"      const validLines = lines.filter((l) => l.accountId !== '' && (l.debit > 0 || l.credit > 0))",[7820,7896],{"messageId":"71