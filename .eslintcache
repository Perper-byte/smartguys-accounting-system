","fix":"71696","desc":"71334"},{"messageId":"71335","fix":"71697","desc":"71337"},{"messageId":"71332","fix":"71698","desc":"71334"},{"messageId":"71335","fix":"71699","desc":"71337"},[949,1036],"      const result = await api.getBooksOfAccounts(bookType, startDate, endDate)",[1037,1072],"      setData(result || [])",[1073,1099],[1100,1159],"      console.error('Failed to fetch books', error)",[1160,1180],[1181,1212],[1213,1223],[1224,1231],[1232,1233],[1234,1256],[1257,1279],"    fetchBooks()",[1282,1300],"}, [bookType])",{"desc":"71700","fix":"71701"},[1301,1302],[1303,1366],"  // UX: Return null/dash for zeros to keep the ledger clean",[1367,1416],"  const formatCurrency = (amount: number) => {",[1417,1467],"    if (!amount || amount === 0) return null",[1468,1578],"    return `₱ ${amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`",[1579,1586],[1587,1588],[1591,1625],"const handleExportCSV = () => {",[1626,1693],"    if (data.length === 0) return alert('No data to export.')",[1694,1695],[1696,1828],"    const headers = [\n      'Date',\n      'Reference No',\n      'Payee/Entity',\n      'Description',\n      'Account Code',\n      'Account Name',\n      'Debit',\n      'Credit'",[1833,1868],"]\n    const rows = data.map((row) =>",[1875,1922],"[\n        new Date(row.date).toLocaleDateString(),",[1923,1952],"        row.referenceNo,",[1953,1993],"        `\"${row.payeeName || ''}\"`,",[1994,2050],"        `\"${row.description.replace(/\"/g, '\"\"')}\"`,",[2059,2080],"row.accountCode,",[2081,2117],"        `\"${row.accountName}\"`,",[2118,2162],"        row.debit > 0 ? row.debit : '',",[2163,2208],"        row.credit > 0 ? row.credit : ''",[2209,2233],"      ].join(',')",[2238,2302],")\n\n    const csvContent = [headers.join(','), ...rows].join('\\n')",[2307,2385],"const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' })",[2386,2433],[2438,2484],"const link = document.createElement('a')",[2485,2510],"    link.href = url",[2511,2605],"    link.setAttribute('download', `BIR_Book_${bookType}_${startDate}_to_${endDate}.csv`)",[2606,2647],"    document.body.appendChild(link)",[2648,2670],"    link.click()",[2671,2712],"    document.body.removeChild(link)",[2713,2720],[2721,2722],[2723,2756],"  const getBookTitle = () => {",[2757,2785],"    switch (bookType) {",[2786,2833],"      case 'SJ':\n        return 'Sales Journal'",[2834,2890],"      case 'CRJ':\n        return 'Cash Receipts Journal'",[2891,2952],"      case 'CDJ':\n        return 'Cash Disbursements Journal'",[2953,3003],"      case 'PJ':\n        return 'Purchase Journal'",[3004,3053],"      case 'GJ':\n        return 'General Journal'",[3054,3093],"      default:\n        return 'Journal'",[3094,3104],[3105,3112],[3113,3114],[3115,3185],"  const totalDebit = data.reduce((sum, row) => sum + row.debit, 0)",[3186,3258],"  const totalCredit = data.reduce((sum, row) => sum + row.credit, 0)",[3259,3260],[3261,3274],[3279,3329],"// ✨ UX FIX: Full-page flex centering wrapper",[3330,3428],"    <div className=\"w-full h-full flex items-center justify-center p-4 lg:p-8 bg-gray-50/30\">",[3429,3581],"      <div className=\"w-full max-w-7xl h-full bg-white border border-transparent rounded-xl p-6 shadow-sm flex flex-col font-sans text-gray-800\">",[3582,3615],"        {/* HEADER */}",[3616,3726],"        <div className=\"flex justify-between items-end mb-6 border-b border-[#B0DCDA] pb-6 shrink-0\">",[3727,3753],[3754,3873],"            <h2 className=\"text-2xl font-extrabold text-gray-800 tracking-wide\">\n              BIR Books of Accounts",[3886,4004],"</h2>\n            <p className=\"text-sm text-gray-500 mt-1 font-medium\">\n              CAS-compliant mandatory journals export module.",[4017,4032],[4033,4034],[4035,4107],"          <div className=\"flex flex-col items-end space-y-4\">",[4108,4155],"            {/* DATE FILTERS */}",[4156,4226],"            <div className=\"flex items-center space-x-3\">",[4227,4367],"  