ate synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\MY PC\\Desktop\\lol\\smartguys-accounting-system\\src\\renderer\\src\\components\\InvoiceTrackerView.tsx:44:23\n  42 |     };\n  43 |\n> 44 |     useEffect(() => { fetchInvoices(); }, []);\n     |                       ^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  45 |\n  46 |     const formatCurrency = (amount: number, showSymbol = false) => {\n  47 |         if (!amount || amount === 0) return '-';",{"range":"60765","text":"45467"},"Replace `····const·formatCurrency·=·(amount:·number,·showSymbol·=·false)·=>·{␍` with `··const·formatCurrency·=·(amount:·number,·showSymbol·=·false)·=>·{`",{"range":"60766","text":"60767"},"Replace `········if·(!amount·||·amount·===·0)·return·'-';␍` with `····if·(!amount·||·amount·===·0)·return·'-'`",{"range":"60768","text":"60769"},"Replace `····const·formatted·=·amount.toLocaleString('en-US',·{·minimumFractionDigits:·2,·maximumFractionDigits:·2·});␍` with `const·formatted·=·amount.toLocaleString('en-US',·{⏎······minimumFractionDigits:·2,⏎······maximumFractionDigits:·2`",{"range":"60770","text":"60771"},"Replace `····return·showSymbol·?·`₱·${formatted}`·:·formatted;␍` with `})⏎····return·showSymbol·?·`₱·${formatted}`·:·formatted`",{"range":"60772","text":"60773"},{"range":"60774","text":"45556"},{"range":"60775","text":"45467"},"Replace `····const·getInitials·=·(name:·string)·=>·{␍` with `··const·getInitials·=·(name:·string)·=>·{`",{"range":"60776","text":"60777"},"Replace `········if·(!name)·return·'';␍` with `····if·(!name)·return·''`",{"range":"60778","text":"60779"},"Replace `········const·words·=·name.trim().split(/\\s+/);␍` with `····const·words·=·name.trim().split(/\\s+/)`",{"range":"60780","text":"60781"},"Replace `········if·(words.length·===·1)·return·words[0].substring(0,·2).toUpperCase();␍` with `····if·(words.length·==