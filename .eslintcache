ngle size={18} />",[7133,7163],")}\n          {statusMessage.msg}",[7164,7187],[7188,7203],[7204,7205],[7206,7262],"      <div className=\"flex-1 flex gap-8 min-h-0\">",[7263,7297],"        {/* LEFT PANE */}",[7298,7422],"        <div className=\"w-1/3 bg-white border border-[#B0DCDA] rounded-xl shadow-sm flex flex-col overflow-hidden\">",[7423,7514],"          <div className=\"p-4 bg-[#FBF8F8] border-b border-[#B0DCDA] space-y-3\">",[7515,7566],"            <div className=\"relative\">",[7567,7683],"              <Search\n                className=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-400\"\n                size={16}",[7698,7719],"/>\n              <input",[7720,7764],[7765,7837],"                placeholder=\"Search product or code...\"",[7838,7890],"                value={searchQuery}",[7907,7970],"onChange={(e) => setSearchQuery(e.target.value)}",[7971,8176],"                className=\"w-full pl-9 bg-white border border-[#B0DCDA] rounded-md px-3 py-2 text-sm focus:outline-none focus:border-[#1B9387] focus:ring-2 focus:ring-[#E9FAFA] transition\"",[8177,8208],[8209,8240],[8241,8273],[8274,8347],"              onClick={() => setShowNewItem(!showNewItem)}",[8348,8560],"              className={`w-full flex items-center justify-center gap-2 px-3 py-2 rounded-md text-xs font-extrabold tracking-wider uppercase transition shadow-sm cursor-pointer border ${",[8577,8660],"showNewItem\n                  ? 'bg-gray-50 border-gray-200 text-gray-500 hover:bg-gray-100'",[8661,8761],"                  : 'bg-white border-[#B0DCDA] text-[#1B9387] hover:bg-[#E9FAFA]'",[8776,8798],"}`}\n            >",[8799,8825],"              {showNewItem ? (",[8838,8936],"    <>\n                  <X size={14} /> Cancel\n                </>\n              ) : (\n                <>\n                  <Plus size={14} /> New Product",[8953,9001],"</>\n              )}\n            </button>",[9012,9040],"</div>\n\n          {showNewItem && (",[9053,9178],"<form\n              onSubmit={handleCreateItem}\n              className=\"p-4 bg-[#E9FAFA] border-b border-[#B0DCDA] shadow-inner space-y-3\"",[9179,9248],"            >\n              <div className=\"grid grid-cols-2 gap-3\">",[9249,9310],"                <div className=\"col-span-2\">",[9311,9460],"                  <label className=\"block text-xs font-extrabold text-gray-500 uppercase tracking-wider mb-1\">\n                    Product Name\n                  </label>",[9479,9788],"<input\n                    required\n                    value={newItem.name}\n                    onChange={(e) => setNewItem({ ...newItem, name: e.target.value })}\n                    placeholder=\"e.g. Biogesic 500mg\"\n                    className=\"w-full bg-white border border-[#B0DCDA] rounded p-2 text-sm outline-none focus:border-[#1B9387] focus:ring-2 focus:ring-white/50 transition\"",[9807,9828],[9829,9862],[9863,9901],[9902,10048],"                  <label className=\"block text-xs font-extrabold text-gray-500 uppercase tracking-wider mb-1\">\n                    Item Code\n                  </label>",[10067,10369],"<input\n                    required\n                    value={newItem.code}\n                    onChange={(e) => setNewItem({ ...newItem, code: e.target.value })}\n                    placeholder=\"e.g. MED-001\"\n                    className=\"w-full bg-white border border-[#B0DCDA] rounded p-2 text-sm outline-none focus:border-[#1B9387] focus:ring-2 focus:ring-white/50 transition\"",[10388,10409],[10410,10411],[10412,10450],[10451,10598],"                  <label className=\"block text-xs font-extrabold text-gray-500 uppercase tracking-wider mb-1\">\n                    Unit / UOM\n                  </label>",[10599,10921],"                  <select\n                    value={newItem.uom}\n                    onChange={(e) => setNewItem({ ...newItem, uom: e.target.value })}\n                    className=\"w-full bg-white border border-[#B0DCDA] rounded p-2 text-sm outline-