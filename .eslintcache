IsEditing(false)",[3625,3651],"      fetchItems()",[3652,3669],"    } else {",[3670,3763],"      setStatusMessage({ type: 'error', msg: res?.error || 'Failed to update item' })",[3764,3774],[3775,3782],[3783,3784],[3785,3821],"  // 🔥 NEW: Handle Deleting Item",[3822,3865],"  const handleDeleteItem = async () => {",[3870,4034],"if (\n      !window.confirm(\n        'Are you sure you want to delete this product? All of its stock history will also be permanently deleted. This cannot be undone.'",[4041,4044],")\n    )",[4045,4117],"      return\n\n    const api = (window as any).api || (window as any).electronAPI",{"messageId":"71332","fix":"72016","desc":"71334"},{"messageId":"71335","fix":"72017","desc":"71337"},{"messageId":"71332","fix":"72018","desc":"71334"},{"messageId":"71335","fix":"72019","desc":"71337"},[4118,4185],"    const res = await api.deleteInventoryItem(selectedItemId)",[4186,4195],[4196,4230],[4231,4320],"      setStatusMessage({ type: 'success', msg: 'Product deleted successfully.' })",[4321,4358],"      setSelectedItemId(null)",[4359,4385],[4390,4403],[4404,4497],"      setStatusMessage({ type: 'error', msg: res?.error || 'Failed to delete item' })",[4498,4508],[4509,4516],[4517,4518],[4519,4576],"  const handleAddLog = async (e: React.FormEvent) => {",[4577,4605],[4606,4654],"    if (!selectedItemId || !logQty) return",[4655,4656],[4657,4718],"    const inQty = logType === 'IN' ? Number(logQty) : 0",[4719,4782],"    const outQty = logType === 'OUT' ? Number(logQty) : 0",[4783,4784],[4785,4857],{"messageId":"71332","fix":"72020","desc":"71334"},{"messageId":"71335","fix":"72021","desc":"71337"},{"messageId":"71332","fix":"72022","desc":"71334"},{"messageId":"71335","fix":"72023","desc":"71337"},[4858,4906],"    const res = await api.addInventoryLog({",[4907,4943],"      itemId: selectedItemId,",[4944,4964],"      userId,",[4971,4984],"inQty,",[4985,5005],"      outQty,",[5006,5039],"      remarks: logRemarks,",[5040,5120],"      expiryDate: logType