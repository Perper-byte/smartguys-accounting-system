xt":"69698"},"Replace `············case·'CASHIER':·return·'bg-blue-50·text-blue-600·border-blue-200';␍` with `······case·'CASHIER':⏎········return·'bg-blue-50·text-blue-600·border-blue-200'`",{"range":"69699","text":"69700"},"Replace `············case·'IT_PERSONNEL':·return·'bg-rose-50·text-rose-600·border-rose-200';␍` with `······case·'IT_PERSONNEL':⏎········return·'bg-rose-50·text-rose-600·border-rose-200'`",{"range":"69701","text":"69702"},"Replace `············default:·return·'bg-gray-50·text-gray-600·border-gray-200';␍` with `······default:⏎········return·'bg-gray-50·text-gray-600·border-gray-200'`",{"range":"69703","text":"69704"},{"range":"69705","text":"47904"},{"range":"69706","text":"45556"},{"range":"69707","text":"45467"},{"range":"69708","text":"51415"},{"range":"69709","text":"68428"},{"range":"69710","text":"55655"},{"range":"69711","text":"55657"},"Replace `····················<h2·className=\"text-2xl·font-extrabold·text-gray-800·tracking-wide\">System·Settings·/·User·Management</h2>␍` with `··········<h2·className=\"text-2xl·font-extrabold·text-gray-800·tracking-wide\">⏎············System·Settings·/·User·Management`",{"range":"69712","text":"69713"},"Replace `··········<p·className=\"text-sm·text-gray-500·mt-1·font-medium\">Create·and·manage·access·credentials·and·fine-grained·permissions.</p>␍` with `</h2>⏎··········<p·className=\"text-sm·text-gray-500·mt-1·font-medium\">⏎············Create·and·manage·access·credentials·and·fine-grained·permissions.`",{"range":"69714","text":"69715"},{"range":"69716","text":"69247"},{"range":"69717","text":"52416"},{"range":"69718","text":"45467"},{"range":"69719","text":"60215"},{"range":"69720","text":"55673"},{"range":"69721","text":"55675"},{"range":"69722","text":"51431"},{"range":"69723","text":"51433"},{"range":"69724","text":"45467"},{"range":"69725","text":"55680"},{"range":"69726","text":"55684"},"Replace `····················<h3·className=\"text-lg·font-extrabold·text-gray-800·mb-5·border-b·border-gray-100·pb-3\">Create·New·Account</h3>␍` with `··········<h3·className=\"text-lg·font-extrabold·text-gray-800·mb-5·border-b·border-gray-100·pb-3\">⏎············Create·New·Account`",{"range":"69727","text":"69728"},"Replace `··········␍` with `</h3>`",{"range":"69729","text":"69730"},"Replace `····················<form·onSubmit={handleCreateUser}·className=\"space-y-4\">␍` with `⏎··········<form·onSubmit={handleCreateUser}·className=\"space-y-4\">`",{"range":"69731","text":"69732"},{"range":"69733","text":"53125"},"Replace `····························<label·className=\"block·text-[10px]·font-extrabold·text-gray-500·uppercase·tracking-wider·mb-1.5\">Username</label>␍` with `··············<label·className=\"block·text-[10px]·font-extrabold·text-gray-500·uppercase·tracking-wider·mb-1.5\">⏎················Username⏎··············</label>`",{"range":"69734","text":"69735"},"Replace `··············<input·type=\"text\"·required·placeholder=\"e.g.·juan_cashier\"·value={newUser.username}·onChange={e·=>·setNewUser({...newUser,·username:·e.target.value.toLowerCase().replace(/\\s/g,·'')})}·className=\"w-full·bg-[#FBF8F8]·border·border-[#B0DCDA]·rounded-md·p-2.5·text-sm·text-gray-800·font-medium·focus:border-[#1B9387]·outline-none·transition\"·/>␍` with `<input⏎················type=\"text\"⏎················required⏎················placeholder=\"e.g.·juan_cashier\"⏎················value={newUser.username}⏎················onChange={(e)·=>⏎··················setNewUser({⏎····················...newUser,⏎····················username:·e.target.value.toLowerCase().replace(/\\s/g,·'')⏎··················})⏎················}⏎················className=\"w-full·bg-[#FBF8F8]·border·border-[#B0DCDA]·rounded-md·p-2.5·text-sm·text-gray-800·font-medium·focus:border-[#1B9387]·outline-none·transition\"`",{"range":"69736","text":"69737"},"Replace `············</div>␍` with `··/>⏎············</div>`",{"range":"69738","text":"69739"},{"range":"69740","text":"53125"},"Replace `····························<label·className=\"block·text-[10px]·font-extrabold·text-gray-500·uppercase·tracking-wider·mb-1.5\">Temporary·Password</label>␍` with `··············<label·className=\"block·text-[10px]·font-extrabold·text-gray-500·uppercase·tracking-wider·mb-1.5\">⏎················Temporary·Password⏎··············</label>`",{"range":"69741","text":"69742"},"Replace `··············<input·type=\"text\"·required·placeholder=\"Set·initial·password\"·value={newUser.password}·onChange={e·=>·setNewUser({...newUser,·password:·e.target.value})}·className=\"w-full·bg-[#FBF8F8]·border·border-[#B0DCDA]·rounded-md·p-2.5·text-sm·text-gray-800·font-medium·focus:border-[#1B9387]·outline-none·transition\"·/>␍` with `<input⏎················type=\"text\"⏎················required⏎················placeholder=\"Set·initial·password\"⏎················value={newUser.password}⏎················onChange={(e)·=>·setNewUser({·...newUser,·password:·e.target.value·})}⏎················className=\"w-full·bg-[#FBF8F8]·border·border-[#B0DCDA]·rounded-md·p-2.5·text-sm·text-gray-800·font-medium·focus:border-[#1B9387]·outline-none·transition\"`",{"range":"69743","text":"69744"},{"range":"69745","text":"69739"},{"range":"69746","text":"53125"},"Replace `····························<label·className=\"block·text-[10px]·font-extrabold·text-gray-500·uppercase·tracking-wider·mb-1.5\">Default·System·Role</label>␍` with `··············<label·className=\"block·text-[10px]·font-extrabold·text-gray-500·uppercase·tracking-wider·mb-1.5\">⏎················Default·System·Role⏎··············</label>`",{"range":"69747","text":"69748"},"Replace `··············<select·value={newUser.role}·onChange={e·=>·setNewUser({...newUser,·role:·e.target.value})}·className=\"w-full·bg-[#FBF8F8]·border·border-[#B0DCDA]·rounded-md·p-2.5·text-sm·text-gray-800·font-medium·focus:border-[#1B9387]·outline-none·transition·cursor-pointer\">␍` with `<select⏎················value={newUser.role}⏎················onChange={(e)·=>·setNewUser({·...newUser,·role:·e.targ