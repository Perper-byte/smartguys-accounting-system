 className=\"space-y-1 text-xs font-mono text-gray-500 mb-3 border-t border-gray-200 pt-2\">",[26376,26524],"                      <div className=\"flex justify-between\">\n                        <span>Gross:</span> <span>{formatCurrency(tx.gross)}</span>",[26547,26687],"</div>\n                      <div className=\"flex justify-between text-orange-500\">\n                        <span>EWT:</span> <span>- {formatCurrency(tx.tax)}</span>",[26710,26856],"</div>\n                      <div className=\"flex justify-between font-bold text-gray-800\">\n                        <span>Net:</span> <span>{formatCurrency(tx.net)}</span>",[26879,26904],"</div>\n                    </div>",[26905,26906],[26907,26972],"                    <button\n                      onClick={() => {",[26973,27072],"                        const taxRate = Math.round((tx.tax / tx.gross) * 100)",[27073,27192],"                        let fallbackATC = ATC_CODES.find((a) => a.rate === taxRate) || ATC_CODES[3]",[27117,27191],"const fallbackATC = ATC_CODES.find(a => a.rate === taxRate) || ATC_CODES[3];",[27217,27400],"setGenerated2307({\n                          payee: tx.payee,\n                          date: new Date(tx.date),\n                          gross: tx.gross,\n                          tax: tx.tax,\n                          net: tx.net,\n                          atc: fallbackATC,\n                          isReprint: true,\n                          ref: tx.referenceNo\n                        })",[27423,27620],"}}\n                      className=\"w-full py-1.5 bg-white border border-[#B0DCDA] hover:bg-[#E9FAFA] text-[#1B9387] text-[10px] font-extrabold uppercase tracking-widest rounded shadow-sm transition\"",[27641,27687],">\n                      📄 Generate Form 2307",[27708,27738],[27739,27782],[27783,27818],[27819,27850],[27851,27882],[27883,27910],[27911,27934],[27935,27954],[27955,27956],[27957,27996],[27997,28032],[28033,28174],[28175,28301],[28302,28384],[28385,28501]," 