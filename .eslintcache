 => setBookType(type)}",[6100,6361],"                    className={`px-5 py-2 text-xs font-bold rounded-md transition uppercase tracking-wider cursor-pointer ${bookType === type ? 'bg-[#1B9387] text-white shadow-md' : 'text-gray-500 hover:text-[#1B9387] hover:bg-[#E9FAFA]'}`}",[6379,6400]," >\n                    {type === 'SJ'",[6423,6658],"? 'Sales'\n                      : type === 'CRJ'\n                        ? 'Receipts'\n                        : type === 'PJ'\n                          ? 'Purchases'\n                          : type === 'CDJ'\n                            ? 'Disbursements'\n                            : 'General'}\n                  </button>",[6675,6694],"))}\n              </div>",[6709,6988],"<button\n                onClick={handleExportCSV}\n                disabled={data.length === 0}\n                className=\"flex items-center space-x-2 bg-white hover:bg-[#FBF8F8] disabled:opacity-50 text-gray-700 px-4 py-2 rounded-md text-sm font-bold transition border border-[#B0DCDA] cursor-pointer shadow-sm\"",[7003,7105],">\n                <span>📥</span>\n                <span className=\"text-xs uppercase tracking-wider\">Export CSV</span>",[7106,7144],[7145,7176],[7177,7204],[7213,7228],[7229,7230],[7231,7273],"        {/* MAIN LEDGER TABLE */}",[7274,7399],"        <div className=\"bg-white border border-[#B0DCDA] rounded-xl flex-1 flex flex-col overflow-hidden shadow-sm\">",[7400,7446],"          {/* Table Title Bar */}",[7447,7571],"          <div className=\"bg-[#FBF8F8] p-4 border-b border-[#B0DCDA] flex justify-between items-center shrink-0\">",[7572,7699],"            <h3 className=\"text-base font-extrabold text-gray-800 uppercase tracking-widest\">\n              {getBookTitle()}",[7712,7809],"</h3>\n            <span className=\"text-xs font-bold text-gray-500\">{data.length} entries found</span>",[7810,7837],[7838,7839],[7840,7882],"          {/* Table Content */}",[7893,7951],"<div className=\"flex-1 overflow-auto relative\">",