'T')[0];␍` with `return·new·Date(date.getTime()·-·date.getTimezoneOffset()·*·60000).toISOString().split('T')[0]`",{"range":"53618","text":"53619"},{"range":"53620","text":"45467"},{"range":"53621","text":"45467"},{"range":"53622","text":"45467"},"Replace `····const·today·=·new·Date();␍` with `··const·today·=·new·Date()`",{"range":"53623","text":"53624"},"Replace `····const·firstDay·=·new·Date(today.getFullYear(),·today.getMonth(),·1);␍` with `··const·firstDay·=·new·Date(today.getFullYear(),·today.getMonth(),·1)`",{"range":"53625","text":"53626"},{"range":"53627","text":"45467"},"Replace `··const·[startDate,·setStartDate]·=·useState(getLocalDateString(firstDay));␍` with `const·[startDate,·setStartDate]·=·useState(getLocalDateString(firstDay))`",{"range":"53628","text":"53629"},"Replace `··const·[endDate,·setEndDate]·=·useState(getLocalDateString(today));␍` with `const·[endDate,·setEndDate]·=·useState(getLocalDateString(today))`",{"range":"53630","text":"53631"},{"range":"53632","text":"45467"},"Replace `····//·Defaulting·to·the·Sales·Journal␍` with `··//·Defaulting·to·the·Sales·Journal`",{"range":"53633","text":"53634"},"Replace `····const·[bookType,·setBookType]·=·useState('SJ');␍` with `··const·[bookType,·setBookType]·=·useState('SJ')`",{"range":"53635","text":"53636"},{"range":"53637","text":"45467"},"Replace `··const·[data,·setData]·=·useState<any[]>([]);␍` with `const·[data,·setData]·=·useState<any[]>([])`",{"range":"53638","text":"53639"},["53640","53641"],{"range":"53642","text":"51348"},{"range":"53643","text":"45467"},"Replace `··const·fetchBooks·=·async·()·=>·{␍` with `const·fetchBooks·=·async·()·=>·{`",{"range":"53644","text":"53645"},{"range":"53646","text":"51771"},{"range":"53647","text":"47865"},{"range":"53648","text":"51593"},["53649","53650"],["53651","53652"],"Replace `············const·result·=·await·api.getBooksOfAccounts(bookType,·startDate,·endDate);␍` with `······const·result·=·await·api.getBooksOfAccounts(bookType,·startDate,·endDate)`",{"range":"53653","text":"53654"},"Replace `············setData(result·||·[]);␍` with `······setData(result·||·[])`",{"range":"53655","text":"53656"},{"range":"53657","text":"47900"},"Replace `············console.error(\"Failed·to·fetch·books\",·error);␍` with `······console.error('Failed·to·fetch·books',·error)`",{"range":"53658","text":"53659"},{"range":"53660","text":"51408"},{"range":"53661","text":"51410"},{"range":"53662","text":"47904"},{"range":"53663","text":"45556"},{"range":"53664","text":"45467"},{"range":"53665","text":"51552"},"Replace `········fetchBooks();␍` with `····fetchBooks()`",{"range":"53666","text":"53667"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\MY PC\\Desktop\\lol\\smartguys-accounting-system\\src\\renderer\\src\\components\\BooksOfAccountsView.tsx:36:9\n  34 |\n  35 |     useEffect(() => {\n> 36 |         fetchBooks();\n     |         ^^^^^^^^^^ Avoid calling setState() directly within an effect\n  37 |     }, [bookType]);\n  38 |\n  39 |     // UX: Return null/dash for zeros to keep the ledger clean","Replace `··},·[bookType]);␍` with `},·[bookType])`",{"range":"53668","text":"53669"},"React Hook useEffect has a missing dependency: 'fetchBooks'. Either include it or remove the dependency array.",["53670"],{"range":"53671","text":"45467"},"Replace `····//·UX:·Return·null/dash·for·zeros·t