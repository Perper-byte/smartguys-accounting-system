th `··const·[activeTab,·setActiveTab]·=·useState<'ALL'·|·'MANUAL'·|·'SYSTEM'>('ALL')`",{"range":"61945","text":"61946"},{"range":"61947","text":"45467"},"Replace `····//·🔥·NEW:·Sub-Tabs·for·Status·(Active,·Drafts,·Voided)␍` with `··//·🔥·NEW:·Sub-Tabs·for·Status·(Active,·Drafts,·Voided)`",{"range":"61948","text":"61949"},"Replace `····const·[statusTab,·setStatusTab]·=·useState<'ACTIVE'·|·'DRAFTS'·|·'VOIDED'>('ACTIVE');␍` with `··const·[statusTab,·setStatusTab]·=·useState<'ACTIVE'·|·'DRAFTS'·|·'VOIDED'>('ACTIVE')`",{"range":"61950","text":"61951"},{"range":"61952","text":"45467"},{"range":"61953","text":"55350"},{"range":"61954","text":"45467"},"Replace `····//·View·States␍` with `··//·View·States`",{"range":"61955","text":"61956"},"Replace `····const·[isCreatingNew,·setIsCreatingNew]·=·useState(false);␍` with `··const·[isCreatingNew,·setIsCreatingNew]·=·useState(false)`",{"range":"61957","text":"61958"},"Replace `····const·[selectedEntry,·setSelectedEntry]·=·useState<any·|·null>(null);␍` with `··const·[selectedEntry,·setSelectedEntry]·=·useState<any·|·null>(null)`",{"range":"61959","text":"61960"},["61961","61962"],{"range":"61963","text":"45467"},"Replace `····const·fetchEntries·=·async·()·=>·{␍` with `··const·fetchEntries·=·async·()·=>·{`",{"range":"61964","text":"61965"},{"range":"61966","text":"51771"},{"range":"61967","text":"47865"},{"range":"61968","text":"51593"},["61969","61970"],["61971","61972"],"Replace `············const·data·=·await·api.getAllJournalEntries();␍` with `······const·data·=·await·api.getAllJournalEntries()`",{"range":"61973","text":"61974"},"Replace `············setEntries(Array.isArray(data)·?·data·:·[]);␍` with `······setEntries(Array.isArray(data)·?·data·:·[])`",{"range":"61975","text":"61976"},{"range":"61977","text":"47900"},"Replace `············console.error(\"Failed·to·fetch·journals:\",·error);␍` with `······console.error('Failed·to·fetch·journals:',·error)`",{"range":"61978","text":"61979"},{"range":"61980","text":"51408"},{"range":"61981","text":"51410"},{"range":"61982","text":"47904"},{"range":"61983","text":"45556"},{"range":"61984","text":"45467"},{"range":"61985","text":"51552"},"Replace `········if·(!isCreatingNew)·{␍` with `····if·(!isCreatingNew)·{`",{"range":"61986","text":"61987"},"Replace `······fetchEntries();␍` with `fetchEntries()`",{"range":"61988","text":"61989"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\MY PC\\Desktop\\lol\\smartguys-accounting-system\\src\\renderer\\src\\components\\JournalManagementView.tsx:38:13\n  36 |     useEffect(() => {\n  37 |         if (!isCreatingNew) {\n> 38 |             fetchEntries();\n     |             ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  39 |         }\n  40 |     }, [isCreatingNew]);\n  41 |",{"range":"61990","text":"47904"},"Replace `··},·[isCreatingNew]);␍` with `},·[isCreatingNew])`",{"range":"61991","text":"61992"},{"range":"61993","text":"45467"},{"range":"61994","text":"53675"},"Replace `········return·amount.toLocaleString('en-US',·{·minimumFractionDigits:·2,·maximumFractionDigits:·2·});␍` with `····return·amount.toLocaleString('en-US',·{·minimumFractionDigits:·2,·maximumFractionDigits:·2·})`",{"range":"61995","text":"61996"},{"range":"61997","text":"45556"},{"range":"61998","text":"45467"},"Replace `····//·Helper·to·render·the·correct·badge·colors·based·on·status␍` with `··//·Helper·to·render·the·correct·badge·colors·based·on·status`",{"range":"61999","text":"62000"},{"range":"62001","text":"60833"},"Replace `········if·(status·===·'ACTIVE')·{␍` with `····if·(status·===·'ACTIVE')·{`",{"range":"62002","text":"62003"},"Replace `············return·<span·className=\"px-3·py-1·rounded·text-[10px]·font-extrabold·uppercase·tracking-widest·border·bg-emerald-50·text-emerald-600·border-emerald-200\">Recorded</span>;␍` with `······return·(⏎········<span·className=\"px-3·py-1·rounded·text-[10px]·font-extrabold·uppercase·tracking-widest·border·bg-emerald-50·text-emerald-600·border-emerald-200\">⏎··········Recorded⏎········</span>`",{"range":"62004","text":"62005"},"Replace `········}␍` with `······)`",{"range":"62006","text":"62007"},"Replace `····if·(status·===·'VOIDED')·{␍` with `}⏎····if·(status·===·'VOIDED')·{`",{"range":"62008","text":"62009"},"Replace `············return·<span·className=\"px-3·py-1·rounded·text-[10px]·font-extrabold·uppercase·tracking-widest·border·bg-red-50·text-red-600·border-red-200\">Voided</span>;␍` with `······return·(⏎········<span·className=\"px-3·py-1·rounded·text-[10px]·font-extrabold·uppercase·tracking-widest·border·bg-red-50·text-red-600·border-red-200\">⏎··········Voided⏎········</span>`",{"range":"62010","text":"62011"},"Replace `··}␍` with `)`",{"range":"62012","text":"46023"},"Replace `····//·Covers·DRAFT·or·PENDING_VOID␍` with `}⏎····//·Covers·DRAFT·or·PENDING_VOID`",{"range":"62013","text":"62014"},"Replace `········return·<span·className=\"px-3·py-1·rounded·text-[10px]·font-extrabold·uppercase·tracking-widest·border·bg-amber-50·text-amber-600·border-amber-200\">{status.replace('_',·'·')}</span>;␍` with `····return·(⏎······<span·className=\"px-3·py-1·rounded·text-[10px]·font-extrabold·uppercase·tracking-widest·border·bg-amber-50·text-amber-600·border-amber-200\">⏎········{status.replace('_',·'·')}⏎······</span>`",{"range":"62015","text":"62016"},{"range":"62017","text":"60841"}