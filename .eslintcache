        setPatientId(p.id)\n                                setIsPatientDropdownOpen(false)\n                                setPatientSearchQuery('')\n                              }}\n                              className=\"px-5 py-4 text-sm text-gray-800 font-bold hover:bg-[#E9FAFA] hover:text-[#1B9387] cursor-pointer transition border-b border-gray-50 last:border-0\"\n                            >\n                              {p.name}\n                            </li>",[25120,25121],[25151,25152],[25181,25182],[25205,25206],[25231,25232],[25255,25256],[25257,25258],[25355,25356],[25379,25526],"\n                    className=\"px-5 py-4 flex items-center gap-4 cursor-pointer hover:bg-gray-100 transition-colors rounded-xl\"\n                    onClick={() => setIsSCPWD(!isSCPWD)}\n                  >",[25553,25680],"\n                      type=\"checkbox\"\n                      checked={isSCPWD}\n                      readOnly\n                      className=\"w-5 h-5 text-[#1B9387] rounded border-gray-300 focus:ring-[#1B9387]\"\n                    />",[25742,25743],[25808,25809],[25884,25915],"\n                        Apply SC / PWD Discount\n                      </span>",[25942,25943],[25968,25969],[26001,26002],[26132,26133],[26245,26246],[26330,26331],[26426,26427],[26456,26457],[26594,26595],[26647,26648],[26737,26738],[26767,26768],[26868,26869],[26916,26917],[27016,27017],[27046,27047],[27128,27129],[27184,27185],[27304,27325],"\n                            Discount Type\n                          </span>",[27359,27612],"\n                            className=\"w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-sm font-semibold text-gray-700 focus:border-[#1B9387] focus:ring-1 focus:ring-[#1B9387] outline-none\"\n                            value={discountType}\n                            onChange={(e) => setDiscountType(e.target.value)}\n                          >",[27695,27696],[27757,27758],[27794,27795],[27828,27829],[27882,27883],[28002,28019],"\n                            ID Number\n                          </span>",[28052,28349],"\n                            type=\"text\"\n                            required\n                            placeholder=\"Required for BIR\"\n                            className=\"w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-sm font-semibold text-gray-700 focus:border-[#1B9387] focus:ring-1 focus:ring-[#1B9387] outline-none\"\n                            value={scPwdId}\n                            onChange={(e) => setScPwdId(e.target.value)}\n                          />",[28382,28383],[28412,28413],[28440,28441],[28462,28463],[28486,28487],[28488,28489],[28565,28566],[28588,28589],[28695,28718],"\n                    Invoice Number\n                  </label>",[28780,28781],[28782,28966],"                    <span className=\"bg-gray-100 border border-gray-300 border-r-0 rounded-l-xl px-4 py-3.5 text-sm font-bold text-gray-500 select-none flex flex-col justify-center\">",[28989,28997],"INV-",[28998,29027],[29028,29057],[29080,29095],"type=\"text\"",[29096,29130],"                      readOnly",[29153,29180],"value={invoiceSequence}",[29181,29378],"                      className=\"w-full px-4 py-3.5 bg-gray-50 border border-gray-300 rounded-r-xl text-base font-mono font-bold text-gray-500 focus:outline-none cursor-not-allowed select-none\"",[29379,29403],[29428,29429],[29452,29455],[29476,29477],[29496,29497],[29514,29515],[29516,29517],[29589,29590],[29719,29720],[29834,29835],[29893,29894],[30027,30035],"\n                    2\n                  </div>",[30129,30155],"\n                    Services & Medicines\n                  </h2>",[30178,30179],[30203,30473],"\n                  type=\"button\"\n                  onClick={handleAddItem}\n                  className=\"flex items-center gap-2 px-4 py-2 bg-white border border-[#B0DCDA] text-gray-600 rounded-lg text-xs font-bold uppercase tracking-wider hover:bg-[#E9FAFA] hover:text-[#1B9387] transition-colors shadow-sm cursor-pointer\"\n                >",[30529,30530],[30556,30557],[30578,30579],[30632,30633],[30716,30717],[30792,30793],[30818,30819],[30959,30973],"\n                        Category\n                      </th>",[31108,31125],"\n                        Description\n                      </th>",[31272,31281],"\n                        VAT\n                      </th>",[31454,31476],"\n                        HMO / Corp Cover\n                      </th>",[31623,31632],"\n                        Qty\n                      </th>",[31778,31794],"\n                        Unit Price\n                      </th>",[31940,31951],"\n                        Total\n                      </th>",[32035,32036],[32062,32063],[32090,32091],[32154,32155],[32198,32199],[32200,32269],"                      const rowTotal = item.quantity * item.price",[32270,32303],"                      return (",[32326,32398],"  <tr key={item.id} className=\"hover:bg-gray-50 transition-colors group\">",[32399,32455],"                          <td className=\"px-4 py-3 w-48\">",[32456,32716],"                            <select\n                              className=\"w-full bg-transparent text-sm font-bold text-[#1B9387] focus:outline-none cursor-pointer text-ellipsis overflow-hidden\"\n                              value={item.accountCode}\n                              onChange={(e) => updateItem(item.id, 'accountCode', e.target.value)}\n                            >",[32745,32877],"  {revenueAccounts.map((acc) => (\n                                <option\n                                  key={acc.code}\n                                  value={acc.code}\n                                  className=\"text-gray-800 font-medium\"\n                                >\n                                  {acc.name}\n                                </option>\n                              ))}",[32878,32914],"                            </select>",[32915,32945],[32946,33045],"                          <td className=\"px-4 py-3 min-w-[200px] relative border-l border-gray-100\">",[33046,33079],"                            <input",[33080,33204],"                              type=\"text\"\n                              required\n                              placeholder={\n                                item.accountCode === '4020' ? 'Search test...' : 'Item name'\n                              }",[33205,33459],"                              className={`w-full bg-transparent text-sm font-medium focus:outline-none focus:ring-2 focus:ring-[#1B9387]/30 rounded-lg px-3 py-2 ${item.accountCode === '4020' ? 'text-[#1B9387] placeholder-[#1B9387]/50' : 'text-gray-900'}`}",[33460,33513],"                              value={item.description}",[33514,33695],"                              onChange={(e) => {\n                                updateItem(item.id, 'description', e.target.value)\n                                if (item.accountCode === '4020') {\n                                  openLabDropdown(item.id, e.currentTarget)\n                                }\n                              }}",[33696,33824],"                              onFocus={(e) => {\n                                if (item.accountCode === '4020') {\n                                  openLabDropdown(item.id, e.currentTarget)\n                                }\n                              }}",[33825,33951],"                              onBlur={() => {\n                                setTimeout(() => {\n                                  setActiveLabRow(null)\n                                  setLabDropdownPosition(null)\n                                }, 200)\n                              }}",[33952,33981],"                            />",[33982,34105],"                            {activeLabRow === item.id &&\n                              item.accountCode === '4020' &&\n                              labDropdownPosition &&\n                              createPortal(",[34106,34368],"                                <div\n                                  className=\"fixed z-[9999] bg-white border border-[#1B9387] rounded-xl shadow-2xl overflow-hidden\"\n                                  style={{\n                                    top: `${labDropdownPosition.top}px`,\n                                    left: `${labDropdownPosition.left}px`,\n                                    width: `${labDropdownPosition.width}px`\n                                  }}\n                                >",[34369,34555],"                                  <div className=\"px-4 py-3 bg-[#E9FAFA] border-b border-[#B0DCDA] text-xs font-extrabold text-[#1B9387] uppercase tracking-wider\">\n                                    Clinic Master List\n                                  </div>",[34556,34630],"                                  <ul className=\"max-h-72 overflow-y-auto\">",[34631,34695],"                                    {labTests\n                                      .filter((test) => {",[34696,35022],"                                        const query = String(item.description || '').toLowerCase()\n                                        return (\n                                          String(test.name || '')\n                                            .toLowerCase()\n                                            .includes(query) ||\n                                          String(test.category || '')\n                                            .toLowerCase()\n                                            .includes(query)\n                                        )\n                                      })\n                                      .map((test, index) => (",[35023,35674],"                                        <li\n                                          key={test.id || index}\n                                          onMouseDown={(e) => {\n                                            e.preventDefault()\n                                            const newItems = [...items]\n                                            const targetIndex = newItems.findIndex(\n                                              (line) => line.id === item.id\n                                            )\n                                            if (targetIndex === -1) return\n                                            newItems[targetIndex] = {\n                                              ...newItems[targetIndex],\n                                              description: test.name,\n                                              price:\n                                                Number(test.price) > 0\n                                                  ? Number(test.price)\n                                                  : newItems[targetIndex].price\n                                            }\n                                            setItems(newItems)\n                                            setActiveLabRow(null)\n                                            setLabDropdownPosition(null)\n                                          }}\n                                          className=\"px-4 py-3 text-sm text-gray-800 hover:bg-[#E9FAFA] cursor-pointer transition border-b border-gray-100 last:border-b-0 flex justify-between items-center gap-4 group\"\n                                        >",[35675,35951],"                                          <div className=\"min-w-0\">\n                                            <span className=\"font-bold text-sm block truncate group-hover:text-[#1B9387]\">\n                                              {test.name}\n                                            </span>\n                                            <span className=\"block text-[10px] text-gray-400 uppercase font-bold mt-0.5 truncate\">\n                                              {test.category}\n                                            </span>\n                                          </div>",[35992,36208],"  {Number(test.price) > 0 && (\n                                            <span className=\"font-mono text-[#1B9387] font-bold text-sm whitespace-nowrap\">\n                                              ₱\n                                              {Number(test.price).toLocaleString('en-US', {\n                                                minimumFractionDigits: 2,\n                                                maximumFractionDigits: 2\n                                              })}\n                                            </span>\n                                          )}",[36209,36253],"                                        </li>",[36254,36294],"                                      ))}",[36295,36333],"                                  </ul>",[36334,36386],"                                </div>,\n                                document.body",[36387,36418],[36419,36449],[36450,36538],"                          <td className=\"px-2 py-3 text-center border-l border-gray-100\">",[36565,36863],"  <input\n                              type=\"checkbox\"\n                              className=\"w-5 h-5 text-[#1B9387] bg-white border-gray-300 rounded cursor-pointer focus:ring-[#1B9387]\"\n                              checked={item.isVatable}\n                              disabled={isSCPWD}\n                              onChange={(e) => updateItem(item.id, 'isVatable', e.target.checked)}\n                              title=\"Subject to VAT?\"\n                            />",[36888,36889],"  </td>",[36890,37011],"\n                          <td className=\"px-3 py-3 bg-indigo-50/30 border-l border-indigo-100 align-middle min-w-[140px]\">",[37012,37062],"                            {!item.isHmoCovered ? (",[37150,37151],[37184,37194],[37229,37250],"type=\"checkbox\"",[37251,37398],"                                  className=\"w-5 h-5 text-indigo-600 bg-white border-indigo-300 rounded cursor-pointer focus:ring-indigo-500\"",[37399,37454],"                                  checked={false}",[37455,37551],"                                  onChange={() => toggleHmoCover(item.id, true, rowTotal)}",[37552,37635],"                                  title=\"Cover with HMO or Corporate Account\"",[37668,37673],[37710,37711],[37738,37744],"  ) : (",[37827,37828],[37861,37927],"<div className=\"flex items-center gap-2 w-full justify-center\">",[37928,37974],"                                  <input",[37975,38034],"                                    type=\"checkbox\"",[38035,38195],"                                    className=\"w-5 h-5 text-indigo-600 bg-white border-indigo-300 rounded cursor-pointer focus:ring-indigo-500 shrink-0\"",[38196,38254],"                                    checked={true}",[38255,38356],"                                    onChange={() => toggleHmoCover(item.id, false, rowTotal)}",[38357,38398],"                                  />",[38399,38496],"                                  <div className=\"relative flex items-center w-24 shrink-0\">",[38497,38626],"                                    <span className=\"absolute left-2 text-indigo-400 font-mono text-xs font-bold\">",[38661,38759],"    ₱\n                                    </span>\n                                    <input\n                                      type=\"number\"\n                                      min=\"0\"\n                                      step=\"0.01\"",[38760,39003],"                                      className=\"w-full text-right bg-white border border-indigo-200 text-sm font-bold font-mono text-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-300 rounded py-1.5 pr-2 pl-5 shadow-sm\"",[39004,39105],"                                      value={item.hmoCoverage === 0 ? '' : item.hmoCoverage}",[39106,39239],"                                      onChange={(e) =>\n                                        updateItem(\n                                          item.id,\n                                          'hmoCoverage',\n                                          parseFloat(e.target.value) || ''\n                                        )",[39240,39305],"                                      }\n                                      placeholder=\"0.00\"",[39306,39351],"                                    />",[39352,39397],"                                  </div>",[39398,39439],[39440,39518],"                                {Number(item.hmoCoverage) !== rowTotal && (",[39519,39566],"                                  <button",[39567,39624],"                                    type=\"button\"",[39625,39729],"                                    onClick={() => updateItem(item.id, 'hmoCoverage', rowTotal)}",[39730,39949],"                                    className=\"text-[9px] font-extrabold text-indigo-600 bg-indigo-100 hover:bg-indigo-200 px-2 py-0.5 rounded uppercase tracking-widest transition-colors shadow-sm cursor-pointer\"",[39950,39990],[39991,40110],"                                    Set Full (₱\n                                    {rowTotal.toLocaleString('en-US', { minimumFractionDigits: 2 })}",[40119,40159],"                            )\n                                  </button>",[40192,40197],[40234,40235],[40262,40265],"  )}",[40266,40296],[40297,40298],[40299,40380],"                          <td className=\"px-2 py-3 w-28 border-l border-gray-100\">",[40381,40637],"                            <div className=\"flex items-center justify-between border border-gray-300 rounded-lg overflow-hidden bg-white hover:border-[#1B9387] transition-colors focus-within:ring-2 focus-within:ring-[#E9FAFA] focus-within:border-[#1B9387]\">",[40638,40887],"                              <button\n                                type=\"button\"\n                                onClick={() => updateItemQty(item.id, -1)}\n                                className=\"px-2 py-1.5 bg-gray-50 hover:bg-gray-200 text-gray-600 font-bold border-r border-gray-200 cursor-pointer\"\n                              >\n                                <Minus className=\"w-3 h-3\" />\n                              </button>",[40888,41179],"                              <input\n                                type=\"number\"\n                                min=\"1\"\n                                required\n                                className=\"w-10 text-center bg-transparent text-sm font-bold text-gray-900 focus:outline-none appearance-none\"\n                                value={item.quantity || ''}\n                                onChange={(e) =>\n                                  updateItem(item.id, 'quantity', parseFloat(e.target.value) || 0)\n                                }\n                              />",[41180,41427],"                              <button\n                                type=\"button\"\n                                onClick={() => updateItemQty(item.id, 1)}\n                                className=\"px-2 py-1.5 bg-gray-50 hover:bg-gray-200 text-gray-600 font-bold border-l border-gray-200 cursor-pointer\"\n                              >\n                                <Plus className=\"w-3 h-3\" />\n                              </button>",[41454,41461],[41462,41492],[41493,41574],"                          <td className=\"px-4 py-3 w-32 border-l border-gray-100\">",[41601,41966],"  <input\n                              type=\"number\"\n                              min=\"0\"\n                              step=\"0.01\"\n                              required\n                              className=\"w-full text-right bg-transparent text-base font-bold font-mono text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#1B9387]/30 rounded-lg px-2 py-1.5\"\n                              value={item.price === 0 ? '' : item.price}\n                              onChange={(e) =>\n                                updateItem(item.id, 'price', parseFloat(e.target.value) || 0)\n                              }\n                            />",[41967,41997],[42022,42195],"  <td\n                            className={`px-4 py-3 w-32 text-right text-sm font-bold font-mono border-l border-gray-100 bg-[#FBF8F8]/50 ${item.isHmoCovered ? 'text-indigo-600' : 'text-gray-900'}`}\n                          >",[42196,42288],"                            ₱{rowTotal.toLocaleString('en-US', { minimumFractionDigits: 2 })}",[42289,42319],[42344,42413],"  <td className=\"px-2 py-3 text-center w-12 border-l border-gray-100\">",[42414,42790],"                            <button\n                              type=\"button\"\n                              onClick={() => handleRemoveItem(item.id)}\n                              className=\"p-1.5 bg-rose-50 text-rose-500 border border-rose-100 hover:bg-rose-500 hover:text-white hover:border-rose-500 rounded-lg transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-rose-200 cursor-pointer\"\n                              title=\"Remove Item\"\n                            >\n                              <Trash2 className=\"w-4 h-4\" />\n                            </button>",[42791,42821],[42844,42850],"  </tr>",[42851,42876],"                      )\n                    })}",[42903,42904],[42929,42930],[42951,42952],[42971,42972],[42973,42974],[43089,43090],[43176,43177],[43259,43278],[43343,43344],[43439,43440],[43503,43504],[43600,43619],"\n                      VAT Breakdown\n                    </h3>",[43644,43645],[43701,43702],[43787,43954],"\n                      <span>Vatable Sales</span>\n                      <span className=\"font-mono tabular-nums text-right w-28\">\n                        ₱ {vatableSales.toLocaleString('en-US', { minimumFractionDigits: 2 })}\n                      </span>\n                    </div>",[44037,44219],"\n                      <span>VAT Amount (12%)</span>\n                      <span className=\"font-mono tabular-nums text-right w-28 text-[#1B9387]\">\n                        ₱ {vatAmount.toLocaleString('en-US', { minimumFractionDigits: 2 })}\n                      </span>\n                    </div>",[44335,44507],"\n                      <span>VAT Exempt Sales</span>\n                      <span className=\"font-mono tabular-nums text-right w-28\">\n                        ₱ {vatExemptSales.toLocaleString('en-US', { minimumFractionDigits: 2 })}\n                      </span>\n                    </div>",[44592,44698],"\n                      <span>Zero Rated Sales</span>\n                      <span className=\"font-mono tabular-nums text-right w-28\">₱ 0.00</span>",[44699,44724],[44743,44744],[44786,44787],[44948,44949],[44950,45006],"                      <div className=\"relative z-50\">",[45007,45158],"                        <label className=\"block text-xs font-bold text-indigo-500 uppercase tracking-wider mb-2\">\n                          Billed To (A/R Guarantor)\n                        </label>",[45159,45586],"                        <button\n                          type=\"button\"\n                          onClick={() => {\n                            setIsPayeeDropdownOpen(!isPayeeDropdownOpen)\n                            if (isPayeeDropdownOpen) setPayeeSearchQuery('')\n                          }}\n                          className={`w-full bg-white border rounded-lg px-4 py-3 text-sm transition cursor-pointer flex justify-between items-center shadow-sm text-left ${isPayeeDropdownOpen ? 'border-indigo-500 ring-2 ring-indigo-100' : 'border-indigo-200 hover:border-indigo-300'}`}",[45606,45797],"     >\n                          <span\n                            className={\n                              payeeId\n                                ? 'text-indigo-900 font-bold truncate'\n                                : 'text-indigo-400 font-medium truncate'\n                            }\n                          >\n                       