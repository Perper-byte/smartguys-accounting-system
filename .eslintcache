"",[11611,11629]," >\n                Try again",[11644,11657],"</button>\n            </div>",[11668,11677],"</div>\n        )}",[11678,11679],[11680,11765],"        {/* ============================================================ */}",[11766,11815],"        {/* 1. FORM 2550Q (VAT) VIEW */}",[11816,11901],[11902,11964],"        {!loading && taxData && view === '2550Q' && (",[11965,12074],"          <div className=\"space-y-6 animate-in fade-in duration-300 flex-1 min-h-0 flex flex-col\">",[12075,12220],"            <div className=\"bg-white border border-gray-200 rounded-xl p-6 shadow-sm print:border-none print:shadow-none print:p-0\">",[12221,12381],"              <h3 className=\"text-lg font-extrabold text-gray-800 mb-4 border-b border-gray-100 pb-3\">\n                Part IV - Details of VAT Computation",[12396,12477],"</h3>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8\">",[12478,12546],"                <div className=\"space-y-3 text-sm\">",[12547,12701],"                  <h4 className=\"text-[10px] font-extrabold uppercase text-gray-400 tracking-widest mb-3\">\n                    Total Sales & Output Tax",[12720,13024],"</h4>\n                  <div className=\"flex justify-between items-center\">\n                    <span className=\"text-gray-600 font-medium\">Item 31A: Vatable Sales</span>\n                    <span className=\"font-mono font-bold text-gray-800 tabular-nums\">\n                      {formatCurrency(taxData.vatableSales) || (\n                        <span className=\"text-gray-300\">-</span>\n                      )}\n                    </span>",[13043,13414],"</div>\n                  <div className=\"flex justify-between items-center bg-[#E9FAFA]/50 p-2.5 rounded-lg border border-[#B0DCDA]\">\n                    <span className=\"text-[#1B9387] font-extrabold\">\n                      Item 31B: Output Tax (12%)\n                    </span>\n                    <span className=\"font-mono text-[#1B9387] font-black tabular-nums\">\n                      {formatCurrency(taxData.outputVat) || (\n                        <span className=\"text-[#1B9387]/30\">-</span>\n                      )}\n                    </span>",[13433,13510],"</div>\n                  <div className=\"pt-3 mt-3 border-t border-gray-100\"></div>",[13511,13952],"                  <div className=\"flex justify-between items-start\">\n                    <span className=\"text-gray-600 font-medium\">\n                      Item 33: VAT-Exempt Sales <br />\n                      <span className=\"text-[10px] text-gray-400 font-normal uppercase tracking-wider\">\n                        (Consults, Labs, SC/PWD)\n                      </span>\n                    </span>\n                    <span className=\"font-mono font-bold text-gray-800 tabular-nums\">\n                      {formatCurrency(taxData.exemptSales) || (\n                        <span className=\"text-gray-300\">-</span>\n                      )}",[13973,13994],"</span>\n                  </div>",[14011,14063],"</div>\n\n                <div className=\"space-y-3 text-sm\">",[14064,14213],"                  <h4 className=\"text-[10px] font-extrabold uppercase text-gray-400 tracking-widest mb-3\">\n                    Allowable Input Tax",[14232,14545],"</h4>\n                  <div className=\"flex justify-between items-center\">\n                    <span className=\"text-gray-600 font-medium\">Item 44A: Domestic Purchases</span>\n                    <span className=\"font-mono font-bold text-gray-800 tabular-nums\">\n                      {formatCurrency(taxData.vatablePurchases) || (\n                        <span className=\"text-gray-300\">-</span>\n                      )}\n                    </span>",[14564,14934],"</div>\n                  <div className=\"flex justify-between items-center bg-orange-50/50 p-2.5 rounded-lg border border-orange-200\">\n                    <span className=\"text-orange-600 font-extrabold\">\n                      Item 44B: Input Tax (12%)\n                    </span>\n                    <span className=\"font-mono text-orange-600 font-black tabular-nums\">\n                      {formatCurrency(taxData.inputVat) || (\n                        <span className=\"text-orange-300\">-</span>",[14957,14974],")}\n                    </span>",[14975,15012],"                  </div>\n                </div>",[15027,15094],"</div>\n\n              <div className=\"mt-6 pt-6 border-t border-gray-100\">",[15095,15243],"                <h4 className=\"text-[10px] font-extrabold uppercase text-gray-400 tracking-widest mb-3\">\n                  Tax Credits & Payments",[15260,15402],"</h4>\n                <div className=\"flex justify-between items-center bg-orange-50/50 p-2.5 rounded-lg border border-orange-200 w-full md:w-1/2\">",[15403,15659],"                  <span className=\"text-orange-600 font-extrabold leading-tight\">\n                    Item 16: Creditable VAT Withheld <br />\n                    <span className=\"text-[9px] font-bold text-orange-400 uppercase tracking-wider\">\n                      (From HMOs - Form 2307)\n                    </span>",[15678,15865],"</span>\n                  <span className=\"font-mono text-orange-600 font-black tabular-nums\">\n                    {formatCurrency(taxData.creditableVatWithheld) || (\n                      <span className=\"text-orange-300\">-</span>",[15886,15941],")}\n                  </span>\n                </div>",[15956,15973],"</div>\n            </div>",[15974,15975],[15988,16239],"<div\n              className={`border rounded-xl p-6 flex justify-between items-center shadow-sm print:border-none print:shadow-none print:p-0 print:mt-8 ${taxData.netVatPayable <= 0 ? 'bg-emerald-50 border-emerald-200' : 'bg-red-50 border-red-200'}`}",[16240,16274],"            >\n              <div>",[16291,16516],"<h3\n                  className={`text-lg font-black uppercase tracking-wider ${taxData.netVatPayable <= 0 ? 'text-emerald-700' : 'text-red-700'}`}\n                >\n                  Item 15: Net VAT {taxData.netVatPayable <= 0 ? 'Overpayment' : 'Payable'}\n                </h3>",[16533,16774],"<p\n                  className={`text-xs mt-1 font-bold ${taxData.netVatPayable <= 0 ? 'text-emerald-600/70' : 'text-red-600/70'}`}\n                >\n                  Output VAT less (Input VAT + CWT Credits) for{' '}\n                  {quarter === 0 ? `the Year ${year}` : `Q${quarter} ${year}`}",[16791,16810],"</p>\n              </div>",[16825,16971],"<span\n                className={`text-3xl font-black font-mono tabular-nums ${taxData.netVatPayable <= 0 ? 'text-emerald-600' : 'text-red-600'}`}",[16986,17090],">\n                {formatCurrency(taxData.netVatPayable) || (\n                  <span className=\"opacity-30\">₱ 0.00</span>",[17107,17127],")}\n              </span>",[17128,17159],[17160,17187],[17188,17207],[17208,17209],[17210,17295],[17296,17359],"        {/* 🔥 NEW: FORM 0619-E VIEW (MONTHLY EWT) */}",[17360,17445],[17446,17508],"        {!loading && taxData && view === '0619E' && (",[17509,17618],[17619,17727],"            <div className=\"bg-white border border-gray-200 rounded-xl p-6 shadow-sm shrink-0\">",[17728,17849],"              <h3 className=\"text-lg font-extrabold text-gray-800 mb-1\">\n                Form 0619-E Summary (Monthly)",[17864,18027],"</h3>\n              <p className=\"text-sm text-gray-500 font-medium mb-6\">\n                Monthly remittance of creditable income taxes withheld for {getMonthName(month)}{' '}\n                {year}.",[18042,18163],"</p>\n\n              <div className=\"bg-[#E9FAFA]/50 border border-[#B0DCDA] rounded-xl p-6 flex justify-between items-center\">",[18164,18202],"                <div>",[18203,18340],"                  <h3 className=\"text-lg font-black text-[#1B9387] uppercase tracking-wider\">\n                    Total Taxes Withheld",[18359,18512],"</h3>\n                  <p className=\"text-xs text-[#1B9387]/70 font-bold mt-1 uppercase tracking-widest\">\n                    Amount to remit to BIR for {getMonthName(month)}",[18529,18552],"  </p>\n                </div>",[18553,18662],"                <span className=\"text-3xl font-black font-mono text-[#1B9387] tabular-nums\">",[18663,18783],"                  {formatCurrency(taxData.ewtWithheld) || (\n                    <span className=\"opacity-30\">₱ 0.00</span>",[18802,18824],")}\n                </span>",[18825,18860],"              </div>",[18861,18892],[18893,18894],[18895,19027],"            <div className=\"bg-white border border-gray-200 rounded-xl overflow-hidden flex-1 flex flex-col shadow-sm\">",[19028,19159],"              <div className=\"bg-[#FBF8F8] border-b border-gray-200 p-4 flex justify-between items-center shrink-0\">",[19160,19198],[19199,19343],"                  <h3 className=\"text-sm font-extrabold text-gray-800 uppercase tracking-wide\">\n                    Withholding Tax Breakdown",[19362,19480],"</h3>\n                  <p className=\"text-xs text-gray-500 font-medium mt-1\">\n                    Transactions subjected to EWT this month.",[19499,19520],"</p>\n                </div>",[19521,19556],[19557,19626],"              <div className=\"flex-1 overflow-y-auto\">",[19627,19694],"                <table className=\"w-full text-sm\">",[19695,19902],"                  <thead className=\"text-gray-500 text-[10px] font-extrabold uppercase tracking-wider bg-white border-b-2 border-gray-100 sticky top-0 shadow-[0_2px_5px_rgba(0,0,0,0.02)]\">",[19903,19948],"                    <tr>",[19971,20038],"<th className=\"p-4 pl-6 text-left\">Date</th>",[20039,20142],"                      <th className=\"p-4 text-left\">Payee (Doctor/Landlord)</th>",[20143,20226],"                      <th className=\"p-4 text-left\">TIN</th>",[20227,20312],"                      <th className=\"p-4 text-center\">ATC</th>",[20313,20406],"                      <th className=\"p-4 text-right\">Gross Payout</th>",[20407,20520],"                      <th className=\"p-4 pr-6 text-right text-[#1B9387]\">Tax Withheld</th>",[20521,20567],"                    </tr>",[20568,20613],"                  </thead>",[20614,20695],"                  <tbody className=\"divide-y divide-gray-100\">",[20696,20790],"                    {!taxData.qapList || taxData.qapList.length === 0 ? (",[20791,20840],"                      <tr>",[20841,20949],"                        <td colSpan={6} className=\"p-16 text-center text-gray-400\">",[20950,21061],"                          <span className=\"block text-4xl mb-3 opacity-50\">📂</span>",[21062,21208],"                          <span className=\"italic font-medium text-sm\">\n                            No withholding taxes recorded this month.",[21235,21263],"</span>\n                        </td>",[21264,21314],"                      </tr>",[21315,21361],"                    ) : (",[21362,21451],"                      taxData.qapList.map((p: any, i: number) => {",{"messageId":"71332","fix":"71686","desc":"71334"},{"messageId":"71335","fix":"71687","desc":"71337"},[21452,21548],"                        const grossStr = formatCurrency(p.grossAmount)",[21549,21643],"                        const taxStr = formatCurrency(p.taxWithheld)",[21644,21701],"                        return (",[21702,21814],"                          <tr key={i} className=\"hover:bg-gray-50 transition-colors\">",[21815,21967],"                            <td className=\"p-4 pl-6 text-gray-500 font-medium\">\n                              {new Date(p.date).toLocaleDateString()}",[21996,22092],"</td>\n                            <td className=\"p-4 text-gray-800 font-extrabold\">{p.payeeName}</td>",[22093,22216],"                            <td className=\"p-4 text-gray-500 font-mono font-bold\">{p.tin}</td>",[22217,22366],"                            <td className=\"p-4 text-center text-blue-600 font-mono font-bold bg-blue-50/30\">\n                              {p.atc}",[22395,22561],"</td>\n                            <td className=\"p-4 text-right text-gray-800 font-mono font-bold tabular-nums\">\n                              {grossStr || <span className=\"text-gray-300\">-</span>}",[22590,22765],"</td>\n                            <td className=\"p-4 pr-6 text-right text-[#1B9387] font-black font-mono tabular-nums\">\n                              {taxStr || <span className=\"text-[#1B9387]/30\">-</span>}",[22794,22824],"</td>\n                          </tr>",[22825,22876],"                        )",[22877,22924],"                      })",[22925,22968],"                    )}",[22969,23014],"                  </tbody>",[23015,23056],"                </table>",[23071,23092],[23093,23124],[23125,23152],[23153,23172],[23173,23174],[23175,23260],[23261,23333],"        {/* 3. FORM 1601-EQ / 1604-E VIEW + ALPHALIST (QAP) */}",[23334,23419],[23420,23483],"        {!loading && taxData && view === '1601EQ' && (",[23484,23593],[23594,23702],[23703,23790],"              <h3 className=\"text-lg font-extrabold text-gray-800 mb-1\">",[23807,23909],"{quarter === 0\n                  ? 'Form 1604-E Summary (Annual)'\n                  : 'Form 1601-EQ Summary (Quarterly)'}",[23910,23944],"              </h3>",[23945,24108],"              <p className=\"text-sm text-gray-500 font-medium mb-6\">\n                Taxes withheld from Doctor Professional Fees and Rent (ATC WI010 / WI100).",[24123,24244],[24245,24283],[24284,24421],[24440,24607],"</h3>\n                  <p className=\"text-xs text-[#1B9387]/70 font-bold mt-1 uppercase tracking-widest\">\n                    Total EWT Payable for the {quarter === 0 ? 'Year' : 'Quarter'}",[24626,24647],[24648,24757],[24758,24878],[24897,24919],[24920,24955],[24956,24987],[24988,24989],[24990,25122],[25123,25254],[25255,25293],[25294,25437],"                  <h3 className=\"text-sm font-extrabold text-gray-800 uppercase tracking-wide\">\n                    QAP: Alphalist of Pa