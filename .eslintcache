:"72279","desc":"71334"},{"messageId":"71335","fix":"72280","desc":"71337"},[7710,7737],"setActiveMenuId(null)",[7738,7766],"    setEditingId(s.id)",[7767,7809],"    setEditPrice(s.price.toString())",[7810,7817],[7818,7819],[7820,7851],"  const cancelEdit = () => {",[7852,7880],"    setEditingId(null)",[7881,7907],"    setEditPrice('')",[7908,7915],[7916,7917],[7918,7969],"  const handleSaveEdit = async (id: number) => {",[7970,8051],"    if (editPrice === '' || isNaN(editPriceNum) || editPriceNum < 0) return",[8052,8078],[8079,8093],[8094,8170],{"messageId":"71332","fix":"72281","desc":"71334"},{"messageId":"71335","fix":"72282","desc":"71337"},{"messageId":"71332","fix":"72283","desc":"71334"},{"messageId":"71335","fix":"72284","desc":"71337"},[8171,8256],"      const result = await api.updateServiceItem(id, { price: editPriceNum })",[8257,8258],[8259,8293],[8294,8385],"        setStatusMessage({ type: 'success', msg: `Price updated successfully!` })",[8386,8422],"        setEditingId(null)",[8423,8457],"        setEditPrice('')",[8458,8491],"        fetchServices()",[8492,8556],[8557,8578],[8579,8664],"        setStatusMessage({ type: 'error', msg: 'Failed to update price.' })",[8671,8679],[8680,8706],[8707,8778],[8779,8799],[8800,8831],[8832,8842],[8845,8850],[8851,8852],[8853,8925],"  const handleEditKeyDown = (e: React.KeyboardEvent, id: number) => {",[8926,9001],"    if (e.key === 'Enter') {\n      e.preventDefault()\n      handleSaveEdit(id)",[9006,9072],"}\n    if (e.key === 'Escape') {\n      e.preventDefault()\n      cancelEdit()",[9078,9082],[9085,9167],"}\n\n  // ---- Archive / Restore (custom confirm modal instead of window.confirm) ----",[9168,9256],"  const requestToggleStatus = (id: number, name: string, currentStatus: boolean) => {",[9257,9288],"    setActiveMenuId(null)",[9289,9355],"    setConfirmTarget({ id, name, activate: !currentStatus })",[9356,9363],[9364,9365],[9366,9412],[9413,9449],"    if (!confirmTarget) return",[9450,9498],"    const { id, activate } = confirmTarget",[9503,9525],[9526,9540],[9541,9617],{"messageId":"71332","fix":"72285","desc":"71334"},{"messageId":"71335","fix":"72286","desc":"71337"},{"messageId":"71332","fix":"72287","desc":"71334"},{"messageId":"71335","fix":"72288","desc":"71337"},[9618,9688],"      await api.updateServiceItem(id, { is_active: activate })",[9689,9797],"      setStatusMessage({ type: 'success', msg: `Procedure ${activate ? 'restored' : 'archived'}.` })",[9798,9827],"      fetchServices()",[9828,9888],"      setTimeout(() => setStatusMessage(null), 3000)",[9889,9915],[9916,9950],[9951,10022],[10023,10043],[10044,10075],[10076,10112],"      setConfirmTarget(null)",[10113,10123],[10126,10131],[10132,10133],[10134,10244],"  const formatCurrency = (val: number) =>\n    `₱ ${val.toLocaleString('en-US', { minimumFractionDigits: 2 })}`",[10245,10246],[10247,10326],"  const clearFilters = () => {\n    setSearchQuery('')\n    setCategoryFilter('')\n  }",[10327,10328],[10329,10381],"  const filteredServices = services.filter((s) => {",[10382,10533],"    const matchesQuery =\n      s.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      s.category.toLowerCase().includes(searchQuery.toLowerCase())",[10534,10616],"    const matchesCategory = !categoryFilter || s.category === categoryFilter",[10617,10665],"    return matchesQuery && matchesCategory",[10666,10674],[10675,10676],[10677,10748],"  // Group by category (curated order first), sort within each group",[10749,10793],"  const groupedServices = useMemo(() => {",[10794,10843],"    const groups = new Map<string, any[]>()",{"messageId":"71332","fix":"72289","desc":"71334"},{"messageId":"71335","fix":"72290","desc":"71337"},[10844,10888],"    for (const s of filteredServices) {",[10889,10958],"      if (!groups.has(s.category)) groups.set(s.category, [])",[10959,11004],"      groups.get(s.category)!.push(s)",[11005,11015],[11020,11061],"const sortFn = (a: any, b: any) => {",{"messageId":"71332","fix":"72291","desc":"71334"},{"messageId":"71335","fix":"72292","desc":"71337"},{"messageId":"71332","fix":"72293","desc":"71334"},{"messageId":"71335","fix":"72294","desc":"71337"},[11062,11157],"      const cmp = sortKey === 'name' ? a.name.localeCompare(b.name) : a.price - b.price",[11158,11209],"      return sortDir === 'asc' ? cmp : -cmp",[11210,11221],[11222,11261],"    const orderedCategoryNames = [",[11262,11319],"      ...allCategories.filter((c) => groups.has(c)),",[11326,11395],"...[...groups.keys()].filter((c) => !allCategories.includes(c))",[11396,11407],"    ]",[11408,11458],"    return orderedCategoryNames.map((cat) => ({",[11459,11486],"      category: cat,",[11487,11542],"      items: [...groups.get(cat)!].sort(sortFn)",[11543,11556],[11557,11618],"  }, [filteredServices, sortKey, sortDir, allCategories])",[11619,11620],[11621,11669],"  const toggleGroup = (category: string) => {",[11670,11701],"    setCollapsed((prev) => {",[11708,11742],"const next = new Set(prev)",[11743,11827],"      if (next.has(category)) next.delete(category)\n      else next.add(category)",[11828,11853],"      return next",[11854,11866],[11867,11874],[11875,11876],[11877,11945],"  const visibleCategories = groupedServices.map((g) => g.category)",[11946,12051],"  const allCollapsed =\n    visibleCategories.length > 0 && visibleCategories.every((c) => collapsed.has(c))",[12054,12155],"const toggleAllGroups = () => setCollapsed(allCollapsed ? new Set() : new Set(visibleCategories))",[12156,12157],[12158,12210],"  const toggleSort = (key: 'name' | 'price') => {",[12215,12289],"if (sortKey === key) setSortDir((d) => (d === 'asc' ? 'desc' : 'asc'))",[12294,12343],"else {\n      setSortKey(key)\n      setSortDir('asc')",[12349,12353],[12356,12367],"}\n\n  return (",[12368,12457],"    <div className=\"max-w-7xl mx-auto h-full flex flex-col text-gray-800 font-sans\">",[12458,12555],[12564,12578],[12579,12699],"          <h2 className=\"text-2xl font-extrabold text-gray-800 tracking-wide\">\n            Services & Pricing Manager",[12710,12846],"</h2>\n          <p className=\"text-sm text-gray-500 mt-1 font-medium\">\n            Manage clinic procedures, laboratory tests, and their fixed prices.",[12857,12870],[12871,12890],[12891,12892],[12893,12925],[12934,13144],[13145,13234],"        >\n          {statusMessage.type === 'success' ? '✅ ' : '⚠️ '}\n          {statusMessage.msg}",[13235,13258],[13259,13274],[13275,13276],[13277,13360],[13361,13404],"        {/* LEFT PANE: ADD NEW */}",[13405,13514],[13515,13646],"          <h3 className=\"text-lg font-extrabold text-gray-800 mb-5 border-b border-gray-100 pb-3\">\n            Add New Procedure",[13657,13738],"</h3>\n          <form onSubmit={handleCreateService} className=\"space-y-4\" noValidate>",[13739,13769],[13770,13913],"              <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                Category",[13928,13962],"</label>\n              {addingCategory ? (",[13963,14024],"                <div className=\"flex gap-2\">",[14025,14068],[14069,14121],[14122,14172],"                    autoFocus",[14173,14245],"                    placeholder=\"New category name\"",[14246,14310],"                    value={newCategoryName}",[14311,14402],"                    onChange={(e) => setNewCategoryName(e.target.value)}",[14423,14583],"onKeyDown={(e) => {\n                      if (e.key === 'Enter') {\n                        e.preventDefault()\n                        confirmAddCategory()\n                      }\n                      if (e.key === 'Escape') setAddingCategory(false)",[14604,14767],"}}\n                    className=\"flex-1 bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-2.5 text-sm text-gray-800 font-medium focus:border-[#1B9387] outline-none\"",[14786,14807],"/>\n                  <button",[14828,15003],"type=\"button\"\n                    onClick={confirmAddCategory}\n                    className=\"px-3 rounded-md bg-[#1B9387] hover:bg-[#28958B] text-white cursor-pointer\"\n                    title=\"Add category\"",[15022,15103],">\n                    <Check className=\"w-4 h-4\" style={{ color: '#ffffff' }} />",[15122,15150],"</button>\n                  <button",[15171,15353],"type=\"button\"\n                    onClick={() => setAddingCategory(false)}\n                    className=\"px-3 rounded-md bg-gray-200 hover:bg-gray-300 text-gray-600 cursor-pointer\"\n                    title=\"Cancel\"",[15372,15420],">\n                    <X className=\"w-4 h-4\" />",[15421,15467],[15468,15507],[15508,15542],[15559,15820],"<select\n                  value={newItem.category}\n                  onChange={(e) => handleCategorySelect(e.target.value)}\n                  className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-2.5 text-sm text-gray-800 font-medium focus:border-[#1B9387] outline-none cursor-pointer\"",[15837,15922],">\n                  {allCategories.map((c) => (\n                    <option key={c} value={c}>\n                      {c}\n                    </option>",[15941,16015],"))}\n                  <option value=\"__add_new__\">+ Add new category</option>",[16016,16058],[16059,16090],[16091,16122],[16123,16153],[16154,16303],"              <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                Procedure Name",[16318,16339],[16340,16384],[16385,16426],[16427,16489],"                placeholder=\"e.g. Ultrasound\"",[16490,16543],"                value={newItem.name}",[16544,16641],"                onChange={(e) => setNewItem({ ...newItem, name: e.target.value })}",[16642,16729],[16730,16789],[16790,17024],"                className={`w-full bg-[#FBF8F8] border rounded-md p-2.5 text-sm text-gray-800 font-medium outline-none ${nameError ? 'border-red-300 focus:border-red-400' : 'border-[#B0DCDA] focus:border-[#1B9387]'}`}",[17039,17056],[17071,17177],[17190,17209],"  )}\n            </div>",[17222,17240],[17241,17387],"              <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                Fixed Price",[17402,17443],"</label>\n              <div className=\"relative\">",[17444,17578],"                <span className=\"absolute left-2.5 top-1/2 -translate-y-1/2 text-sm font-bold text-gray-400\">",[17596,17618]," ₱\n                </span>",[17635,17669],"<input\n                  type=\"number\"",[17670,17718],"                  step=\"0.01\"",[17719,17763],"                  min=\"0\"",[17764,17809],[17810,17865],"                  placeholder=\"0.00\"",[17866,17924],"                  value={newItem.price}",[17925,18027],"                  onChange={(e) => setNewItem({ ...newItem, price: e.target.value })}",[18028,18120],"                  onBlur={() => setTouched((t) => ({ ...t, price: true }))}",[18121,18185],"                  aria-invalid={!!priceError}",[18186,18438],"                  className={`w-full bg-[#FBF8F8] border rounded-md p-2.5 pl-6 text-sm text-gray-800 font-mono font-bold outline-none ${priceError ? 'border-red-300 focus:border-red-400' : 'border-[#B0DCDA] focus:border-[#1B9387]'}`}",[18439,18474],[18475,18510],[18511,18633],"              {priceError && (\n                <p className=\"mt-1.5 text-[11px] font-semibold text-red-500\">{priceError}</p>",[18646,18665],[18678,18960],"<button\n              type=\"submit\"\n              disabled={loading || !isCreateValid}\n              className=\"w-full bg-[#1B9387] hover:bg-[#28958B] text-white font-bold py-3 rounded-md transition mt-6 cursor-pointer shadow-sm uppercase tracking-wider text-sm disabled:opacity-50 disabled:cursor-not-allowed\"",[18973,19031],">\n              {loading ? 'Saving...' : 'Add Procedure'}",[19032,19066],[19067,19095],[19096,19119],[19120,19121],[19122,19163],"        {/* RIGHT PANE: LIST */}",[19164,19293],"        <div className=\"col-span-2 bg-white border border-[#B0DCDA] rounded-xl shadow-sm overflow-hidden flex flex-col\">",[19294,19425],[19426,19494],[19495,19613],"              <h3 className=\"text-lg font-extrabold text-gray-800 tracking-wide\">\n                Master Price List",[19628,19756],[19757,19942],"                {searchQuery || categoryFilter\n                  ? `${filteredServices.length} of ${services.length}`\n                  : `${services.length} procedure${services.length === 1 ? '' : 's'}`}",[19943,19979],[19994,20151],"<button\n                onClick={toggleAllGroups}\n                className=\"flex items-center gap-1 text-[11px] font-bold text-gray-500 hover:text-[#1B9387] cursor-pointer\"",[20166,20289],">\n                {allCollapsed ? (\n                  <ChevronsUpDown className=\"w-3.5 h-3.5\" />\n                ) : (\n                  <ChevronsDownUp className=\"w-3.5 h-3.5\" />",[20306,20369],")}\n                {allCollapsed ? 'Expand all' : 'Collapse all'}",[20370,20408],[20409,20440],[20441,20507],[20508,20544],[20545,20600],"                value={categoryFilter}",[20601,20683],"                onChange={(e) => setCategoryFilter(e.target.value)}",[20684,20875],[20876,20906],[20907,20980],"                <option value=\"\">All Categories</option>",[20981,21078],"                {allCategories.map((c) => (\n                  <option key={c} value={c}>\n                    {c}\n                  </option>",[21095,21117],"))}\n              </select>",[21118,21173],[21174,21298],[21315,21609],"<input\n                  type=\"text\"\n                  placeholder=\"Search procedures...\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  className=\"w-56 bg-white border border-[#B0DCDA] rounded-md pl-8 pr-7 py-1.5 text-sm focus:outline-none focus:border-[#1B9387] text-gray-800 shadow-sm\"",[21626,21660],"/>\n                {searchQuery && (",[21679,21865],"<button\n                    onClick={() => setSearchQuery('')}\n                    className=\"absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 cursor-pointer\"\n                    title=\"Clear search\"",[21884,21936],">\n                    <X className=\"w-3.5 h-3.5\" />",[21937,21983],[21984,22019],[22020,22055],[22056,22087],[22088,22115],[22116,22117],[22118,22186],"          <div className=\"flex-1 overflow-auto relative\">",[22187,22256],[22257,22362],"              <thead className=\"bg-[#FBF8F8] border-b border-[#B0DCDA] sticky top-0 z-20\">",[22363,22478],[22479,22563],"                  <th className=\"p-3.5 border-r border-gray-100\">",[22584,22719],"<button\n                      onClick={() => toggleSort('name')}\n                      className=\"flex items-center gap-1 cursor-pointer hover:text-gray-700\"",[22740,22876],">\n                      Procedure Name{' '}\n                      <ArrowUpDown\n                        className={`w-3 h-3 ${sortKey === 'name' ? 'text-[#1B9387]' : 'text-gray-300'}`}",[22899,22927],"/>\n                    </button>",[22928,22970],"                  </th>",[22971,23071],"                  <th className=\"p-3.5 border-r border-gray-100 text-right w-32\">",[23072,23236],"                    <button\n                      onClick={() => toggleSort('price')}\n                      className=\"flex items-center gap-1 ml-auto cursor-pointer hover:text-gray-700\"",[23257,23385],">\n                      Price{' '}\n                      <ArrowUpDown\n                        className={`w-3 h-3 ${sortKey === 'price' ? 'text-[#1B9387]' : 'text-gray-300'}`}",[23406,23436],"  />\n                    </button>",[23437,23479],[23480,23568],"                  <th className=\"p-3.5 text-center w-16\">Actions</th>",[23569,23607],[23608,23645],[23646,23719],[23720,23790],"                {loading && services.length === 0 ? (",[23809,23941],"<tr>\n                    <td colSpan={3} className=\"p-12 text-center text-gray-400 italic font-medium\">\n                      Loading proced