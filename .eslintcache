     No accounts match your search.",[20466,20596],"</p>\n                      <button\n                        onClick={clearFilters}\n                        className=\"text-xs font-bold text-[#1B9387] hover:underline cursor-pointer\"",[20619,20672],">\n                        Clear search &amp; filters",[20673,20727],"                      </button>",[20728,20774],"                    </td>",[20775,20817],[20818,20856],[20857,20923],"                  filteredAccounts.map((a) => (",[20924,20968],"                    <tr",[20969,21026],"                      key={a.code}",[21027,21104],"                      onClick={() => openEditModal(a)}",[21105,21301],"                      className={`hover:bg-gray-50 transition-colors even:bg-gray-50/50 odd:bg-white group cursor-pointer ${highlightCode === a.code ? 'bg-[#E9FAFA]' : ''}`}",[21302,21344],[21345,21500],"                      <td className=\"p-4 border-r border-gray-100 text-center font-mono font-extrabold text-[#1B9387]\">\n                        {a.code}",[21523,21633],"</td>\n                      <td className=\"p-4 border-r border-gray-100 font-extrabold text-gray-800\">\n                        {a.name}",[21656,21736],"</td>\n                      <td className=\"p-4 border-r border-gray-100 text-center\">",[21761,21936],"<span\n                          className={`px-2.5 py-1 text-[10px] font-extrabold rounded-md uppercase tracking-wider border shadow-sm ${getTypeColor(a.account_type?.name)}`}",[21961,22012],">\n                          {a.account_type?.name}",[22013,22069],"                        </span>",[22070,22120],"                      </td>",[22121,22289],"                      <td className=\"p-4 border-r border-gray-100 text-center text-[10px] font-extrabold text-gray-500 uppercase tracking-wider\">",[22290,22371],"                        {a.account_type?.normal_balance}",[22372,22422],[22423,22500],"                      <td className=\"p-4 text-center\">",[22501,22557],"                 