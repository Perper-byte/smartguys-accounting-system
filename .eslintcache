iled && (\n                      <th className=\"p-3 text-right border-r border-gray-200 italic text-gray-400\">\n                        Total Deductions\n                      </th>",[20402,20518],")}\n\n                    <th className=\"p-3 text-right border-r border-[#B0DCDA] text-red-500 bg-red-50/50\">\n                      Tax W/H",[20539,20639],"</th>\n                    <th className=\"p-3 text-right text-[#1B9387] bg-[#E9FAFA]/50 pr-6\">Net Pay</th>",[20640,20682],[20683,20724],"                </thead>",[20725,20816],"                <tbody className=\"divide-y divide-gray-100 bg-gray-50/30\">",[20817,20884],"                  {payrollItems.length === 0 ? (",[20905,21033],"<tr>\n                      <td colSpan={14} className=\"p-12 text-center text-gray-400 italic\">\n                        No active employees found.",[21055,21076]," </td>\n                    </tr>",[21095,21145],") : (\n                    payrollItems.map((emp) => (",[21146,21266],"                      <tr key={emp.id} className=\"hover:bg-[#E9FAFA]/30 transition-colors group\">",[21267,21513],"                        <td className=\"p-3 font-bold text-gray-800 border-r border-[#B0DCDA] sticky left-0 z-10 bg-white group-hover:bg-[#FBF8F8] shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)] flex items-center justify-between\">",[21514,21590],"                          <span>{emp.name}</span>",[21617,21746],"{emp.hasIncompleteIds && (\n                            <span title=\"Missing IDs\" className=\"text-yellow-500 text-xs ml-2\">",[21774,21801],"   ⚠️\n                            </span>",[21827,21930]," )}\n                        </td>\n                        {renderInput(\n                          emp.id,\n                          emp.basePay,\n                          'basePay',\n                          'text-gray-800',\n                          'bg-blue-50/50'",[21955,22061],")}\n                        {renderInput(\n                          emp.id,\n                          emp.overtime,\n                          'overtime',\n                          'text-blue-600',\n                          'bg-blue-50/50'",[22086,22210],")}\n                        {showDetailed &&\n                          renderInput(\n                            emp.id,\n                            emp.nightDiff,\n                            'nightDiff',\n                            'text-blue-600',\n                            'bg-blue-50/50'",[22235,22367],"  )}\n                        {showDetailed &&\n                          renderInput(\n                            emp.id,\n                            emp.otherEarnings,\n                            'otherEarnings',\n                            'text-blue-600',\n                            'bg-blue-50/50'",[22394,22545],")}\n                        <td className=\"p-3 pr-4 border-r border-[#B0DCDA] bg-blue-50/30\">\n                          <CellMoney val={emp.gross} colorClass=\"text-blue-600\" />",[22570,22670],"</td>\n\n                        {renderInput(emp.id, emp.sss, 'sss', 'text-orange-600', 'bg-orange-50/50')}",[22695,22825],"{showDetailed &&\n                          renderInput(\n                            emp.id,\n                            emp.philhealth,\n                            'philhealth',\n                            'text-orange-600',\n                            'bg-orange-50/50'",[22850,22974],"  )}\n                        {showDetailed &&\n                          renderInput(\n                            emp.id,\n                            emp.pagibig,\n                            'pagibig',\n                            'text-orange-600',\n                            'bg-orange-50/50'",[23001,23125],")}\n                        {showDetailed &&\n                          renderInput(\n                            emp.id,\n                            emp.cashAdvance,\n                            'cashAdvance',\n                            'text-red-500',\n                            'bg-red-50/50'",[23150,23274],"  )}\n                        {showDetailed &&\n                          renderInput(\n                            emp.id,\n                            emp.licenseFee,\n                            'licenseFee',\n                            'text-red-500',\n                            'bg-red-50/50'",[23299,23433],"  )}\n                        {showDetailed &&\n                          renderInput(\n                            emp.id,\n                            emp.otherDeductions,\n                            'otherDeductions',\n                            'text-red-500',\n                            'bg-red-50/50'",[23460,23646],")}\n                        {!showDetailed && (\n                          <td className=\"p-3 pr-4 border-r border-gray-200 bg-white\">\n                            <CellMoney\n                              val={emp.deductions}\n                              colorClass=\"text-orange-500\"\n                              isBold={false}\n                            />\n                          </td>",[23671,23765],")}\n\n                        {renderInput(emp.id, emp.tax, 'tax', 'text-red-600', 'bg-red-50/50')}",[23766,23955],"                        <td className=\"p-3 pr-6 text-right bg-[#FBF8F8]/50 border-r border-transparent\">\n                          <CellMoney val={emp.net} colorClass=\"text-[#1B9387]\" />",[23980,24006],[24007,24050],"                    ))",[24051,24090],[24091,24132],"                </tbody>",[24133,24170],"              </table>",[24171,24202],[24203,24204],[24205,24264],"            {/* UX FIX: Sticky Summary Bar */}",[24265,24463],"            <div className=\"sticky bottom-0 bg-[#FBF8F8] border-t border-[#B0DCDA] p-5 px-6 flex justify-between items-center shadow-[0_-10px_15px_-3px_rgba(0,0,0,0.05)] z-40 shrink-0\">",[24478,24547],"<div className=\"grid grid-cols-4 gap-8 text-sm w-2/3\">",[24564,24796],"<div>\n                  <p className=\"text-gray-