ceNo:·selectedInvoice.referenceNo·});␍` with `if·(onNavigate)⏎······················onNavigate('collections',·{⏎························prefillEntity:·selectedInvoice.payeeName,⏎························prefillAmount:·selectedInvoice.balance,⏎························referenceNo:·selectedInvoice.referenceNo`",{"range":"61333","text":"61334"},"Replace `··················setSelectedInvoice(null);␍` with `})⏎····················setSelectedInvoice(null)`",{"range":"61335","text":"61336"},"Replace `····································}}␍` with `··················}}`",{"range":"61337","text":"61338"},{"range":"61339","text":"55783"},"Replace `····································<CreditCard·size={14}·/>·Record·Payment␍` with `··················<CreditCard·size={14}·/>·Record·Payment`",{"range":"61340","text":"61341"},{"range":"61342","text":"53480"},{"range":"61343","text":"53166"},{"range":"61344","text":"51967"},{"range":"61345","text":"51900"},{"range":"61346","text":"51431"},{"range":"61347","text":"51433"},{"range":"61348","text":"51474"},{"range":"61349","text":"51476"},{"range":"61350","text":"45546"},{"range":"61351","text":"45467"},{"range":"61352","text":"45467"},{"range":"61353","text":"45467"},{"range":"61354","text":"45467"},{"range":"61355","text":"45467"},{"range":"61356","text":"45467"},{"range":"61357","text":"51485"},{"range":"61358","text":"45467"},{"range":"61359","text":"45467"},{"range":"61360","text":"51489"},["61361","61362"],{"range":"61363","text":"51497"},["61364","61365"],{"range":"61366","text":"45467"},{"range":"61367","text":"51502"},"Replace `····const·[refPrefix,·setRefPrefix]·=·useState('JV-');␍` with `··const·[refPrefix,·setRefPrefix]·=·useState('JV-')`",{"range":"61368","text":"61369"},"Replace `··const·[refSequence,·setRefSequence]·=·useState('');␍` with `const·[refSequence,·setRefSequence]·=·useState('')`",{"range":"61370","text":"61371"},"Replace `··const·[description,·setDescription]·=·useState('');␍` with `const·[description,·setDescription]·=·useState('')`",{"range":"61372","text":"61373"},{"range":"61374","text":"45467"},"Replace `····const·[vatType,·setVatType]·=·useState('VATABLE');␍` with `··const·[vatType,·setVatType]·=·useState('VATABLE')`",{"range":"61375","text":"61376"},{"range":"61377","text":"51516"},{"range":"61378","text":"45467"},{"range":"61379","text":"51524"},{"range":"61380","text":"45467"},{"range":"61381","text":"51527"},{"range":"61382","text":"51529"},{"range":"61383","text":"51533"},{"range":"61384","text":"51535"},{"range":"61385","text":"45467"},{"range":"61386","text":"51538"},"Replace `··const·[lines,·setLines]·=·useState([{·accountId:·'',·debit:·0,·credit:·0·},·{·accountId:·'',·debit:·0,·credit:·0·}]);␍` with `)⏎··const·[lines,·setLines]·=·useState([⏎····{·accountId:·'',·debit:·0,·credit:·0·},⏎····{·accountId:·'',·debit:·0,·credit:·0·}`",{"range":"61387","text":"61388"},"Replace `··␍` with `])`",{"range":"61389","text":"61390"},"Replace `····const·[attachments,·setAttachments]·=·useState<File[]>([]);␍` with `⏎··const·[attachments,·setAttachments]·=·useState<File[]>([])`",{"range":"61391","text":"61392"},{"range":"61393","text":"51545"},{"range":"61394","text":"45467"},{"range":"61395","text":"51350"},{"range":"61396","text":"51348"},{"range":"61397","text":"45467"},{"range":"61398","text":"51552"},{"range":"61399","text":"51554"},["61400","61401"],["61402","61403"],{"range":"61404","text":"51560"},{"range":"61405","text":"51562"},["61406","61407"],{"range":"61408","text":"51566"},["61409","61410"],{"range":"61411","text":"47904"},{"range":"61412","text":"51587"},{"range":"61413","text":"45467"},"Replace `····//·🔥·FIX:·Extracted·fetch·logic·so·the·button·can·use·it␍` with `··//·🔥·FIX:·Extracted·fetch·logic·so·the·button·can·use·it`",{"range":"61414","text":"61415"},{"range":"61416","text":"51590"},{"range":"61417","text":"47865"},{"range":"61418","text":"51593"},["61419","61420"],["61421","61422"],{"range":"61423","text":"51599"},{"range":"61424","text":"51601"},"Replace `········}·catch·(error)·{·␍` with `····}·catch·(error)·{`",{"range":"61425","text":"47900"},"Replace `······console.error(\"Failed·to·fetch·next·sequence\",·error);·␍` with `console.error('Failed·to·fetch·next·sequence',·error)`",{"range":"61426","text":"61427"},{"range":"61428","text":"47904"},{"range":"61429","text":"45556"},{"range":"61430","text":"45467"},{"range":"61431","text":"51552"},{"range":"61432","text":"51608"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\MY PC\\Desktop\\lol\\smartguys-accounting-system\\src\\renderer\\src\\components\\JournalEntryForm.tsx:57:9\n  55 |\n  56 |     useEffect(() => {\n> 57 |         fetchNextSequence();\n     |         ^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  58 |     }, [refPrefix, status]); \n  59 |\n  60 |     useEffect(() => {","Replace `····},·[refPrefix,·status]);·␍` with `··},·[refPrefix,·status])`",{"range":"61433","text":"54115"},["61434"],{"range":"61435","text":"45467"},{"range":"61436","text":"51552"},{"range":"61437","text":"57796"},{"range":"61438","text":"51617"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\MY PC\\Desktop\\lol\\smartguys-accounting-system\\src\\renderer\\src\\components\\JournalEntryForm.tsx:62:13\n  60 |     useEffect(() => {\n  61 |         if (!payeeId) {\n> 62 |             setPayeeBalance(null);\n     |             ^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  63 |             return;\n  64 |         }\n  65 |         const fetchBalance = async () => {",{"range":"61439","text":"51619"},{"range":"61440","text":"47904"},{"range":"61441","text":"57808"},{"range":"61442","text":"51368"},["61443","61444"],["61445","61446"],{"range":"61447","text":"51629"},{"range":"61448","text":"51631"},{"range":"61449","text":"51633"},{"range":"61450","text":"46021"},{"range":"61451","text":"47904"},{"range":"61452","text":"51637"},"Replace `····},·[payeeId]);␍` with `··},·[payeeId])`",{"range":"61453","text":"61454"},{"range":"61455","text":"45467"},{"range":"61456","text":"51642"},{"range":"61457","text":"51554"},["61458","61459"],["61460","61461"],{"range":"61462","text":"51649"},"Replace `············const·updatedPayees·=·await·api.getPayees();␍` with `······const·updatedPayees·=·await·api.getPayees()`",{"range":"61463","text":"61464"},"Replace `······setPayees(Array.isArray(updatedPayees)·?·updatedPayees·:·[]);␍` with `setPayees(Array.isArray(updatedPayees)·?·updatedPayees·:·[])`",{"range":"61465","text":"61466"},{"range":"61467","text":"47904"},{"range":"61468","text":"51656"},{"range":"61469","text":"51658"},{"range":"61470","text":"51660"},{"range":"61471","text":"51662"},{"range":"61472","tex