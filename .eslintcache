span className=\"text-xs font-extrabold uppercase tracking-wider\">\n                              {category}",[26437,26602],"</span>\n                            <span className=\"text-[10px] font-bold text-gray-400 uppercase tracking-wider\">\n                              {items.length} item{items.length === 1 ? '' : 's'}",[26631,26662],"</span>\n                          </div>",[26663,26717],[26718,26768],[26769,26861],"                      {!collapsed.has(category) &&\n                        items.map((s) => (",[26884,27087],"    <tr\n                            key={s.id}\n                            className={`transition-colors ${s.is_active ? 'hover:bg-gray-50 even:bg-gray-50/50' : 'bg-gray-100 opacity-60'} ${highlightId === s.id ? '!bg-[#E9FAFA]' : ''}`}",[27112,27236],"  >\n                            <td className=\"px-4 py-2.5 border-r border-gray-100 font-extrabold text-gray-800\">\n                              {s.name}",[27261,27354],"    </td>\n                            <td className=\"px-4 py-2.5 border-r border-gray-100 text-right\">",[27355,27435],"                              {editingId === s.id ? (",[27436,27550],"                                <div className=\"flex items-center justify-end gap-1\">",[27551,27622],[27623,27705],"                                    type=\"number\"",[27706,27786],"                                    step=\"0.01\"",[27787,27863],"                                    min=\"0\"",[27864,27942],"                                    autoFocus",[27943,28029],"                                    value={editPrice}",[28030,28143],"                                    onChange={(e) => setEditPrice(e.target.value)}",[28144,28256],"                                    onKeyDown={(e) => handleEditKeyDown(e, s.id)}",[28257,28357],"                                    aria-invalid={editPriceInvalid}",[28358,28598],"                                    className={`w-20 border rounded px-2 py-1 text-right font-mono font-bold text