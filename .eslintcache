GJ') {",[9677,9708],[9709,9766],"        { reference_no: { startsWith: 'JV-' } },",[9767,9825],"        { reference_no: { startsWith: 'ADJ-' } },",[9826,9887],"        { reference_no: { startsWith: 'OPENING-' } }",[9888,9903],[9904,9914],[9915,9916],[9917,9978],[9979,10011],"      where: whereClause,",[10012,10089],"      include: { lines: { include: { account: true } }, payee: true },",[10090,10127],"      orderBy: { date: 'asc' }",[10128,10140],[10141,10142],[10143,10184],"    const formattedData: any[] = []",{"messageId":"71332","fix":"71526","desc":"71334"},{"messageId":"71335","fix":"71527","desc":"71337"},[10185,10224],"    for (const entry of entries) {",[10225,10271],"      for (const line of entry.lines) {",[10272,10309],"        formattedData.push({",[10310,10348],"          date: entry.date,",[10349,10402],"          referenceNo: entry.reference_no,",[10403,10455],"          description: entry.description,",[10456,10512],"          payeeName: entry.payee?.name || '',",[10513,10563],"          accountCode: line.account_id,",[10564,10616],"          accountName: line.account.name,",[10617,10664],"          debit: Number(line.debit),",[10665,10713],"          credit: Number(line.credit)",[10714,10734],[10735,10749],[10750,10760],[10761,10791],"    return formattedData",[10792,10798],[10799,10800],[10801,10841],"  static async getAgedReceivables() {",[10842,10900],"    const lines = await prisma.journalLine.findMany({",[10901,10922],[10923,10959],"        account_id: '1200',",[10960,10985],"        entry: {",[10986,11031],"          payee_id: { not: null },",[11032,11078],"          status: { not: 'VOIDED' }",[11087,11097],[11104,11113],"},",[11114,11176],"      include: { entry: { include: { payee: true } } },",[11177,11225],"      orderBy: { entry: { date: 'asc' } }",[11226,11238],[11239,11240],[11245,11309],"const payeeMap: Record<\n      string,\n      {\n        name: string",[11310,11339],"        invoices: any[]",{"messageId":"71332","fix":"71528","desc":"71334"},{"messageId":"71335","fix":"71529","desc":"71337"},[11340,11368],"        payments: any[]",{"messageId":"71332","fix":"71530","desc":"71334"},{"messageId":"71335","fix":"71531","desc":"71337"},[11375,11386],"}\n    > = {}",[11387,11388],[11389,11425],[11426,11487],"      const payeeId = line.entry.payee_id!.toString()",[11488,11526],"      if (!payeeMap[payeeId]) {",[11527,11565],"        payeeMap[payeeId] = {",[11566,11616],"          name: line.entry.payee!.name,",[11617,11651],"          invoices: [],",[11652,11685],"          payments: []",[11686,11705],[11706,11720],[11721,11763],"      if (Number(line.debit) > 0) {",[11764,11814],"        payeeMap[payeeId].invoices.push({",[11815,11880],"          invoiceNo: line.entry.reference_no || 'N/A',",[11881,11944],"          description: line.entry.description || '',",[11945,11988],"          date: line.entry.date,",[11989,12045],"          originalAmount: Number(line.debit),",[12046,12094],"          amount: Number(line.debit),",[12095,12130],"          paidAmount: 0,",[12131,12235],"          dueDate: new Date(new Date(line.entry.date).getTime() + 30 * 24 * 60 * 60 * 1000)",[12236,12256],[12257,12271],[12272,12315],"      if (Number(line.credit) > 0) {",[12316,12366],"        payeeMap[payeeId].payments.push({",[12367,12431],"          referenceNo: line.entry.reference_no || '',",[12432,12495],[12496,12545],"          amount: Number(line.credit),",[12546,12603],"          remainingAmount: Number(line.credit)",[12604,12624],[12625,12639],[12640,12650],[12651,12652],[12653,12687],[12688,12724],"    today.setHours(0, 0, 0, 0)",[12725,12759],"    const report: any[] = []",{"messageId":"71332","fix":"71532","desc":"71334"},{"messageId":"71335","fix":"71533","desc":"71337"},[12760,12761],[12762,12804],"    for (const payeeId in payeeMap) {",[12811,12846],"const p = payeeMap[payeeId]",[12847,12848],[12855,12893],"// PASS 1: Exact Explicit Match",[12894,12938],"      for (const pmt of p.payments) {",[12939,12995],"        if (pmt.remainingAmount <= 0) continue",[12996,13044],"        for (const inv of p.invoices) {",[13045,13096],"          if (inv.amount <= 0) continue",[13097,13169],"          const desc = (pmt.description || '').toUpperCase()",[13170,13241],"          const ref = (pmt.referenceNo || '').toUpperCase()",[13242,13305],"          const invNo = inv.invoiceNo.toUpperCase()",[13306,13307],[13308,13379],"          if (desc.includes(invNo) || ref.includes(invNo)) {",[13392,13465],"const deduction = Math.min(pmt.remainingAmount, inv.amount)",[13466,13515],"            inv.amount -= deduction",[13516,13569],"            inv.paidAmount += deduction",[13570,13628],"            pmt.remainingAmount -= deduction",[13639,13651],[13652,13670],[13671,13685],[13686,13687],[13694,13724],"// PASS 2: Exact Amount",[13725,13769],[13770,13826],[13827,13875],[13876,13927],[13928,14005],"          if (Math.abs(inv.amount - pmt.remainingAmount) < 0.01) {",[14006,14069],"            inv.paidAmount += pmt.remainingAmount",[14070,14110],"            inv.amount = 0",[14123,14160],"pmt.remainingAmount = 0",[14161,14192],"            break",[14193,14215],[14216,14234],[14235,14249],[14250,14251],[14258,14280],"// PASS 3: FIFO",[14281,14325],[14326,14382],[14383,14431],[14432,14483],[14484,14565],"          const deduction = Math.min(pmt.remainingAmount, inv.amount)",[14576,14611],"inv.amount -= deduction",[14612,14661],"          inv.paidAmount += deduction",[14662,14716],"          pmt.remainingAmount -= deduction",[14717,14774],"          if (pmt.remainingAmount <= 0) break",[14775,14793],[14794,14808],[14809,14810],[14817,14888],"let current = 0\n      let days30 = 0\n      let days60 = 0\n      let days90 = 0",[14889,14935],"      const invoiceDetails: any[] = []",{"messageId":"71332","fix":"71534","desc":"71334"},{"messageId":"71335","fix":"71535","desc":"71337"},[14936,14937],[14938,14982],"      for (const inv of p.invoices) {",[14983,15051],"        const unpaidAmount = Number(inv.amount.toFixed(2))",[15052,15091],"        let status = 'Unpaid'",[15100,15133],"if (unpaidAmount <= 0) {",[15134,15171],"          status = 'Paid'",[15172,15221],"        } else if (inv.paidAmount > 0) {",[15222,15269],"          status = 'Partially Paid'",[15270,15288],[15289,15290],[15291,15331],"        if (unpaidAmount > 0) {",[15332,15388],"          const invDate = new Date(inv.date)",[15389,15439],"          invDate.setHours(0, 0, 0, 0)",[15440,15514],"          const diffTime = today.getTime() - invDate.getTime()",[15515,15597],"          const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24))",[15598,15599],[15600,15665],"          if (diffDays <= 30) current += unpaidAmount",[15666,15735],"          else if (diffDays <= 60) days30 += unpaidAmount",[15736,15805],"          else if (diffDays <= 90) days60 += unpaidAmount",[15806,15855],"          else days90 += unpaidAmount",[15856,15874],[15875,15876],[15877,15915],"        invoiceDetails.push({",[15916,15962],"          invoiceNo: inv.invoiceNo,",[15963,15999],"          date: inv.date,",[16000,16042],"          dueDate: inv.dueDate,",[16043,16085],"          amount: unpaidAmount,",[16086,16142],"          originalAmount: inv.originalAmount,",[16143,16178],"          status: status",[16187,16199],[16200,16214],[16215,16216],[16223,16300],"const total = Number((current + days30 + days60 + days90).toFixed(2))",[16301,16359],"      if (total > 0 || invoiceDetails.length > 0) {",[16360,16390],"        report.push({",[16391,16430],"          payeeName: p.name,",[16431,16488],"          current: Number(current.toFixed(2)),",[16489,16544],"          days30: Number(days30.toFixed(2)),",[16555,16600],"days60: Number(days60.toFixed(2)),",[16601,16656],"          days90: Number(days90.toFixed(2)),",[16657,16684],"          total,",[16685,16730],"          invoices: invoiceDetails",[16731,16751],[16752,16766],[16767,16777],[16778,16779],[16780,16837],"    return report.sort((a, b) => b.total - a.total)",[16838,16844],[16845,16846],[16847,16886],"  static async getInvoiceTracker() {",[16887,16986],"    // 1. Fetch BOTH manual INV- invoices AND automated SYS- POS transactions (Exclude voided)",[16987,17049],"    const invoices = await prisma.journalEntry.findMany({",[17050,17071],[17072,17239],"        OR: [{ reference_no: { startsWith: 'INV-' } }, { reference_no: { startsWith: 'SYS-' } }],",[17240,17282],"        status: { not: 'VOIDED' }",[17283,17298],[17299,17350],"      include: { lines: true, payee: true },",[17351,17388],[17389,17401],[17402,17403],[17404,17475],"    // 2. Fetch ALL Payments/Collections (Credits to Account 1200)",[17476,17582],"    // Fixed: We no longer restrict by `payee_id: { not: null }` so we can catch unassigned payments!",[17583,17649],"    const arCreditLines = await prisma.journalLine.findMany({",[17650,17671],[17672,17708],[17709,17744],"        credit: { gt: 0 },",[17745,17770],[17771,17817],[17818,17836],[17837,17852],[17859,17891],"include: { entry: true },",[17892,17940],[17941,17953],[17954,17955],[17956,17983],"    // Format Payments",[17984,18041],"    const allPayments = arCreditLines.map((line) => ({",[18042,18067],"      id: line.id,",[18068,18136],"      payeeId: line.entry.payee_id?.toString() || 'NO_PAYEE',",[18143,18178],"amount: Number(line.credit),",[18179,18223],"      remaining: Number(line.credit),",[18224,18295],"      description: (line.entry.description || '').toUpperCase(),",[18296,18367],"      referenceNo: (line.entry.reference_no || '').toUpperCase()",[18372,18381],[18382,18383],[18384,18428],"    // 3. Prepare robust invoice models",[18429,18482],"    const invoiceObjects = invoices.map((inv) => {",[18489,18531],"// Find specific Receivables debits",[18532,18571],"      const arAmount = inv.lines",[18572,18649],"        .filter((l) => l.account_id === '1200' && Number(l.debit) > 0)",[18650,18713],"        .reduce((sum, l) => sum + Number(l.debit), 0)",[18714,18715],[18716,18755],"      const isAR = arAmount > 0",[18756,18757],[18758,18848],"      // Explicitly track actual Cash (1020) and GCash (1010) debited upon creation",[18849,18890],"      const cashAmount = inv.lines",[18891,18984],"        .filter((l) => ['1010', '1020'].includes(l.account_id) && Number(l.debit) > 0)",[18985,19048],[19049,19050],[19051,19136],"      // Total properly equals expected collection (Cash upfront + AR pending)",[19137,19192],"      const totalAmount = arAmount + cashAmount",[19193,19194],[19195,19216],"      return {",[19217,19245],"        id: inv.id,",[19246,19278],"        date: inv.date,",[19279,19332],"        referenceNo: inv.reference_no || '',",[19333,19379],"        description: inv.description,",[19388,19445],"payeeId: inv.payee_id?.toString() || 'NO_PAYEE',",[19454,19510],"payeeName: inv.payee?.name || 'Walk-in / Cash',",[19519,19568],"payeeType: inv.payee?.type || 'PATIENT',",[19577,19605],"total: totalAmount,",[19606,19628],"        isAR,",[19629,19655],"        arAmount,",[19656,19684],"        cashAmount,",[19685,19722],"        allocatedPayments: 0",[19723,19738],[19739,19751],[19752,19753],[19754,19787],"    // 4. Smart match Engine",[19788,19789],[19790,19886],"    // 🎯 PASS 1: GLOBAL Explicit Reference Match (Catches missing Payees from user errors)",[19887,19928],"    for (const pmt of allPayments) {",[19929,19975],"      if (pmt.remaining <= 0) continue",[19976,20024],"      for (const inv of invoiceObjects) {",[20025,20066],"        if (!inv.isAR) continue",[20067,20146],"        const remainingBalance = inv.arAmount - inv.allocatedPayments",[20147,20200],"        if (remainingBalance <= 0) continue",[20201,20202],[20203,20265],"        const invRef = inv.referenceNo.toUpperCase()",[20274,20336],"if (!invRef) continue // Skip if no reference exists",[20337,20338],[20339,20431],"        if (pmt.description.includes(invRef) || pmt.referenceNo.includes(invRef)) {",[20432,20513],"          const deduction = Math.min(pmt.remaining, remainingBalance)",[20514,20570],"          inv.allocatedPayments += deduction",[20571,20619],"          pmt.remaining -= deduction",[20628,20638],[20639,20653],[20654,20664],[20665,20666],[20667,20742],"    // 🎯 PASS 2: Exact Amount Match (Grouped strictly by exact Payee)",[20743,20784],[20785,20861],"      if (pmt.remaining <= 0 || pmt.payeeId === 'NO_PAYEE') continue",[20862,20910],[20919,20983],"if (!inv.isAR || inv.payeeId !== pmt.payeeId) continue",[20984,21063],[21064,21117],[21118,21119],[21120,21193],"        if (Math.abs(remainingBalance - pmt.remaining) < 0.01) {",[21194,21254],"          inv.allocatedPayments += pmt.remaining",[21255,21294],"          pmt.remaining = 0",[21305,21322],"break",[21323,21341],[21342,21356],[21357,21367],[21368,21369],[21370,21447],"    // 🎯 PASS 3: FIFO / Chronological (Grouped strictly by exact Payee)",[21448,21489],[21490,21566],[21567,21615],[21616,21688],"        if (!inv.isAR || inv.payeeId !== pmt.payeeId) continue",[21689,21768],[21769,21822],[21823,21824],[21825,21902],"        const deduction = Math.min(pmt.remaining, remainingBalance)",[21903,21955],"        inv.allocatedPayments += deduction",[21956,22000],"        pmt.remaining -= deduction",[22001,22002],[22003,22050],"        if (pmt.remaining <= 0) break",[22051,22065],[22066,22076],[22077,22078],[22079,22125],"    // 5. Build final status and balances",[22126,22178],"    const results = invoiceObjects.map((inv) => {",[22179,22205],"      let paid = 0",[22206,22235],"      let balance = 0",[22236,22271],"      let status = 'Unpaid'",[22272,22273],[22274,22303],"      if (!inv.isAR) {",[22312,22338],"paid = inv.total",[22347,22368],"balance = 0",[22369,22408],"        status = 'Fully Paid'",[22409,22430],[22439,22494],"paid = inv.cashAmount + inv.allocatedPayments",[22495,22572],"        balance = Math.max(0, inv.arAmount - inv.allocatedPayments)",[22573,22574],[22575,22615],"        if (balance <= 0.009) {",[22616,22649],"          balance = 0",[22650,22693],"          status = 'Fully Paid'",[22694,22772],"        } else if (inv.allocatedPayments > 0 || inv.cashAmount > 0) {",[22773,22820],[22821,22846],"        } else {",[22847,22886],"          status = 'Unpaid'",[22887,22905],[22906,22920],[22921,22922],[22923,22944],[22945,22973],[22974,23006],[23007,23053],"        referenceNo: inv.referenceNo,",[23054,23100],[23101,23143],"        payeeName: inv.payeeName,",[23144,23186],"        payeeType: inv.payeeType,",[23187,23221],"        total: inv.total,",[23222,23269],"        paid: Number(paid.toFixed(2)),",[23270,23323],"        balance: Number(balance.toFixed(2)),",[23324,23347],"        status",[23348,23363],[23364,23376],[23377,23378],[23379,23455],"    return results.sort((a, b) => b.date.getTime() - a.date.getTime())",[23456,23462],[23463,23464],[23465,23536],"  static async getCashFlowStatement(year?: number, month?: number) {",[23537,23569],[23570,23599],[23600,23654],[23655,23715],[23716,23726],[23727,23728],[23729,23807],"    const whereClause: any = { lines: { some: { account_id: '1010' } } }",{"messageId":"71332","fix":"71536","desc":"71334"},{"messageId":"71335","fix":"71537","desc":"71337"},[23808,23844],"    if (startDate || endDate) {",[23845,23880],"      whereClause.date = {}",[23881,23942],"      if (startDate) whereClause.date.gte = startDate",[23943,24000],"      if (endDate) whereClause.date.lte = endDate",[24001,24011],[24012,24013],[24014,24079],"    const cashEntries = await prisma.journalEntry.findMany({",[24080,24112],[24113,24208],"      include: { lines: { include: { account: { include: { account_type: true } } } } },",[24209,24246],[24247,24259],[24260,24261],[24262,24328],"    let operatingNet = 0,\n      investingNet = 0,\n      financingNet = 0",[24329,24433],"    const operatingDetails: any[] = [],\n      investingDetails: any[] = [],\n      financingDetails: any[] = []",{"messageId":"71332","fix":"71538","desc":"71334"},{"messageId":"71335","fix":"71539","desc":"71337"},{"messageId":"71332","fix":"71540","desc":"71334"},{"messageId":"71335","fix":"71541","desc":"71337"},{"messageId":"71332","fix":"71542","desc":"71334"},{"messageId":"71335","fix":"71543","desc":"71337"},[24434,24435],[24436,24479],"    for (const entry of cashEntries) {",[24480,24557],"      const cashLine = entry.lines.find((l) => l.account_id === '1010')",[24558,24595],"      if (!cashLine) continue",[24596,24597],[24598,24682],"      const netCashChange = Number(cashLine.debit) - Number(cashLine.credit)",[24683,24730],"      if (netCashChange === 0) continue",[24731,24732],[24733,24879],"      const offsetLine =\n        entry.lines.find(\n          (l) => l.account_id !== '1010' && (Number(l.debit) > 0 || Number(l.credit) > 0)\n        ) || entry.lines[0]",[24880,24934],"      const offsetAccount = offsetLine.account",[24935,24936],[24937,25057],"      const detail = {\n        id: entry.id,\n        date: entry.date,\n        description: entry.description,\n        amount: netCashChange",[25064,25151],"}\n\n      if (offsetAccount.code === '1500' || offsetAccount.name.includes('Equipment')) {",[25152,25199],"        investingDetails.push(detail)",[25200,25247],"        investingNet += netCashChange",[25248,25361],"      } else if (\n        offsetAccount.account_type.name === 'Equity' ||\n        offsetAccount.name.includes('Capital')",[25368,25409],") {\n        financingDetails.push(detail)",[25418,25457],"financingNet += netCashChange",[25458,25479],[25480,25527],"        operatingDetails.push(detail)",[25536,25575],"operatingNet += netCashChange",[25576,25590],[25591,25601],[25602,25603],[25604,25682],"    const netIncreaseInCash = operatingNet + investingNet + financingNet",[25683,25684],[25685,25702],[25703,25795],"      operating: { details: operatingDetails, net: Number(operatingNet.toFixed(2)) },",[25796,25888],"      investing: { details: investingDetails, net: Number(investingNet.toFixed(2)) },",[25889,25981],"      financing: { details: financingDetails, net: Number(financingNet.toFixed(2)) },",[25988,26051],"netIncreaseInCash: Number(netIncreaseInCash.toFixed(2))",[26052,26063],[26064,26070],[26072,26072],[40,41],[84,86],[87,88],[153,154],[157,269],"// We use the current year and quarter based on the dates of transactions you posted earlier (June 2026 = Q2)",[270,300],"  const currentYear = 2026",[301,351],"  const currentQuarter = 2 // April, May, June",[352,423],"  const currentMonth = 5 // May (Middle of Q2 for 0619-E testing)",[424,425],[426,516],"  test('🏛️ Form 2550Q: Should calculate exact 12% Output and Input VAT', async () => {",[521,604],"const form2550Q = await TaxService.generate2550Q(currentYear, currentQuarter)",[605,606],[607,680],"    // VAT Math Check: Output VAT + Net Sales MUST equal Gross Sales",[681,760],"    const totalSalesValidation = form2550Q.netSales + form2550Q.outputVat",[761,875],"    expect(totalSalesValidation).toBeCloseTo(form2550Q.grossSales, 1) // Allow 1 centavo rounding difference",[876,877],[882,964],"const totalPurchasesValidation = form2550Q.netPurchases + form2550Q.inputVat",[965,1048],"    expect(totalPurchasesValidation).toBeCloseTo(form2550Q.grossPurchases, 1)",[1049,1050],[1051,1112],"    // Net VAT Payable must equal Output VAT - Input VAT",[1113,1211],"    expect(form2550Q.netVatPayable).toBeCloseTo(form2550Q.outputVat - form2550Q.inputVat, 1)",[1212,1220],[1221,1222],[1223,1319],"  test('🧾 Form 0619-E: Should extract monthly Expanded Withholding Tax (EWT)', async () => {",[1320,1405],"    const form0619E = await TaxService.generate0619E(currentYear, currentMonth)",[1406,1407],[1408,1479],"    // Ensure the correct properties are returned from the backend",[1480,1537],"    expect(form0619E).toHaveProperty('ewtWithheld')",[1538,1591],"    expect(form0619E).toHaveProperty('qapList')",[1592,1653],"    expect(Array.isArray(form0619E.qapList)).toBe(true)",[1654,1655],[1656,1735],"    // EWT Math Check: The sum of taxes in the individual Alphalist (QAP)",[1736,1798],"    // MUST perfectly match the grand total EWT withheld.",[1799,1843],"    if (form0619E.qapList.length > 0) {",[1844,1959],"      const sumOfQapTaxes = form0619E.qapList.reduce(\n        (acc: number, curr: any) => acc + curr.taxWithheld,\n        0",{"messageId":"71332","fix":"71544","desc":"71334"},{"messageId":"71335","fix":"71545","desc":"71337"},[1966,2033],")\n      expect(sumOfQapTaxes).toBeCloseTo(form0619E.ewtWithheld, 1)",[2034,2044],[2045,2053],[2054,2055],[2058,2148],"test('📑 Relief Annexes: Should extract transactions assigned to payees', async () => {",[2149,2242],"    const annexes = await TaxService.generateReliefAnnexes(currentYear, currentQuarter)",[2243,2244],[2245,2309],"    // We know you posted a \"Meralco\" disbursement earlier!",[2310,2361],"    // It should appear in Annex B (Purchases)",[2362,2437],"    expect(annexes.annexB_Purchases.length).toBeGreaterThanOrEqual(0)",[2438,2439],[2440,2491],"    if (annexes.annexB_Purchases.length > 0) {",[2492,2556],"      const samplePurchase = annexes.annexB_Purchases[0]",[2557,2615],"      expect(samplePurchase).toHaveProperty('tin')",[2616,2674],"      expect(samplePurchase).toHaveProperty('tax')",[2675,2676],[2677,2719],"      // Net + Tax must equal Gross",[2720,2830],"      expect(samplePurchase.netAmount + samplePurchase.tax).toBeCloseTo(\n        samplePurchase.grossAmount,\n        1",[2837,2850],")\n    }\n  })",[2853,2854],[35,36],[82,84],[85,86],[120,122],[123,124],[150,151],[154,192],"// 1. VAT REPORT (Form 2550Q)",[193,257],"  static async generate2550Q(year: number, quarter: number) {",[258,272],[279,323],"const startMonth = (quarter - 1) * 3",[324,385],"      const startDate = new Date(year, startMonth, 1)",[386,466],"      const endDate = new Date(year, startMonth + 3, 0, 23, 59, 59, 999)",[467,468],[469,540],"      const outputVatLines = await prisma.journalLine.findMany({",[541,675],"        where: {\n          account_id: '2020',\n          credit: { gt: 0 },\n          entry: { date: { gte: startDate, lte: endDate }, status: 'ACTIVE' }",[676,692],[699,791],"})\n      const outputVat = outputVatLines.reduce((sum, line) => sum + Number(line.credit), 0)",[792,793],[794,849],"      let vatableSales = 0\n      let exemptSales = 0",[850,920],"      const salesEntries = await prisma.journalEntry.findMany({",[921,1073],"        where: {\n          date: { gte: startDate, lte: endDate },\n          status: 'ACTIVE',\n          lines: { some: { account_id: { in: ['4010', '4020', '4040'] } } }",[1082,1115],"},\n        include: { lines: true }",[1116,1132],[1133,1134],[1135,1179],"      salesEntries.forEach((entry) => {",[1180,1262],"        const isVatable = entry.lines.some((l) => l.account_id === '2020')",[1263,1374],"        const revenueLines = entry.lines.filter((l) =>\n          ['4010', '4020', '4040'].includes(l.account_id)",[1383,1473],")\n        const revenueAmount = revenueLines.reduce((sum, l) => sum + Number(l.credit), 0)",[1474,1475],[1476,1538],"        if (isVatable) vatableSales += revenueAmount",[1547,1590],"else exemptSales += revenueAmount",[1591,1607],[1608,1609],[1610,1667],"      const netSales = vatableSales + exemptSales",[1668,1721],"      const grossSales = netSales + outputVat",[1722,1723],[1730,1794],"const inputVatLines = await prisma.journalLine.findMany({",[1803,1928],"where: {\n          account_id: '1140',\n          debit: { gt: 0 },\n          entry: { date: { gte: startDate, lte: endDate }, status: 'ACTIVE' }",[1929,1945],[1952,2041],"})\n      const inputVat = inputVatLines.reduce((sum, line) => sum + Number(line.debit), 0)",[2042,2043],[2044,2117],"      const purchaseEntries = await prisma.journalEntry.findMany({",[2126,2244],"where: {\n          date: { gte: startDate, lte: endDate },\n          status: 'ACTIVE',\n          lines: { some: { account_id: '1140' } }",[2253,2286],[2287,2303],[2304,2305],[2306,2344],"      let vatablePurchases = 0",[2345,2392],"      purchaseEntries.forEach((entry) => {",[2393,2557],"        const expenseLines = entry.lines.filter(\n          (l) =>\n            l.account_id !== '1140' &&\n            l.account_id !== '1010' &&\n            l.account_id !== '2010' &&\n            Number(l.debit) > 0",[2566,2653],")\n        vatablePurchases += expenseLines.reduce((sum, l) => sum + Number(l.debit), 0)",[2654,2670],[2671,2672],[2673,2724],"      const netPurchases = vatablePurchases",[2725,2785],"      const grossPurchases = netPurchases + inputVat",[2786,2787],[2788,2853],"      const cwtLines = await prisma.journalLine.findMany({",[2862,2987],"where: {\n          account_id: '1150',\n          debit: { gt: 0 },\n          entry: { date: { gte: startDate, lte: endDate }, status: 'ACTIVE' }",[2988,3004],[3011,3108],"})\n      const creditableVatWithheld = cwtLines.reduce((sum, line) => sum + Number(line.debit), 0)",[3109,3189],"      const netVatPayable = outputVat - inputVat - creditableVatWithheld",[3190,3191],[3192,3438],"      return {\n        grossSales,\n        netSales,\n        vatableSales,\n        exemptSales,\n        outputVat,\n        grossPurchases,\n        netPurchases,\n        vatablePurchases,\n        inputVat,\n        creditableVatWithheld,\n        netVatPayable\n      }\n    } catch (error: any) {\n      return { error: error.message }",{"messageId":"71332","fix":"71546","desc":"71334"},{"messageId":"71335","fix":"71547","desc":"71337"},[3444,3447],[3450,3496],"}\n\n  // 2. RELIEF / DAT FILE GENERATOR (Annex B)",[3499,3569],"static async generateReliefAnnexes(year: number, quarter: number) {",[3570,3584],[3585,3635],"      const startMonth = (quarter - 1) * 3",[3636,3697],[3704,3778],"const endDate = new Date(year, startMonth + 3, 0, 23, 59, 59, 999)",[3779,3780],[3781,3854],[3863,3981],[3990,4036],"},\n        include: { lines: true, payee: true }",[4037,4053],[4054,4055],[4056,4104],"      const annexB_Purchases: any[] = []",{"messageId":"71332","fix":"71548","desc":"71334"},{"messageId":"71335","fix":"71549","desc":"71337"},[4105,4152],[4153,4238],"        const inputVatLine = entry.lines.find((l) => l.account_id === '1140')",[4239,4282],"        if (!inputVatLine) return",[4283,4339],"        const tax = Number(inputVatLine.debit)",[4340,4450],"        const expenseLines = entry.lines.filter(\n          (l) => l.account_id !== '1140' && Number(l.debit) > 0",[4459,4544],")\n        const netAmount = expenseLines.reduce((sum, l) => sum + Number(l.debit), 0)",[4545,4546],[4547,4769],"        annexB_Purchases.push({\n          date: entry.date,\n          supplierName: entry.payee?.name || 'Unknown Supplier',\n          tin: entry.payee?.tin || '000-000-000-000',\n          netAmount: netAmount,\n          tax: tax,\n          grossAmount: netAmount + tax",[4770,4786],[4793,4828],"})\n      return { annexB_Purchases }",[4829,4895],"    } catch (error: any) {\n      return { error: error.message }",{"messageId":"71332","fix":"71550","desc":"71334"},{"messageId":"71335","fix":"71551","desc":"71337"},[4901,4904],[4907,4962],"}\n\n  // 3. MONTHLY EXPANDED WITHHOLDING TAX (Form 0619-E)",[4963,5025],"  static async generate0619E(year: number, month: number) {",[5030,5040],[5041,5101],"      const startDate = new Date(year, month - 1, 1)",[5102,5173],"      const endDate = new Date(year, month, 0, 23, 59, 59, 999)",[5174,5175],[5176,5241],"      const ewtLines = await prisma.journalLine.findMany({",[5250,5377],"where: {\n          account_id: '2050',\n          credit: { gt: 0 },\n          entry: { date: { gte: startDate, lte: endDate }, status: 'ACTIVE' }",[5386,5456],"},\n        // 🔥 THE FIX: Added `lines: true` below to prevent the crash",[5457,5535],"        include: { entry: { include: { payee: true, lines: true } } }",[5536,5552],[5553,5554],[5555,5615],"      let ewtWithheld = 0\n      const qapList: any[] = []",{"messageId":"71332","fix":"71552","desc":"71334"},{"messageId":"71335","fix":"71553","desc":"71337"},[5616,5659],"      for (const line of ewtLines) {",[5660,5712],"        ewtWithheld += Number(line.credit)",[5713,5798],"        const expenseLine = line.entry.lines.find((l) => Number(l.debit) > 0)",[5799,5830],"        qapList.push({",[5831,5971],"          date: line.entry.date,\n          payeeName: line.entry.payee?.name || 'Unknown',\n          tin: line.entry.payee?.tin || '000-000-000-000',",[5972,6097],"          atc: 'WI010',\n          grossAmount: expenseLine ? Number(expenseLine.debit) : 0,\n          taxWithheld: Number(line.credit)",[6106,6118],[6119,6133],[6134,6179],"      return { ewtWithheld, qapList }",[6180,6246],{"messageId":"71332","fix":"71554","desc":"71334"},{"messageId":"71335","fix":"71555","desc":"71337"},[6252,6255],[6258,6325],"}\n\n  // 4. QUARTERLY EXPANDED WITHHOLDING TAX (Form 1601-EQ / 1604-E)",[6326,6391],"  static async generate1601EQ(year: number, quarter: number) {",[6392,6406],[6407,6443],"      let startDate, endDate",[6444,6499],"      if (quarter === 0) {\n        // Annual Form 1604-E",[6500,6550],"        startDate = new Date(year, 0, 1)",[6551,6618],"        endDate = new Date(year, 11, 31, 23, 59, 59, 999)",[6625,6640],"} else {",[6641,6695],"        const startMonth = (quarter - 1) * 3",[6696,6755],"        startDate = new Date(year, startMonth, 1)",[6756,6834],"        endDate = new Date(year, startMonth + 3, 0, 23, 59, 59, 999)",[6835,6849],[6850,6851],[6852,6917],[6926,7053],[7062,7132],"},\n        include: { entry: { include: { payee: true, lines: true } } }",[7133,7149],[7150,7151],[7152,7212],{"messageId":"71332","fix":"71556","desc":"71334"},{"messageId":"71335","fix":"71557","desc":"71337"},[7213,7256],[7257,7309],[7310,7395],[7396,7427],[7428,7568],[7569,7694],[7695,7715],[7716,7730],[7731,7776],[7777,7843],{"messageId":"71332","fix":"71558","desc":"71334"},{"messageId":"71335","fix":"71559","desc":"71337"},[7849,7850],[7851,7852],"  }\n}\n",[45,47],[80,82],[83,84],[118,120],[121,122],[151,152],[153,179],"  async getAllUsers() {",[180,231],"    const users = await prisma.user.findMany({",[232,330],"      select: { id: true, username: true, role: true, is_active: true, permissions: true },",[331,372],"      orderBy: { username: 'asc' }",[373,385],[386,395],[396,479],"    // 🔥 Safely parse the JSON permissions so the checkboxes actually render!",[480,512],"    return users.map((u) => {",[513,547],"      let parsedPerms = []",[548,581],"      if (u.permissions) {",[582,604],"        try {",[605,718],"          parsedPerms =\n            typeof u.permissions === 'string' ? JSON.parse(u.permissions) : u.permissions",[719,769],"        } catch (e) {\n          parsedPerms = []",[770,784],[791,840],"}\n      return { ...u, permissions: parsedPerms }",[845,853],[854,861],[862,863],[866,898],"async createUser(data: any) {",{"messageId":"71332","fix":"71560","desc":"71334"},{"messageId":"71335","fix":"71561","desc":"71337"},[899,985],"    const hash = crypto.createHash('sha256').update(data.password).digest('hex')",[986,1028],"    return await prisma.user.create({",[1029,1049],[1050,1091],"        username: data.username,",[1092,1129],"        password_hash: hash,",[1130,1163],"        role: data.role,",[1164,1206],"        is_active: data.isActive,",[1207,1259],"        permissions: data.permissions || []",[1260,1274],[1279,1287],[1288,1295],[1296,1297],[1300,1358],"async toggleUserStatus(id: string, isActive: boolean) {",[1359,1450],"    return await prisma.user.update({ where: { id }, data: { is_active: isActive } })",[1451,1458],[1459,1460],[1461,1520],"  async resetPassword(id: string, newPassword: string) {",[1521,1605],"    const hash = crypto.createHash('sha256').update(newPassword).digest('hex')",[1606,1697],"    return await prisma.user.update({ where: { id }, data: { password_hash: hash } })",[1698,1705],[1706,1707],[1710,1777],"async updateUserPermissions(id: string, permissions: string[]) {",[1778,1831],"    // 🔥 Save the raw array directly to the DB!",[1832,1875],"    return await prisma.user.update({",[1876,1904],"      where: { id },",[1905,1953],"      data: { permissions: permis