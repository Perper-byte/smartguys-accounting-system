,"fix":"71672","desc":"71334"},{"messageId":"71335","fix":"71673","desc":"71337"},[685,736],[737,795],"  const [errorMessage, setErrorMessage] = useState('')",[796,801],[802,845],"  // 🔥 ADDED '0619E' to the view states",[846,934],"  const [view, setView] = useState<'2550Q' | '0619E' | '1601EQ' | 'relief'>('2550Q')",[935,936],[937,976],"  const fetchTaxData = async () => {",[977,1003],[1008,1033],"setErrorMessage('')",[1034,1048],[1049,1125],{"messageId":"71332","fix":"71674","desc":"71334"},{"messageId":"71335","fix":"71675","desc":"71337"},{"messageId":"71332","fix":"71676","desc":"71334"},{"messageId":"71335","fix":"71677","desc":"71337"},[1126,1127],[1128,1167],"      // 1. Monthly EWT (0619-E)",[1168,1204],"      if (view === '0619E') {",[1205,1298],"        if (!api?.generate0619E) throw new Error('Missing backend API for 0619-E.')",[1299,1366],"        const data = await api.generate0619E(year, month)",[1375,1429],"if (data?.error) throw new Error(data.error)",[1430,1464],"        setTaxData(data)",[1465,1502],"        setReliefData(null)",[1503,1518],[1519,1570],"      // 2. Quarterly EWT (1601-EQ / 1604-E)",[1571,1613],"      else if (view === '1601EQ') {",[1614,1709],"        if (!api?.generate1601EQ) throw new Error('Missing backend API for 1601-EQ.')",[1710,1780],"        const data = await api.generate1601EQ(year, quarter)",[1781,1843],"        if (data?.error) throw new Error(data.error)",[1844,1878],[1879,1916],[1923,1931],[1932,1981],"      // 3. Quarterly VAT & RELIEF (2550Q)",[1982,2001],"      else {",[2002,2069],"        if (!api?.generate2550Q || !api?.generateRelief) {",[2070,2138],"          throw new Error('Tax service is unavailable.')",[2139,2157],[2158,2225],"        const [data2550, dataRelief] = await Promise.all([",[2226,2280],"          api.generate2550Q(year, quarter),",[2291,2335],"api.generateRelief(year, quarter)",[2336,2356],"        ])",[2357,2358],[2359,2472],"        if (data2550?.error || dataRelief?.error)\n          throw new Error(data2550?.error || dataRelief?.error)",[2473,2511],"        setTaxData(data2550)",[2512,2555],"        setReliefData(dataRelief)",[2562,2570],[2571,2600],{"messageId":"71332","fix":"71678","desc":"71334"},{"messageId":"71335","fix":"71679","desc":"71337"},[2601,2633],"      console.error(err)",[2634,2664],"      setTaxData(null)",[2665,2698],"      setReliefData(null)",[2699,2798],"      setErrorMessage(err?.message || 'Unable to retrieve the tax report for this period.')",[2799,2819],[2820,2851],[2852,2862],[2863,2870],[2871,2872],[2873,2936],"  // Refetch data when year, quarter, month, or view changes",[2937,2959],[2960,2984],"    fetchTaxData()",[2985,3023],"  }, [year, quarter, month, view])",{"desc":"71680","fix":"71681"},[3024,3025],[3026,3091],"  const formatCurrency = (val: number | null | undefined) => {",[3092,3136],"    if (!val || val === 0) return null",[3137,3246],"    return `₱ ${val.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`",[3247,3254],[3255,3256],[3257,3293],"  const handleExportPDF = () => {",[3294,3318],"    window.print()",[3319,3326],[3327,3328],[3329,3368],"  const handleDownloadSLSP = () => {",[3369,3474],"    if (!reliefData || reliefData.annexB_Purchases.length === 0) return alert('No data available.')",[3475,3543],"    const lines = reliefData.annexB_Purchases.map((p: any) => {",{"messageId":"71332","fix":"71682","desc":"71334"},{"messageId":"71335","fix":"71683","desc":"71337"},[3544,3629],"      const tinClean = p.tin.replace(/-/g, '').padEnd(9, '0').substring(0, 9)",[3630,3760],"      return `P,${tinClean},0000,\"${p.supplierName}\",\"\",\"\",${p.grossAmount.toFixed(2)},${p.tax.toFixed(2)},0.00,0.00,0.00`",[3761,3773],[3774,3775],[3776,3897],"    const fileName =\n      quarter === 0 ? `SLSP_Annual_${year}_Purchases.dat` : `SLSP_Q${quarter}_${year}_Purchases.dat`",[3898,3951],"    triggerDownload(lines.join('\\n'), fileName)",[3952,3959],[3960,3961],[3962,4000],"  const handleDownloadQAP = () => {",[4001,4115],"    if (!taxData || !taxData.qapList || taxData.qapList.length === 0)\n      return alert('No EWT data available.')",[4116,4172],"    const lines = taxData.qapList.map((p: any) => {",{"messageId":"71332","fix":"71684","desc":"71334"},{"messageId":"71335","fix":"71685","desc":"71337"},[4173,4258],[4259,4385],"      return `D1,${tinClean},0000,\"${p.payeeName}\",\"${p.atc}\",${p.grossAmount.toFixed(2)},${p.taxWithheld.toFixed(2)}`",[4386,4398],[4399,4400],[4401,4513],"    const fileName =\n      quarter === 0 ? `QAP_1604E_Annual_${year}.dat` : `QAP_1601EQ_Q${quarter}_${year}.dat`",[4514,4567],[4568,4575],[4576,4577],[4578,4647],"  const triggerDownload = (content: string, filename: string) => {",[4648,4729],"    const blob = new Blob([content], { type: 'text/plain;charset=utf-8;' })",[4730,4777],"    const url = URL.createObjectURL(blob)",[4778,4828],"    const link = document.createElement('a')",[4829,4895],"    link.href = url\n    link.setAttribute('download', filename)",[4896,4984],"    document.body.appendChild(link)\n    link.click()\n    document.body.removeChild(link)",[4985,4992],[4993,4994],[4997,5027],"// Helper to get month name",[5028,5133],"  const getMonthName = (m: number) =>\n    new Date(0, m - 1).toLocaleString('default', { month: 'long' })",[5134,5135],[5136,5149],[5150,5285],"    <div className=\"w-full h-full flex items-center justify-center p-4 lg:p-8 bg-gray-50/30 print:p-0 print:bg-white print:block\">",[5286,5484],"      <div className=\"w-full max-w-5xl h-full bg-white border border-transparent rounded-xl p-8 shadow-sm flex flex-col font-sans text-gray-800 print:shadow-none print:border-none print:p-0\">",[5485,5529],"        {/* HEADER & CONTROLS */}",[5530,5653],"        <div className=\"flex justify-between items-end mb-6 border-b border-[#B0DCDA] pb-6 print:hidden shrink-0\">",[5654,5680],[5681,5797],"            <h2 className=\"text-2xl font-extrabold text-gray-800 tracking-wide\">\n              BIR Tax Compliance",[5810,5924],"</h2>\n            <p className=\"text-sm text-gray-500 mt-1 font-medium\">\n              EOPT-Ready Tax Summaries and DAT Generators",[5937,5952],"</p>\n          </div>",[5953,5954],[5955,6018],"          <div className=\"flex space-x-4 items-end\">",[6019,6049],"            <div>",[6050,6189],"              <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                Year\n              </label>",[6204,6456],"<input\n                type=\"number\"\n                value={year}\n                onChange={(e) => setYear(Number(e.target.value))}\n                className=\"w-24 bg-white border border-gray-300 rounded-md p-2 text-sm text-gray-800 font-bold focus:border-[#1B9387] outline-none shadow-sm transition\"",[6471,6488],"/>\n            </div>",[6489,6519],[6520,6661],"              <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                Period",[6676,6773],"</label>\n              {/* 🔥 DYNAMIC DROPDOWN: Shows Months for 0619-E, Quarters for everything else */}",[6788,6824],"{view === '0619E' ? (",[6841,7097],"<select\n                  value={month}\n                  onChange={(e) => setMonth(Number(e.target.value))}\n                  className=\"w-40 bg-white border border-gray-300 rounded-md p-2 text-sm text-gray-800 font-bold focus:border-[#1B9387] outline-none cursor-pointer shadow-sm transition\"",[7114,7190],">\n                  {Array.from({ length: 12 }, (_, i) => i + 1).map((m) => (",[7191,7284],"                    <option key={m} value={m}>\n                      {getMonthName(m)}",[7305,7325],"</option>\n                  ))}",[7326,7368],"                </select>",[7369,7403],"              ) : (",[7420,7680],"<select\n                  value={quarter}\n                  onChange={(e) => setQuarter(Number(e.target.value))}\n                  className=\"w-40 bg-white border border-gray-300 rounded-md p-2 text-sm text-gray-800 font-bold focus:border-[#1B9387] outline-none cursor-pointer shadow-sm transition\"",[7697,7757],">\n                  <option value={1}>Q1 (Jan-Mar)</option>",[7758,7834],"                  <option value={2}>Q2 (Apr-Jun)</option>",[7835,7911],"                  <option value={3}>Q3 (Jul-Sep)</option>",[7912,7988],"                  <option value={4}>Q4 (Oct-Dec)</option>",[7989,8071],"                  <option value={0}>Annual (Full Year)</option>",[8088,8114],"</select>",[8115,8146],"              )}",[8147,8178],[8191,8450],"<button\n              onClick={handleExportPDF}\n              className=\"px-5 py-2 h-[38px] bg-white hover:bg-gray-50 border border-gray-300 text-xs font-bold text-gray-700 rounded-md tracking-wider uppercase transition flex items-center space-x-2 shadow-sm cursor-pointer\"",[8463,8520],">\n              <span>🖨️</span> <span>Print Form</span>",[8521,8555],"            </button>",[8556,8583],[8584,8607],[8608,8609],[8610,8647],"        {/* UNIFIED TABS */}",[8648,8795],"        <div className=\"flex flex-wrap bg-[#FBF8F8] p-1 rounded-lg border border-[#B0DCDA] shadow-inner w-fit mb-6 print:hidden shrink-0\">",[8806,9078],"<button\n            onClick={() => setView('2550Q')}\n            className={`px-5 py-2 text-xs font-bold rounded-md transition uppercase tracking-wider cursor-pointer ${view === '2550Q' ? 'bg-[#1B9387] text-white shadow-md' : 'text-gray-500 hover:text-[#1B9387] hover:bg-[#E9FAFA]'}`}",[9089,9120],">\n            Form 2550Q (VAT)",[9121,9151],[9162,9434],"<button\n            onClick={() => setView('0619E')}\n            className={`px-5 py-2 text-xs font-bold rounded-md transition uppercase tracking-wider cursor-pointer ${view === '0619E' ? 'bg-[#1B9387] text-white shadow-md' : 'text-gray-500 hover:text-[#1B9387] hover:bg-[#E9FAFA]'}`}",[9445,9485],">\n            Form 0619-E (Monthly EWT)",[9486,9516],[9527,9801],"<button\n            onClick={() => setView('1601EQ')}\n            className={`px