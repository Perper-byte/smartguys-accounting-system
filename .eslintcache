",[2623,2644],"    // 1. Search",[2649,2698],"const searchStr = searchQuery.toLowerCase()",[2699,2730],"    const matchesSearch =",[2731,2803],"      entry.reference_no?.toLowerCase().includes(searchStr) ||",[2804,2875],"      entry.payee?.name?.toLowerCase().includes(searchStr) ||",[2876,2944],"      entry.description?.toLowerCase().includes(searchStr)",[2945,2946],[2947,2989],"    if (!matchesSearch) return false",[2990,2991],[2992,3034],"    // 2. Top Tabs (Manual vs System)",[3035,3139],"    const isManual = entry.reference_no.startsWith('JV-') || entry.reference_no.startsWith('ADJ-')",[3140,3203],"    if (activeTab === 'MANUAL' && !isManual) return false",[3204,3266],"    if (activeTab === 'SYSTEM' && isManual) return false",[3267,3268],[3269,3307],"    // 3. 🔥 NEW: Status Sub-Tabs",[3308,3387],"    if (statusTab === 'ACTIVE' && entry.status !== 'ACTIVE') return false",[3388,3467],"    if (statusTab === 'VOIDED' && entry.status !== 'VOIDED') return false",[3468,3581],"    if (statusTab === 'DRAFTS' && entry.status !== 'DRAFT' && entry.status !== 'PENDING_VOID')\n      return false",[3582,3583],[3584,3605],"    return true",[3606,3614],[3615,3616],[3617,3667],"  // ==========================================",[3668,3697],"  // VIEW 1: CREATION FORM",[3698,3748],[3749,3774],"  if (isCreatingNew) {",[3775,3792],"    return (",[3793,3872],"      <div className=\"w-full min-h-[calc(100vh-64px)] p-6 bg-[#f9fafb]\">",[3873,3930],"        <div className=\"max-w-4xl mx-auto mb-4\">",[3931,3960],[3961,4025],"            onClick={() => setIsCreatingNew(false)}",[4026,4150],"            className=\"text-gray-500 hover:text-[#1B9387] font-bold text-sm transition flex items-center gap-2\"",[4151,4173],[4174,4221],"            ← Back to All Journals",[4222,4252],[4253,4276],[4277,4350],"        <JournalEntryForm userId={userId} isAdjusting={false} />",[4351,4370],[4371,4382],[4385,4389],[4390,4391],[4392,4442],[4445,4471],"// VIEW 2: LIST & MODAL",[4472,4522],[4525,4536],[4537