E: DIGITAL LOGBOOK */}",[14854,14987],"        <div className=\"w-2/3 bg-white border border-[#B0DCDA] rounded-xl shadow-sm flex flex-col overflow-hidden relative\">",[14988,15027],"          {!selectedItem ? (",[15028,15149],"            <div className=\"flex-1 flex flex-col justify-center items-center text-center p-12 bg-[#FBF8F8]\">",[15150,15255],"              <ClipboardList className=\"text-gray-300 w-16 h-16 mb-4\" strokeWidth={1.5} />",[15256,15373],"              <p className=\"text-gray-800 font-extrabold text-xl\">\n                Select a product to view logbook",[15388,15545],"</p>\n              <p className=\"text-gray-500 font-medium text-sm mt-2 max-w-md\">\n                Click any item on the left to record incoming deliveries or outgoing usage.",[15560,15577],[15578,15604],"          ) : (",[15605,15632],"            <>",[15633,15699],"              {/* HEADER - DISPLAY OR EDIT MODE */}",[15700,15831],"              <div\n                className={`p-6 border-b-2 border-gray-800 shrink-0 ${isEditing ? 'bg-[#FBF8F8]' : 'bg-white'}`}",[15846,15879],">\n                {isEditing ? (",[15898,16005],"<form\n                    onSubmit={handleUpdateItem}\n                    className=\"space-y-4 animate-in fade-in duration-200\"",[16024,16103],[16104,16248],"                      <h3 className=\"text-lg font-black text-gray-800 uppercase tracking-widest flex items-center gap-2\">",[16249,16364],"                        <Edit size={18} className=\"text-[#1B9387]\" /> Edit Product Details",[16365,16415],"                      </h3>",[16416,16463],[16464,16545],"                    <div className=\"grid grid-cols-2 gap-4\">",[16546,16596],[16597,16757],"                        <label className=\"block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1\">\n                          Product Name\n                        </label>",[16782,17063],"<input\n                          required\n                          value={editItem.name}\n