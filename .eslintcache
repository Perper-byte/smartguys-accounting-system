1004],[1005,1059],"      const txDate = new Date(line.entry.date)",[1060,1148],"      // Safely check if txDate is before startDate (if a startDate was provided)",[1149,1219],"      const isPrior = startDate ? txDate < startDate : false",[1220,1287],"      const isRevenue = acc.account_type.name === 'Revenue'",[1288,1355],"      const isExpense = acc.account_type.name === 'Expense'",[1356,1357],[1358,1404],"      const debit = Number(line.debit)",[1411,1453],"const credit = Number(line.credit)",[1454,1455],[1462,1483],"if (isPrior) {",[1484,1549],"        if (isRevenue) priorRevenue += credit - debit",[1558,1615],"if (isExpense) priorExpense += debit - credit",[1616,1664],"        if (!isRevenue && !isExpense) {",[1665,1709],"          acc.sumDebits += debit",[1710,1756],"          acc.sumCredits += credit",[1757,1775],[1776,1797],"      } else {",[1798,1838],"        acc.sumDebits += debit",[1839,1881],"        acc.sumCredits += credit",[1882,1896],[1897,1907],[1908,1909],[1910,1970],"    const priorNetIncome = priorRevenue - priorExpense",[1971,2007],"    if (priorNetIncome !== 0) {",[2008,2102],"      const equityAccCode = accounts.find((a) => a.account_type.name === 'Equity')?.code",[2103,2160],"      if (equityAccCode && tbMap[equityAccCode]) {",[2161,2252],"        if (priorNetIncome > 0) tbMap[equityAccCode].sumCredits += priorNetIncome",[2253,2334],"        else tbMap[equityAccCode].sumDebits += Math.abs(priorNetIncome)",[2335,2349],[2354,2360],[2361,2362],[2363,2408],"    const trialBalanceLines: any[] = []",{"messageId":"71332","fix":"71512","desc":"71334"},{"messageId":"71335","fix":"71513","desc":"71337"},[2409,2438],"    let totalDebits = 0",[2443,2469],"let totalCredits = 0",[2470,2471],[2472,2508],"    for (const code in tbMap) {",[2509,2546],"      const acc = tbMap[code]",[2547,2614],"      const normalBalance = acc.account_type.normal_balance",[2615,2645],"      let netDebit = 0",[2646,2677],"      let netCredit = 0",[2678,2679],[2680,2725],"      