-6 text-right font-mono tabular-nums text-gray-800\">",[11893,12049],"                          {creditStr ? (\n                            <span className=\"font-bold\">{creditStr}</span>",[12076,12155],") : (\n                            <span className=\"text-gray-300\">-</span>\n                          )}\n                        </td>",[12178,12239],"</tr>\n                    )\n                  })",[12240,12275],"                )}",[12276,12313],"              </tbody>",[12314,12347],"            </table>",[12348,12375],[12376,12377],[12378,12427],"          {/* STICKY FOOTER TOTALS */}",[12428,12594],"          <div className=\"bg-[#FBF8F8] border-t border-[#B0DCDA] p-5 px-6 flex justify-end space-x-16 shadow-[0_-5px_15px_rgba(0,0,0,0.02)] shrink-0 z-20\">",[12595,12665],"            <div className=\"flex items-center space-x-4\">",[12666,12798],"              <span className=\"text-gray-500 font-extrabold uppercase tracking-widest text-[10px]\">\n                Total Debit",[12813,13035],"</span>\n              <span className=\"text-gray-800 font-mono font-black text-xl tabular-nums\">\n                ₱{' '}\n                {totalDebit.toLocaleString('en-US', {\n                  minimumFractionDigits: 2,\n                  maximumFractionDigits: 2\n                })}\n              </span>",[13048,13106],"</div>\n            <div className=\"flex items-center space-x-4\">",[13107,13240],"              <span className=\"text-gray-500 font-extrabold uppercase tracking-widest text-[10px]\">\n                Total Credit",[13255,13446],"</span>\n              <span className=\"text-gray-800 font-mono font-black text-xl tabular-nums\">\n                ₱{' '}\n                {totalCredit.toLocaleString('en-US', {\n                  minimumFractionDigits: 2,\n                  maximumFractionDigits: 2",[13447,13506],"                })}\n              </span>\n            </div>",[13517,13530],"</div>\n        </div>",[13531,13552],[13553,13568],[13569,13576],[13578,13578],[55,56],[87,89],[142,144],[196,198],[199,200],[233,337],[338,339],[423,424],[425,449],"  // Dropdowns & Data",[450,521],"  const [expenseAccounts, setExpenseAccounts] = useState<any[]>([])",{"messageId":"71332","fix":"71704","desc":"71334"},{"messageId":"71335","fix":"71705","desc":"71337"},[522,587],"  const [cashAccounts, setCashAccounts] = useState<any[]>([])",{"messageId":"71332","fix":"71706","desc":"71334"},{"messageId":"71335","fix":"71707","desc":"71337"},[588,641],{"messageId":"71332","fix":"71708","desc":"71334"},{"messageId":"71335","fix":"71709","desc":"71337"},[642,711],"  const [recentVouchers, setRecentVouchers] = useState<any[]>([])",{"messageId":"71332","fix":"71710","desc":"71334"},{"messageId":"71335","fix":"71711","desc":"71337"},[712,713],[714,745],"  // Section 1: Payment Info",[746,806],[807,855],[856,911],"  // 🔥 Default to empty to force explicit selection",[912,1008],"  const [paymentMethod, setPaymentMethod] = useState<'check' | 'transfer' | 'cash' | ''>('')",[1009,1065],[1066,1067],[1068,1105],"  // Section 2: Accounting Details",[1108,1166],"const [sourceAccount, setSourceAccount] = useState('')",[1167,1229],"  const [expenseAccount, setExpenseAccount] = useState('')",[1230,1289],"  const [amount, setAmount] = useState<number | ''>('')",[1290,1345],"  const [isVatable, setIsVatable] = useState(false)",[1346,1396],"  const [payeeTin, setPayeeTin] = useState('')",[1397,1398],[1399,1433],"  // Section 3: Supporting Info",[1434,1482],"  const [remarks, setRemarks] = useState('')",[1483,1547],[1548,1549],[1550,1567],"  // UI States",[1570,1643],"const [isPayeeDropdownOpen, setIsPayeeDropdownOpen] = useState(false)",[1644,1710],[1711,1772],"  const [showAddPayee, setShowAddPayee] = useState(false)",[1773,1842],"  const [showConfirmModal, setShowConfirmModal] = useState(false)",[1843,1942],[1943,1994],[1995,1996],[1999,2045],"// 🔥 Dynamic Logic based on Payment Method",[2046,2183],"  const refPrefix =\n    paymentMethod === 'check'\n      ? 'CV-'\n      : paymentMethod === 'transfer'\n        ? 'REF-'\n        : paymentMethod === 'cash'\n          ? 'DV-'\n          : ''",[2184,2384],"  const refLabel =\n    paymentMethod === 'check'\n      ? 'Check / Voucher No.'\n      : paymentMethod === 'transfer'\n        ? 'Bank Reference No.'\n        : paymentMethod === 'cash'\n          ? 'Disbursement Voucher No.'\n          : 'Reference No.'",[2385,2386],[2389,2422],"const loadData = async () => {",[2423,2495],"    const api = (window as any).api || (window as any).electronAPI",{"messageId":"71332","fix":"71712","desc":"71334"},{"messageId":"71335","fix":"71713","desc":"71337"},{"messageId":"71332","fix":"71714","desc":"71334"},{"messageId":"71335","fix":"71715","desc":"71337"},[2500,2522],"if (!api) return",[2523,2537],[2538,2591],"      const accData = await api.getAccounts()",[2592,2728],"      setExpenseAccounts(\n        accData.filter(\n          (a: any) => a.account_type?.name === 'Expense' || a.account_type?.name === 'Liability'\n        )",{"messageId":"71332","fix":"71716","desc":"71334"},{"messageId":"71335","fix":"71717","desc":"71337"},[2735,2818],")\n      const assets = accData.filter((a: any) => a.account_type?.name === 'Asset')",{"messageId":"71332","fix":"71718","desc":"71334"},{"messageId":"71335","fix":"71719","desc":"71337"},[2819,2856],"      setCashAccounts(assets)",[2857,2858],[2859,2998],"      if (assets.length > 0 && !sourceAccount)\n        setSourceAccount(assets.find((a: any) => a.code === '1010')?.code || assets[0].code)",{"messageId":"71332","fix":"71720","desc":"71334"},{"messageId":"71335","fix":"71721","desc":"71337"},[2999,3064],"      if (api.getPayees) setPayees(await api.getPayees())",[3065,3066],[3067,3173],"      // Note: If this is empty, verify API is querying the exact same table/dates as the Dashboard",[3174,3280],"      if (api.getRecentDisbursements) setRecentVouchers((await api.getRecentDisbursements(5)) || [])",[3281,3323],"    } catch (e) {\n      console.error(e)",[3329,3333],[3336,3376],"}\n\n  useEffect(() => {\n    loadData()\n  }, [])",{"desc":"71722","fix":"71723"},[3377,3378],[3379,3438],"  // Only fetch sequence if a payment method is selected",[3439,3461],[3462,3505],"    const fetchNextSeq = async () => {",[3506,3566],"      if (!refPrefix) {\n        setRefSequence('')\n        return",[3573,3585],"}\n      try {",[3586,3666],"        const api = (window as any).api || (window as any).electronAPI",{"messageId":"71332","fix":"71724","desc":"71334"},{"messageId":"71335","fix":"71725","desc":"71337"},{"messageId":"71332","fix":"71726","desc":"71334"},{"messageId":"71335","fix":"71727","desc":"71337"},[3667,3737],"        const nextSeq = await api.getNextSequence(refPrefix)",[3738,3779],"        setRefSequence(nextSeq)",[3786,3834],"} catch (error) {\n        console.error(error)",[3841,3846],[3851,3871],"}\n    fetchNextSeq()",[3872,3901],"  }, [refPrefix, status])",[3902,3903],[3904,3929],"  // Live Calculations",[3930,3997],"  const { netExpense, inputVat, totalCashOut } = useMemo(() => {",[3998,4045],"    const numAmount = Number(amount) || 0",[4046,4131],"    if (numAmount === 0) return { netExpense: 0, inputVat: 0, totalCashOut: 0 }",[4132,4161],"    let exp = numAmount",[4166,4183],"let vat = 0",[4184,4209],"    if (isVatable) {",[4210,4267],"      exp = Number((numAmount / 1.12).toFixed(2))",[4268,4324],"      vat = Number((numAmount - exp).toFixed(2))",[4325,4335],[4336,4412],"    return { netExpense: exp, inputVat: vat, totalCashOut: numAmount }",[4413,4442],"  }, [amount, isVatable])",[4443,4444],[4447,4581],"const formatCurrency = (val: number) =>\n    `₱ ${val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`",[4582,4583],[4586,4659],"const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {",[4660,4753],"    if (e.target.files) setAttachments([...attachments, ...Array.from(e.target.files)])",[4756,4761],[4762,4763],[4764,4865],"  const removeFile = (index: number) => setAttachments(attachments.filter((_, i) => i !== index))",[4866,4867],[4868,4908],"  const executeSubmit = async () => {",[4913,4945],"setShowConfirmModal(false)",[4946,4971],[4972,4998],[4999,5000],[5001,5015],[5016,5044],"      const lines = [",[5045,5122],"        { accountId: expenseAccount, debit: netExpense, credit: 0 },",[5123,5200],"        { accountId: sourceAccount, debit: 0, credit: totalCashOut }",[5201,5216],[5217,5331],"      if (isVatable && inputVat > 0)\n        lines.splice(1, 0, { accountId: '1300', debit: inputVat, credit: 0 })",[5332,5333],[5334,5410],{"messageId":"71332","fix":"71728","desc":"71334"},{"messageId":"71335","fix":"71729","desc":"71337"},{"messageId":"71332","fix":"71730","desc":"71334"},{"messageId":"71335","fix":"71731","desc":"71337"},[5411,5502],"      if (isVatable && payeeTin.trim()) await api.updatePayeeTin(payeeId, payeeTin)",[5503,5504],[5505,5575],"      const selectedPayee = payees.find((p) => p.id === payeeId)",[5576,5709],"      const description = `Disbursement to ${selectedPayee?.name || 'Supplier'} - ${remarks}${isVatable ? ' [VATABLE]' : ''}`",[5710,5793],"      const fullReferenceNo = `${refPrefix}${refSequence.padStart(3, '0')}`",[5794,5795],[5796,5854],[5855,5907],"        date: new Date(date).toISOString(),",[5908,5954],[5955,5997],"        description: description,",[5998,6057],"        vatType: isVatable ? 'VATABLE' : 'EXEMPT',",[6058,6097],"        userId,\n        payeeId,\n        lines",[6098,6114],[6115,6116],[6117,6151],[6152,6256],"        setStatus({ type: 'success', msg: `Payment ${fullReferenceNo} issued successfully!` })",[6257,6347],"        setAmount('')\n        setExpenseAccount('')\n        setRemarks('')\n        setAttachments([])",[6348,6440],"        setIsVatable(false)\n        setPayeeTin('')\n        setPayeeId('')\n        setPaymentMethod('')",[6441,6469],"        loadData()",[6470,6527],"        setTimeout(() => setStatus(null), 5000)",[6528,6549],[6