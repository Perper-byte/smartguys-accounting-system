>Tablets (tab)</option>",[18786,18887],"                          <option value=\"Capsules\">Capsules (cap)</option>",[18888,18975],"                          <option value=\"Kits\">Kits</option>",[18976,19034],"                        </select>",[19035,19086],[19087,19137],[19138,19294],"                        <label className=\"block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1\">\n                          Location\n                        </label>",[19319,19612],"<input\n                          value={editItem.location}\n                          onChange={(e) => setEditItem({ ...editItem, location: e.target.value })}\n                          placeholder=\"Optional\"\n                          className=\"w-full bg-white border border-[#B0DCDA] rounded-md p-2 text-sm text-gray-800 outline-none focus:ring-2 focus:ring-[#1B9387]/30\"",[19637,19664],[19665,19712],[19713,19799],"                    <div className=\"flex justify-end gap-3 pt-2\">",[19822,20043],"<button\n                        type=\"button\"\n                        onClick={() => setIsEditing(false)}\n                        className=\"px-4 py-2 bg-white border border-gray-300 rounded-md text-xs font-bold text-gray-600 hover:bg-gray-50 transition cursor-pointer\"",[20066,20099],">\n                        Cancel",[20122,20154],"</button>\n                      <button",[20179,20376],"type=\"submit\"\n                        className=\"px-5 py-2 bg-[#1B9387] rounded-md text-xs font-bold text-white hover:bg-[#15796f] transition flex items-center gap-2 shadow-sm cursor-pointer\"",[20399,20457],">\n                        <Save size={14} /> Save Changes",[20458,20512],[20513,20560],[20561,20605],"                  </form>",[20606,20644],[20645,20764],"                  <div className=\"flex justify-between items-start animate-in fade-in duration-200\">",[20765,20811],[20834,20907],"<div className=\"flex items-center space-x-4 mb-2\">",[20908,21050],"                        <h3 className=\"text-2xl font-extrabold text-gray-800 tracking-tight\">\n                          {selectedItem.name}",[21075,21333],"</h3>\n                        <span\n                          className={`px-3 py-1 rounded-full text-xs font-black font-mono shadow-sm border flex gap-1.5 items-center ${selectedItem.stock <= 5 ? 'bg-red-50 text-red-600 border-red-200' : 'bg-[#E9FAFA] text-[#1B9387] border-[#B0DCDA]'}`}",[21358,21427],">\n                          <span>STOCK: {selectedItem.stock}</span>",[21428,21592],"                          <span className=\"text-[10px] font-sans opacity-70 uppercase tracking-widest\">\n                            {selectedItem.uom || 'PCS'}",[21619,21649],"</span>\n                        </span>",[21650,21701],[21702,21841],"                      <div className=\"flex space-x-8 mt-4 text-sm font-bold text-gray-600 uppercase tracking-wider\">",[21866,21985],"<p>\n                          PRODUCT CODE:{' '}\n                          <span className=\"font-mono text-gray-800 ml-2\">{selectedItem.code}</span>\n                        </p>",[22010,22126],"<p>\n                          LOCATION:{' '}\n                          <span className=\"text-gray-800 ml-2\">{selectedItem.location || '—'}</span>",[22149,22178],"  </p>\n                      </div>",[22179,22226],[22227,22297],"                    {/* EDIT / DELETE BUTTONS */}",[22298,22380],"                    <div className=\"flex items-center gap-2\">",[22403,22625],"<button\n                        onClick={startEditing}\n                        title=\"Edit Product\"\n                        className=\"p-2 bg-white border border-gray-200 text-gray-500 rounded-md hover:bg-gray-50 hover:text-[#1B9387] transition shadow-sm cursor-pointer\"",[22648,22693],">\n                        <Edit size={16} />",[22694,22748],[22771,23017],"<button\n                        onClick={handleDeleteItem}\n                        title=\"Delete Product\"\n                        className=\"p-2 bg-white border border-gray-200 text-gray-500 rounded-md hover:bg-red-50 hover:border-red-200 hover:text-red-500 transition shadow-sm cursor-pointer\"",[23018,23087],"                      >\n                        <Trash2 size={16} />",[23088,23142],[23143,23190],[23191,23234],[23235,23270],[23271,23306],[23307,23308],[23309,23364],"              {/* LOGBOOK ENTRY FORM */}",[23379,23586],"<form\n                onSubmit={handleAddLog}\n                className={`p-4 border-b border-[#B0DCDA] flex flex-col gap-3 shadow-inner shrink-0 ${isEditing ? 'opacity-50 pointer-events-none bg-gray-50' : 'bg-[#FBF8F8]'}`}",[23601,23678],">\n                <div className=\"flex flex-wrap gap-3 items-center w-full\">",[23679,23747],"                  <div className=\"relative w-36\">",[23748,23867],"                    <div className=\"absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\">",[23890,24052],"{logType === 'IN' ? (\n                        <ArrowDownToLine size={14} className=\"text-emerald-600\" />\n                      ) : (\n                        <ArrowUpFromLine size={14} className=\"text-orange-600\" />",[24075,24100],")}\n                    </div>",[24101,24149],"                    <select",[24150,24210],"                      value={logType}",[24211,24305],"                      onChange={(e) => setLogType(e.target.value as any)}",{"messageId":"71332","fix":"72024","desc":"71334"},{"messageId":"71335","fix":"72025","desc":"71337"},[24306,24615],"                      className={`w-full pl-9 font-extrabold text-xs uppercase tracking-wider border rounded-md py-2.5 outline-none cursor-pointer appearance-none ${\n                        logType === 'IN'\n                          ? 'bg-emerald-50 text-emerald-700 border-emerald-200'\n                          : 'bg-orange-50 text-orange-700 border-orange-200'",[24616,24668],"                      }`}",[24669,24711],[24712,24793],"                      <option value=\"IN\">IN (Add)</option>",[24794,24877],"                      <option value=\"OUT\">OUT (Use)</option>",[24878,24928],"                    </select>",[24929,24972],[24973,24974],[24975,25056],"                  <div className=\"relative flex items-center\">",[25057,25104],[25105,25163],"                      type=\"number\"",[25164,25216],"                      min=\"1\"",[25217,25270],"                      step=\"1\"",[25271,25324],[25325,25387],"                      placeholder=\"Qty\"",[25388,25447],"                      value={logQty}",[25448,25542],"                      onChange={(e) => setLogQty(Number(e.target.value))}",[25543,25773],"                      className=\"w-32 bg-white border border-[#B0DCDA] rounded-md px-3 py-2 pr-12 text-sm font-mono font-bold outline-none focus:border-[#1B9387] focus:ring-2 focus:ring-[#E9FAFA] transition\"",[25774,25817],[25818,25960],"                    <span className=\"absolute right-3 text-[10px] text-gray-400 font-bold uppercase pointer-events-none\">",[25961,26128],"                      {selectedItem.uom === 'Pieces'\n                        ? 'PCS'\n                        : selectedItem.uom === 'Boxes'\n                          ? 'BOX'\n                          : selectedItem.uom?.substring(0, 3) || 'PCS'}",[26129,26177],[26178,26221],[26222,26223],[26224,26283],"                  {logType === 'IN' && (",[26284,26331],[26332,26388],"                      type=\"date\"",[26389,26457],"                      title=\"Expiration Date\"",[26458,26520],"                      value={logExpiry}",[26521,26610],"                      onChange={(e) => setLogExpiry(e.target.value)}",[26611,26839],"                      className=\"w-36 bg-white border border-[#B0DCDA] rounded-md px-3 py-2 text-xs text-gray-600 font-bold outline-none focus:border-[#1B9387] focus:ring-2 focus:ring-[#E9FAFA] transition\"",[26840,26883],[26884,26923],[26924,26925],[26926,26969],"                  <input",[26970,27022],"                    type=\"text\"",[27043,27097],"placeholder=\"Remarks / Ref No...\"",[27098,27157],"                    value={logRemarks}",[27158,27244],"                    onChange={(e) => setLogRemarks(e.target.value)}",[27245,27473],"                    className=\"flex-1 min-w-[150px] bg-white border border-[#B0DCDA] rounded-md px-3 py-2 text-sm font-medium outline-none focus:border-[#1B9387] focus:ring-2 focus:ring-[#E9FAFA] transition\"",[27474,27513],[27514,27515],[27516,27716],"                  <button className=\"bg-[#1B9387] hover:bg-[#28958B] text-white px-6 py-2 rounded-md text-sm font-bold shadow-sm uppercase tracking-wider transition cursor-pointer\">",[27717,27762],"                    Save",[27763,27809],[27810,27849],[27850,27886],"              </form>",[27887,27888],[27889,27939],"              {/* LOGBOOK TABLE */}",[27954,28081],"<div\n                className={`flex-1 overflow-auto ${isEditing ? 'opacity-50 pointer-events-none bg-gray-50' : 'bg-white'}`}",[28096,28159],">\n                <table className=\"w-full text-left text-sm\">",[28160,28283],"                  <thead className=\"bg-[#FBF8F8] sticky top-0 border-b border-[#B0DCDA] shadow-sm z-10\">",[28284,28403],"                    <tr className=\"text-gray-500 uppercase tracking-wider text-xs font-extrabold\">",[28404,28513],"                      <th className=\"p-3 border-r border-gray-200 pl-6 w-32\">Date</th>",[28514,28645],"                      <th className=\"p-3 border-r border-gray-200 text-center text-emerald-600 w-16\">\n                        IN",[28668,28777],"</th>\n                      <th className=\"p-3 border-r border-gray-200 text-center text-orange-600 w-16\">\n                        OUT",[28800,28912],"</th>\n                      <th className=\"p-3 border-r border-gray-200 text-center text-[#1B9387] w-24\">\n                        Balance",[28935,29021],"</th>\n                      <th className=\"p-3 border-r border-gray-200 w-28\">Exp Date</th>",[29022,29124],"                      <th className=\"p-3 border-r border-gray-200\">Remarks</th>",[29125,29227],"                      <th className=\"p-3 text-center w-32 pr-6\">Counted By</th>",[29228,29274],[29275,29320],[29321,29402],[29403,29466],"                    {logs.length === 0 ? (",[29489,29629],"<tr>\n                        <td\n                          colSpan={7}\n                          className=\"p-12 text-center text-gray-400 italic font-medium\"\n                        >\n                          No movement recorded yet.",[29654,29676],[29697,29746],") : (\n                      logs.map((log: any) => (",{"messageId":"71332","fix":"72026","desc":"71334"},{"messageId":"71335","fix":"72027","desc":"71337"},[29771,29892],"<tr\n                          key={log.id}\n                          className=\"hover:bg-gray-50 transition-colors even:bg-gray-50/50 odd:bg-white\"",[29917,30074],">\n                          <td className=\"p-3 pl-6 font-mono text-xs text-gray-500 border-r border-gray-100\">\n                            {new Date(log.date).toLocaleDateString()}",[30101,30285],"</td>\n                          <td className=\"p-3 text-center font-mono font-bold text-emerald-600 bg-emerald-50/30 border-r border-gray-100\">\n                            {log.in_qty > 0 ? `+${log.in_qty}` : '-'}",[30312,30496],"</td>\n                          <td className=\"p-3 text-center font-mono font-bold text-orange-500 bg-orange-50/30 border-r border-gray-100\">\n                            {log.out_qty > 0 ? `-${log.out_qty}` : '-'}",[30523,30677],"</td>\n                          <td className=\"p-3 text-center font-mono font-black text-[#1B9387] bg-[#E9FAFA]/50 border-r border-gray-100\">\n                            {log.balance}",[30704,30895],"</td>\n                          <td className=\"p-3 border-r border-gray-100 text-xs font-mono font-bold text-rose-500\">\n                            {log.expiry_date ? new Date(log.expiry_date).toLocaleDateString() : '—'}\n                          </td>",[30922,31096],"<td\n                            className=\"p-3 text-gray-700 text-xs border-r border-gray-100 font-medium truncate max-w-[150px]\"\n                            title={log.remarks}\n                          >\n                            {log.remarks || '—'}",[31123,31285],"</td>\n                          <td className=\"p-3 pr-6 text-center text-[10px] font-bold uppercase tracking-wider text-gray-400\">\n                            {log.user?.username || 'SYSTEM'}",[31312,31340],"</td>\n                        </tr>",[31341,31388],"                      ))",[31409,31432],[31433,31478],[31479,31520],[31521,31556],[31557,31585],"            </>",[31586,31609],[31610,31633],[31634,31653],[31654,31669],[31670,31677],[31679,31679],[53,54],{"messageId":"71592","data":"72028","fix":"72029","desc":"71595"},[85,87],[131,133],[142,238],"\n  Printer,\n  RefreshCw,\n  Search,\n  Eye,\n  CreditCard,\n  Clock,\n  FileText,\n  X,\n  Filter\n} from 'lucide-react'",[239,240],[272,273],[276,331],"onNavigate?: (viewName: string, data?: any) => void",{"messageId":"71332","fix":"72030","desc":"71334"},{"messageId":"71335","fix":"72031","desc":"71337"},[333,334],[335,336],[410,411],[414,469],"const [invoices, setInvoices] = useState<any[]>([])",{"messageId":"71332","fix":"72032","desc":"71334"},{"messageId":"71335","fix":"72033","desc":"71337"},[472,521],"const [loading, setLoading] = useState(false)",[522,527],[530,543],"// Filters",[544,600],[601,662],"  const [statusFilter, setStatusFilter] = useState('All')",[663,763],"  const [entityFilter, setEntityFilter] = useState('All') // NEW: HMO, PATIENT, CORPORATE filter",[764,769],[770,841],"  const [lastUpdated, setLastUpdated] = useState<Date | null>(null)",[842,920],"  const [selectedInvoice, setSelectedInvoice] = useState<any | null>(null)",{"messageId":"71332","fix":"72034","desc":"71334"},{"messageId":"71335","fix":"72035","desc":"71337"},[921,922],[923,963],"  const fetchInvoices = async () => {",[964,990],[991,1005],[1006,1082],{"messageId":"71332","fix":"72036","desc":"71334"},{"messageId":"71335","fix":"72037","desc":"71337"},{"messageId":"71332","fix":"72038","desc":"71334"},{"messageId":"71335","fix":"72039","desc":"71337"},[1089,1164],"// Enhanced fallback data to demonstrate HMO vs Patient vs Corporate",[1165,1200],"      const fallbackData = [",[1209,1383],"{\n          referenceNo: 'INV-001',\n          payeeName: 'Maxicare Healthcare',\n          payeeType: 'HMO',\n          date: '2026-08-13',\n          status: 'Partially Paid',\n          total: 5600,\n          paid: 4100,\n          balance: 1500\n        },",[1391,1554]," {\n          referenceNo: 'INV-002',\n          payeeName: 'Juan Dela Cruz',\n          payeeType: 'PATIENT',\n          date: '2026-08-20',\n          status: 'Unpaid',\n          total: 2500,\n          paid: 0,\n          balance: 2500\n        },",[1563,1724],"{\n          referenceNo: 'INV-003',\n          payeeName: 'Intellicare',\n          payeeType: 'HMO',\n          date: '2026-08-15',\n          status: 'Fully Paid',\n          total: 10000,\n          paid: 10000,\n          balance: 0\n        },",[1733,1903],"{\n          referenceNo: 'INV-004',\n          payeeName: 'MedSupplies Corp',\n          payeeType: 'CORPORATE',\n          date: '2026-08-18',\n          status: 'Fully Paid',\n          total: 4500,\n          paid: 4500,\n          balance: 0\n        },",[1912,2071],"{\n          referenceNo: 'INV-005',\n          payeeName: 'Maria Clara',\n          payeeType: 'PATIENT',\n          date: '2026-08-21',\n          status: 'Unpaid',\n          total: 1200,\n          paid: 0,\n          balance: 1200",[2080,2087],[2094,2165],"]\n      const data = api ? await api.getInvoiceTracker() : fallbackData",[2166,2203],"      setInvoices(data || [])",[2204,2244],"      setLastUpdated(new Date())",[2245,2271],[2272,2342],"      console.error('Failed to fetch invoice tracker:', error)",[2343,2363],[2364,2395],[2396,2406],[2407,2414],[2415,2416],[2419,2464],"useEffect(() => {\n    fetchInvoices()\n  }, [])",[2465,2466],[2467,2536],"  const formatCurrency = (amount: number, showSymbol = false) => {",[2537,2586],"    if (!amount || amount === 0) return '-'",[2591,2701],"const formatted = amount.toLocaleString('en-US', {\n      minimumFractionDigits: 2,\n      maximumFractionDigits: 2",[2706,2760],"})\n    return showSymbol ? `₱ ${formatted}` : formatted",[2761,2768],[2769,2770],[2771,2815],"  const getInitials = (name: string) => {",[2816,2846],"    if (!name) return ''",[2847,2895],"    const words = name.trim().split(/\\s+/)",[2896,2975],"    if (words.length === 1) return words[0].substring(0, 2).toUpperCase()",[2976,3034],"    return (words[0][0] + words[1][0]).toUpperCase()",[3035,3042],[3043,3044],[3045,3074],"  // Filter Logic Enhanced",[3075,3129],"  const filteredInvoices = invoices.filter((inv) => {",[3134,3155],"// Search Filter",[3156,3267],"    const matchesSearch =\n      String(inv.payeeName || '')\n        .toLowerCase()\n        .includes(searchQuery.toLowerCase()) ||",[3274,3379],"String(inv.referenceNo || '')\n        .toLowerCase()\n        .includes(searchQuery.toLowerCase())",[3380,3389],[3390,3423],"    // Payment Status Filter",[3424,3486],"    const matchesStatus =\n      statusFilter === 'All'",[3487,3613],"        ? true\n        : statusFilter === 'Outstanding'\n          ? inv.status === 'Unpaid' || inv.status === 'Partially Paid'",[3624,3673],": inv.status === statusFilter",[3674,3683],[3684,3740],"    // Entity Type Filter (HMO, PATIENT, CORPORATE)",[3741,3803],"    const matchesEntity =\n      entityFilter === 'All'",[3812,3925],"? true\n        : entityFilter === 'HMO_CORP'\n          ? inv.payeeType === 'HMO' || inv.payeeType === 'CORPORATE'",[3936,3988],": inv.payeeType === entityFilter",[3989,3990],[3991,4055],"    return matchesSearch && matchesStatus && matchesEntity",[4056,4064],[4065,4066],[4067,4141],"  // KPI Math (Calculated from ALL invoices so top cards remain stable)",[4142,4224],"  const totalBilled = invoices.reduce((sum, inv) => sum + (inv.total || 0), 0)",[4225,4309],"  const totalCollected = invoices.reduce((sum, inv) => sum + (inv.paid || 0), 0)",[4310,4395],"  const totalBalance = invoices.reduce((sum, inv) => sum + (inv.balance || 0), 0)",[4398,4497],"const percentCollected = totalBilled > 0 ? Math.round((totalCollected / totalBilled) * 100) : 0",[4498,4499],[4500,4552],"  const renderStatusBadge = (status: string) => {",[4557,4771],"if (status === 'Fully Paid')\n      return (\n        <span className=\"bg-emerald-100 text-emerald-700 border border-emerald-200 px-2.5 py-1 rounded-md text-[10px] font-extrabold uppercase tracking-wider shadow-sm\">\n          Paid\n        </span>",[4776,4991],"  )\n    if (status === 'Partially Paid')\n      return (\n        <span className=\"bg-amber-100 text-amber-700 border border-amber-200 px-2.5 py-1 rounded-md text-[10px] font-extrabold uppercase tracking-wider shadow-sm\">\n          Partial\n        </span>",[4997,5171]," )\n    return (\n      <span className=\"bg-red-100 text-red-700 border border-red-200 px-2.5 py-1 rounded-md text-[10px] font-extrabold uppercase tracking-wider shadow-sm\">\n        Unpaid\n      </span>",[5176,5179],")\n  }",[5180,5181],[5184,5230],"const renderTypeBadge = (type: string) => {",[5231,5410],"    if (type === 'HMO')\n      return (\n        <span className=\"bg-indigo-100 text-indigo-700 px-1.5 py-0.5 rounded text-[8px] font-black uppercase tracking-widest ml-2 shrink-0\">\n          HMO\n        </span>",[5411,5593],"      )\n    if (type === 'CORPORATE')\n      return (\n        <span className=\"bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded text-[8px] font-black uppercase tracking-widest ml-2 shrink-0\">\n          CORP\n        </span>",[5598,5779],"  )\n    if (type === 'PATIENT')\n      return (\n        <span className=\"bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded text-[8px] font-black uppercase tracking-widest ml-2 shrink-0\">\n          PATIENT\n        </span>",[5784,5801],"  )\n    return null",[5804,5809],[5810,5811],[5812,5889],"  const filterOptions = ['All', 'Unpaid', 'Partially Paid', 'Fully Paid']",[5890,5891],[5892,5905],[5906,5961],"    <div className=\"w-full min-h-full p-6 md:p-8\">",[5962,6090],"      <div className=\"max-w-7xl mx-auto flex flex-col font-sans text-gray-800 animate-in fade-in duration-300 space-y-6\">",[6091,6124],[6133,6234],"<div className=\"flex justify-between items-end pb-4 border-b border-[#B0DCDA] print:hidden\">",[6235,6261],[6262,6379],"            <h2 className=\"text-2xl font-extrabold text-gray-800 tracking-wide\">\n              A/R Invoice Tracker",[6392,6455],"</h2>\n            <div className=\"flex items-center space-x-3 mt-1\">",[6456,6593],"              <p className=\"text-sm text-gray-500 font-medium\">\n                Live status of all Patient, HMO, and Corporate charges.",[6608,6640],"</p>\n              {lastUpdated && (",[6641,6676],"                <>",[6677,6754],"                  <span className=\"text-gray-300\">•</span>",[6755,6867],"                  <span className=\"text-xs font-bold text-[#1B9387] flex items-center gap-1\">",[6868,7013],"                    <Clock size={12} /> Updated{' '}\n                    {lastUpdated.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}",[7014,7058],"                  </span>",[7059,7095],"                </>",[7096,7127],[7128,7159],[7160,7187],[7188,7241],"          <div className=\"flex space-x-3\">",[7254,7465],"<button\n              onClick={fetchInvoices}\n              className=\"px-3 py-2 bg-white hover:bg-gray-50 border border-gray-200 text-gray-600 rounded-md transition flex items-center justify-center shadow-sm\"\n              title=\"Refresh\"",[7478,7560],">\n              <RefreshCw size={16} className={loading ? 'animate-spin' : ''} />",[7561,7595],[7608,7833],"<button\n              onClick={() => window.print()}\n              className=\"px-4 py-2 bg-[#1B9387] hover:bg-[#28958B] text-white text-xs font-extrabold rounded-md tracking-wider uppercase transition shadow-sm flex items-center space-x-2\"",[7846,7908],">\n              <Printer size={16} /> <span>Print List</span>",[7909,7943],[7944,7971],[7972,7995],[7996,7997],[7998,8050],"        {/* CLICKABLE KPI SUMMARY CARDS */}",[8059,8136],"<div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 print:hidden\">",[8137,8162],"          <div",[8163,8226],"            onClick={() => setStatusFilter('All')}",[8227,8468],"            className={`bg-white p-5 rounded-xl border-2 transition-all cursor-pointer shadow-sm hover:shadow-md ${statusFilter === 'All' ? 'border-[#1B9387] ring-1 ring-[#1B9387]/20' : 'border-gray-100 hover:border-gray-200'}`}",[8469,8491],[8504,8572],"<div className=\"flex justify-between items-start mb-2\">",[8573,8705],"              <span className=\"text-[10px] font-extrabold text-gray-500 uppercase tracking-wider\">\n                Total Billed",[8720,8783],"</span>\n              <FileText size={16} className=\"text-gray-400\" />",[8784,8815],[8816,8948],"            <span className=\"text-2xl font-black text-gray-800 tabular-nums\">\n              {formatCurrency(totalBilled, true)}",[8961,8976],"</span>\n          </div>",[8977,8978],[8979,9004],[9005,9075],"            onClick={() => setStatusFilter('Fully Paid')}",[9076,9322],"            className={`bg-white p-5 rounded-xl border-2 transition-all cursor-pointer shadow-sm hover:shadow-md ${statusFilter === 'Fully Paid' ? 'border-teal-500 ring-1 ring-teal-500/20' : 'border-gray-100 hover:border-gray-200'}`}",[9323,9345],[9346,9426],"            <div className=\"flex justify-between items-start mb-2\">",[9427,9562],"              <span className=\"text-[10px] font-extrabold text-gray-500 uppercase tracking-wider\">\n                Total Collected",[9577,9714],"</span>\n              <span className=\"text-xs font-bold text-teal-600 bg-teal-50 px-2 py-0.5 rounded-full\">\n                {percentCollected}% Collected",[9729,9746],[9747,9882],"            <span className=\"text-2xl font-black text-teal-600 tabular-nums\">\n              {formatCurrency(totalCollected, true)}",[9895,9984],"</span>\n            <div className=\"w-full bg-gray-100 h-1.5 rounded-full mt-3 overflow-hidden\">",[9999,10139],"<div\n                className=\"bg-teal-500 h-1.5 rounded-full transition-all duration-1000\"\n                style={{ width: `${percentCollected}%` }}",[10154,10171],"></div>",[10172,10201],[10212,10227],"</div>\n\n          <div",[10228,10299],"            onClick={() => setStatusFilter('Outstanding')}",[10300,10545],"            className={`bg-white p-5 rounded-xl border-2 transition-all cursor-pointer shadow-sm hover:shadow-md ${statusFilter === 'Outstanding' ? 'border-red-400 ring-1 ring-red-400/20' : 'border-gray-100 hover:border-gray-200'}`}",[10546,10568],[10569,10649],[10650,10787],"              <span className=\"text-[10px] font-extrabold text-gray-500 uppercase tracking-wider\">\n                Total Outstanding",[10802,10941],"</span>\n              <span className=\"text-xs font-bold text-red-500 bg-red-50 px-2 py-0.5 rounded-full\">\n                {100 - percentCollected}% Pending",[10956,10973],[10974,11106],"            <span className=\"text-2xl font-black text-red-500 tabular-nums\">\n              {formatCurrency(totalBalance, true)}",[11119,11134],[11135,11158],[11159,11160],[11161,11213],"        {/* SEARCH & QUICK-FILTER CHIPS */}",[11214,11379],"        <div className=\"flex flex-col md:flex-row justify-between items-center bg-white p-3 rounded-lg border border-gray-200 shadow-sm print:hidden gap-4\">",[11380,11467],"          <div className=\"flex w-full md:w-1/2 gap-3\">",[11468,11526],"            <div className=\"relative w-full\">",[11527,11653],"              <Search\n                className=\"absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400\"\n                size={16}",[