CH BAR */}",[6481,6595],"        <div className=\"bg-white p-2 rounded-xl border border-gray-200 shadow-sm flex items-center mb-6\">",[6596,6673],"          <Search className=\"text-gray-400 ml-3 mr-2\" size={18} />",[6674,6702],"          <input",[6703,6740],[6741,6825],"            placeholder=\"Search reference, contact, or description...\"",[6826,6870],"            value={searchQuery}",[6871,6942],"            onChange={(e) => setSearchQuery(e.target.value)}",[6943,7038],"            className=\"w-full bg-transparent p-2 text-sm outline-none font-medium\"",[7039,7062],[7063,7086],[7087,7088],[7089,7119],[7120,7223],"        <div className=\"bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden\">",[7234,7320],"{/* 🔥 UPDATED: SUB-TABS (ACTIVE, DRAFTS, VOIDED) */}",[7321,7465],"          <div className=\"p-4 bg-gray-50 border-b border-gray-200 flex justify-between items-center text-xs font-bold text-gray-500\">",[7466,7544],"            <div className=\"flex gap-4 uppercase tracking-wider\">",[7545,7582],[7583,7655],"                onClick={() => setStatusTab('ACTIVE')}",[7656,7813],"                className={`transition pb-1 ${statusTab === 'ACTIVE' ? 'text-gray-800 border-b-2 border-gray-400' : 'hover:text-gray-800'}`}",[7814,7844],[7845,7884],"                Active",[7885,7923],[7924,7961],[7962,8034],"                onClick={() => setStatusTab('DRAFTS')}",[8035,8192],"                className={`transition pb-1 ${statusTab === 'DRAFTS' ? 'text-gray-800 border-b-2 border-gray-400' : 'hover:text-gray-800'}`}",[8193,8223],[8224,8263],"                Drafts",[8264,8302],[8303,8340],[8341,8413],"                onClick={() => setStatusTab('VOIDED')}",[8414,8571],"                className={`transition pb-1 ${statusTab === 'VOIDED' ? 'text-gray-800 border-b-2 border-gray-400' : 'hover:text-gray-800'}`}",[8572,8602],[8603,8642],"                Voided",[8643,8681],[8682,8713],[8714,8836],"            <span className=\"capitalize\">\n              