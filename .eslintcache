peColor = (typeName: string) => {",[6751,6779],"    switch (typeName) {",[6780,6857],"      case 'Asset':\n        return 'text-blue-600 bg-blue-50 border-blue-200'",[6858,6945],"      case 'Liability':\n        return 'text-orange-600 bg-orange-50 border-orange-200'",[6946,7030],"      case 'Equity':\n        return 'text-purple-600 bg-purple-50 border-purple-200'",[7031,7119],"      case 'Revenue':\n        return 'text-emerald-600 bg-emerald-50 border-emerald-200'",[7120,7199],"      case 'Expense':\n        return 'text-rose-600 bg-rose-50 border-rose-200'",[7200,7272],"      default:\n        return 'text-gray-600 bg-gray-50 border-gray-200'",[7273,7283],[7284,7291],[7292,7293],[7294,7365],"  // Lightweight guidance based on common COA numbering conventions.",[7366,7435],"  // Adjust ranges here if your clinic's COA uses different bands.",[7436,7529],"  const getCodeRangeHint = (code: string): { label: string; typeName: string } | null => {",[7530,7568],"    const n = parseInt(code, 10)",[7569,7604],"    if (isNaN(n)) return null",[7605,7708],"    if (n >= 1000 && n < 2000) return { label: '1000–1999 typically = Asset', typeName: 'Asset' }",[7713,7820],"if (n >= 2000 && n < 3000)\n      return { label: '2000–2999 typically = Liability', typeName: 'Liability' }",[7821,7926],"    if (n >= 3000 && n < 4000) return { label: '3000–3999 typically = Equity', typeName: 'Equity' }",[7927,8034],"    if (n >= 4000 && n < 5000)\n      return { label: '4000–4999 typically = Revenue', typeName: 'Revenue' }",[8035,8142],"    if (n >= 5000 && n < 6000)\n      return { label: '5000–5999 typically = Expense', typeName: 'Expense' }",[8143,8164],"    return null",[8167,8172],[8173,8174],[8175,8269],"  const selectedType = accountTypes.find((t) => String(t.id) === String(newAccount.type_id))",[8270,8326],"  const codeHint = getCodeRangeHint(newAccount.code)",[8327,8429],"  const codeTypeMismatch = !!(codeHint && selectedType && codeHint.typeName !== selectedType.name)",[8430,8431],[8432,8468],"  const renderTypeOptions = () =>",[8469,8582],"    accountTypes.map((t) => (\n      <option key={t.id} value={t.id}>\n        {t.name} (Normal: {t.normal_balance})\n      </option>",[8587,8596],"))\n\n  return (",[8597,8718],"    <div className=\"max-w-7xl mx-auto h-full flex flex-col text-gray-800 font-sans animate-in fade-in duration-300\">",[8719,8816],"      <div className=\"flex justify-between items-end mb-6 border-b border-[#B0DCDA] pb-4\">",[8817,8839],"        <div>",[8840,8957],"          <h2 className=\"text-2xl font-extrabold text-gray-800 tracking-wide\">\n            Chart of Accounts (COA)",[8968,9093],"</h2>\n          <p className=\"text-sm text-gray-500 mt-1 font-medium\">\n            Manage the clinic's ledger accounts and classifications.",{"messageId":"71778","data":"71779","fix":"71780","desc":"71781"},{"messageId":"71778","data":"71782","fix":"71783","desc":"71784"},{"messageId":"71778","data":"71785","fix":"71786","desc":"71787"},{"messageId":"71778","data":"71788","fix":"71789","desc":"71790"},[9104,9117],"</p>\n        </div>",[9124,9137],[9138,9139],[9146,9172],"{statusMessage && (",[9181,9391],"<div\n          className={`mb-6 p-4 rounded-md text-sm font-bold shadow-sm border ${statusMessage.type === 'success' ? 'bg-[#E9FAFA] text-[#1B9387] border-[#B0DCDA]' : 'bg-red-50 text-red-500 border-red-200'}`}",[9400,9481],">\n          {statusMessage.type === 'success' ? '✅ ' : '⚠️ '}\n          {statusMessage.msg}",[9482,9505],[9506,9521],[9522,9523],[9524,9607],"      <div className=\"flex-1 grid grid-cols-1 lg:grid-cols-3 gap-8 min-h-0\">",[9608,9662],"        {/* LEFT PANE: CREATE NEW ACCOUNT */}",[9663,9772],"        <div className=\"col-span-1 bg-white border border-[#B0DCDA] rounded-xl p-6 shadow-sm h-fit\">",[9773,9908],"          <h3 className=\"text-lg font-extrabold text-gray-800 mb-5 border-b border-gray-100 pb-3\">\n            Create Ledger Account",[9919,10000],"</h3>\n          <form onSubmit={handleCreateAccount} className=\"space-y-4\" noValidate>",[10013,10031],[10032,10179],"              <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                Account Code",[10194,10215],"</label>\n              <input",[10216,10267],"                ref={codeInputRef}",[10268,10312],[10313,10354],"                required",[10355,10411],"                placeholder=\"e.g. 5060\"",[10412,10468],"                value={newAccount.code}",[10469,10579],"                onChange={(e) => setNewAccount({ ...newAccount, code: e.target.value.trim() })}",[10580,10667],"                onBlur={() => setTouched((t) => ({ ...t, code: true }))}",[10668,10727],"                aria-invalid={!!codeError}",[10728,10981],"                className={`w-full bg-[#FBF8F8] border rounded-md p-2.5 text-sm text-gray-800 font-mono font-bold outline-none transition ${codeError ? 'border-red-300 focus:border-red-400' : 'border-[#B0DCDA] focus:border-[#1B9387]'}`}",[10982,11013],[11014,11057],"              {codeError ? (",[11058,11167],"                <p className=\"mt-1.5 text-[11px] font-semibold text-red-500\">{codeError}</p>",[11168,11213],"              ) : codeHint ? (",[11230,11354],"<p\n                  className={`mt-1.5 text-[11px] font-semibold ${codeTypeMismatch ? 'text-amber-600' : 'text-gray-400'}`}",[11371,11507],">\n                  {codeTypeMismatch\n                    ? `⚠ Code suggests ${codeHint.typeName}, but ${selectedType?.name} is selected`\n                    : codeHint.label}",[11508,11545],"                </p>",[11546,11584],"              ) : null}",[11585,11616],[11617,11647],[11648,11795],"              <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                Account Name",[11810,11831],[11832,11876],[11893,11918],"required",[11919,11988],"                placeholder=\"e.g. Marketing Expense\"",[11989,12045],"                value={newAccount.name}",[12046,12149],"                onChange={(e) => setNewAccount({ ...newAccount, name: e.target.value })}",[12150,12237],"                onBlur={() => setTouched((t) => ({ ...t, name: true }))}",[12238,12297],"                aria-invalid={!!nameError}",[12298,12543],"                className={`w-full bg-[#FBF8F8] border rounded-md p-2.5 text-sm text-gray-800 font-medium outline-none transition ${nameError ? 'border-red-300 focus:border-red-400' : 'border-[#B0DCDA] focus:border-[#1B9387]'}`}",[12544,12575],[12590,12696],"{nameError && (\n                <p className=\"mt-1.5 text-[11px] font-semibold text-red-500\">{nameError}</p>",[12711,12728],")}\n            </div>",[12729,12794],"            <div className=\"grid grid-cols-2 gap-3\">",[12795,12852],"              <div className=\"col-span-2\">",[12853,12944],"                <div className=\"flex items-center justify-between mb-1.5\">",[12963,13100],"<label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider\">\n                    Classification Type",[13119,13156],"</label>\n                  {selectedType && (",[13177,13331],"<span\n                      className={`px-2 py-0.5 text-[9px] font-extrabold rounded uppercase tracking-wider border ${getTypeColor(selectedType.name)}`}",[13352,13396],">\n                      {selectedType.name}",[13397,13445],[13446,13485],[13486,13525],[13526,13566],"                <select",[13567,13612],"                  required",[13613,13676],"                  value={newAccount.type_id}",[13677,13787],"                  onChange={(e) => setNewAccount({ ...newAccount, type_id: e.target.value })}",[13788,13882],"                  onBlur={() => setTouched((t) => ({ ...t, type_id: true }))}",[13883,13946],"                  aria-invalid={!!typeError}",[13947,14211],"                  className={`w-full bg-[#FBF8F8] border rounded-md p-2.5 text-sm text-gray-800 font-medium outline-none transition cursor-pointer ${typeError ? 'border-red-300 focus:border-red-400' : 'border-[#B0DCDA] focus:border-[#1B9387]'}`}",[14212,14246],"                >",[14247,14327],"                  <option value=\"\">-- Select Type --</option>",[14328,14386],"                  {renderTypeOptions()}",[14387,14429],[14446,14554],"{typeError && (\n                  <p className=\"mt-1.5 text-[11px] font-semibold text-red-500\">{typeError}</p>",[14571,14590],")}\n              </div>",[14591,14622],[14623,14653],[14654,14803],"              <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1.5\">\n                Normal Balance\n              </label>",[14818,15053],"<div\n                className={`w-full rounded-md p-2.5 text-sm font-extrabold uppercase tracking-wider text-center border ${selectedType ? 'bg-[#E9FAFA] text-[#1B9387] border-[#B0DCDA]' : 'bg-gray-50 text-gray-300 border-gray-100'}`}",[15068,15155],">\n                {selectedType ? selectedType.normal_balance : 'Select a type first'}",[15156,15191],[15192,15329],"              <p className=\"mt-1.5 text-[11px] font-semibold text-gray-400\">\n                Auto-derived from the classification type.",[15342,15361],"  </p>\n            </div>",[15362,15394],"            <button",[15395,15437],"              type=\"submit\"",[15438,15501],"              disabled={loading || !isFormValid}",[15502,15740],"              className=\"w-full bg-[#1B9387] hover:bg-[#28958B] text-white font-bold py-3 rounded-md transition mt-2 cursor-pointer shadow-sm uppercase tracking-wider text-sm disabled:opacity-50 disabled:cursor-not-allowed\"",[15741,15767],"            >",[15768,15843],"              {loading ? 'Processing...' : 'Create Account'}",[15856,15878],[15879,15907],[15908,15931],[15932,15933],[15934,15988],"        {/* RIGHT PANE: EXISTING ACCOUNTS */}",[15997,16118],"<div className=\"col-span-2 bg-white border border-[#B0DCDA] rounded-xl shadow-sm overflow-hidden flex flex-col\">",[16119,16250],"          <div className=\"p-4 border-b borde