0115],"/>\n                </div>",[10116,10117],[10118,10182],"                <div className=\"relative z-20\">",[10183,10273],"                  <div className=\"flex justify-between items-end mb-2\">",[10274,10431],"                    <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider\">\n                      Vendor / Supplier\n                    </label>",[10452,10659],"<button\n                      type=\"button\"\n                      onClick={() => setShowAddPayee(true)}\n                      className=\"text-[10px] font-extrabold text-[#1B9387] hover:text-[#28958B] transition uppercase tracking-wider cursor-pointer\"",[10680,10714],">\n                      + Add New",[10715,10765],"                    </button>",[10766,10809],[10828,11134],"<div\n                    onClick={() => setIsPayeeDropdownOpen(!isPayeeDropdownOpen)}\n                    className={`w-full bg-[#FBF8F8] border ${isPayeeDropdownOpen ? 'border-[#1B9387] ring-1 ring-[#1B9387]' : 'border-[#B0DCDA]'} rounded-md p-3 text-sm transition cursor-pointer flex justify-between items-center shadow-sm`}",[11153,11194],">\n                    {selectedPayee ? (",[11195,11271],"                      <div className=\"flex flex-col\">",[11272,11390],"                        <span className=\"text-gray-800 font-bold\">{selectedPayee.name}</span>",[11391,11592],"                        {selectedPayee.youOwe > 0 && (\n                          <span className=\"text-[10px] text-orange-500 font-bold\">\n                            Outstanding Payable: {formatCurrency(selectedPayee.youOwe)}",[11593,11691],"                          </span>\n                        )}\n                      </div>",[11712,11818],") : (\n                      <span className=\"text-gray-400 font-medium\">\n                        -- Select Vendor / Supplier --",[11841,11862],[11883,11952],")}\n                    <span className=\"text-xs text-gray-400\">▼</span>",[11953,11996],[11997,11998],[11999,12061],"                  {isPayeeDropdownOpen && (",[12062,12211],"                    <div className=\"absolute w-full mt-1 bg-white border border-[#B0DCDA] rounded-md shadow-xl overflow-hidden\">",[12212,12317],"                      <div className=\"p-2 border-b border-[#B0DCDA] bg-[#FBF8F8]\">",[12318,12632],"                        <input\n                          type=\"text\"\n                          autoFocus\n                          placeholder=\"🔍 Search vendor...\"\n                          value={payeeSearchQuery}\n                          onChange={(e) => setPayeeSearchQuery(e.target.value)}\n                          className=\"w-full bg-white border border-gray-200 rounded p-2 text-sm text-gray-800 outline-none focus:border-[#1B9387]\"",[12656,12684]," />\n                      </div>",[12685,12771],"                      <ul className=\"max-h-48 overflow-y-auto\">",[12796,13076],"<li\n                          onClick={() => {\n                            setPayeeId('')\n                            setPayeeTin('')\n                            setIsPayeeDropdownOpen(false)\n                            setPayeeSearchQuery('')\n                          }}\n                          className=\"p-3 text-sm text-gray-500 hover:bg-[#E9FAFA] hover:text-[#1B9387] cursor-pointer transition font-medium\"\n                        >\n                          -- Clear Selection --",[13101,13219],"</li>\n                        {payees\n                          .filter((p) =>\n                            p.name.toLowerCase().includes(payeeSearchQuery.toLowerCase())\n                          )\n                          .map((p) => (",[13220,13580],"                            <li\n                              key={p.id}\n                              onClick={() => {\n                                setPayeeId(p.id)\n                                setPayeeTin(p.tin || '')\n                                setIsPayeeDropdownOpen(false)\n                                setPayeeSearchQuery('')\n                              }}\n                              className=\"p-3 text-sm text-gray-800 font-bold hover:bg-[#E9FAFA] hover:text-[#1B9387] cursor-pointer transition border-t border-gray-50 flex justify-between items-center\"",[13607,13643],"  >\n                              <div>",[13644,13713],"                                {p.name}",[13746,13884],"{p.tin && (\n                                  <span className=\"block text-[10px] text-gray-400 font-mono font-normal mt-0.5\">\n                                    TIN: {p.tin}\n                                  </span>",[13913,13948],"    )}\n                              </div>",[13979,14109],"{p.youOwe > 0 && (\n                                <span className=\"text-xs text-orange-500 font-mono\">\n                                  {formatCurrency(p.youOwe)}",[14142,14168],"</span>\n                              )}",[14197,14272],"</li>\n                          ))}\n                      </ul>",[14273,14320],[14321,14360],"                  )}",[14377,14400],[14401,14402],[14403,14466],"                {/* Dynamic Payment Method */}",[14483,14505],[14506,14661],"                  <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-2\">\n                    Payment Method\n                  </label>",[14680,14969],"<select\n                    required\n                    value={paymentMethod}\n                    onChange={(e) => setPaymentMethod(e.target.value as any)}\n                    className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-3 text-sm text-gray-800 font-bold focus:border-[#1B9387] outline-none transition cursor-pointer shadow-sm\"",{"messageId":"71332","fix":"71734","desc":"71334"},{"messageId":"71335","fix":"71735","desc":"71337"},[14988,15103],">\n                    <option value=\"\" disabled className=\"text-gray-400 font-normal\">\n                      -- Select Method --",[15124,15181],"</option>\n                    <option value=\"check\">Check</option>",[15182,15270],"                    <option value=\"transfer\">Bank Transfer</option>",[15271,15346],"                    <option value=\"cash\">Cash</option>",[15347,15393],"                  </select>",[15394,15433],"                </div>",[15434,15435],[15436,15474],[15475,15626],"                  <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-2\">\n                    {refLabel}",[15645,15696],"</label>\n                  <div className=\"flex shadow-sm\">",[15697,15917],"                    <span\n                      className={`bg-[#FBF8F8] border border-[#B0DCDA] border-r-0 rounded-l-md px-4 py-3 text-sm font-extrabold select-none ${paymentMethod ? 'text-gray-500' : 'text-gray-300'}`}",[15938,15984],">\n                      {refPrefix || 'XXX-'}",[15985,16033],"                    </span>",[16034,16081],"                    <input",[16082,16138],"                      type=\"text\"",[16139,16192],"                      required",[16193,16263],"                      disabled={!paymentMethod}",[16264,16328],"                      value={refSequence}",[16329,16420],"                      onChange={(e) => setRefSequence(e.target.value)}",[16443,16525],"placeholder={paymentMethod ? '001' : 'Select method first'}",[16526,16800],"                      className=\"w-full bg-white border border-[#B0DCDA] rounded-r-md p-3 text-sm font-mono font-bold text-[#1B9387] focus:border-[#1B9387] outline-none transition disabled:bg-gray-50 disabled:text-gray-400 disabled:cursor-not-allowed\"",[16801,16844],"                    />",[16845,16888],[16889,16928],[16929,16964],[16965,17000],"            </section>",[17001,17002],[17003,17056],"            {/* ② ACCOUNTING DETAILS */}",[17057,17091],[17092,17261],"              <h4 className=\"text-xs font-extrabold text-[#1B9387] uppercase tracking-widest mb-4 border-b border-gray-100 pb-2\">\n                ② Accounting Details",[17276,17351],"</h4>\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 mb-6\">",[17352,17390],[17391,17556],"                  <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1\">\n                    Source of Funds (Credit)",[17575,17692],"</label>\n                  <p className=\"text-[10px] text-gray-400 mb-2 italic\">\n                    Select the asset account paying for this.",[17711,17993],"</p>\n                  <select\n                    required\n                    value={sourceAccount}\n                    onChange={(e) => setSourceAccount(e.target.value)}\n                    className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-3 text-sm text-gray-800 font-bold focus:border-[#1B9387] outline-none transition cursor-pointer shadow-sm\"",[18012,18134],">\n                    {cashAccounts.map((acc) => (\n                      <option key={acc.code} value={acc.code}>\n                        {acc.code} - {acc.name}",[18135,18181],"                      </option>",[18182,18223],[18240,18262],"  </select>\n                </div>\n",[18279,18420],"<div>\n                  <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1\">\n                    Account to Debit",[18439,18565],"</label>\n                  <p className=\"text-[10px] text-gray-400 mb-2 italic\">\n                    Select the expense or account receiving the debit.",[18584,18868],"</p>\n                  <select\n                    required\n                    value={expenseAccount}\n                    onChange={(e) => setExpenseAccount(e.target.value)}\n                    className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-3 text-sm text-gray-800 font-bold focus:border-[#1B9387] outline-none transition cursor-pointer shadow-sm\"",[18887,19003],">\n                    <option value=\"\" disabled className=\"text-gray-400 font-normal\">\n                      -- Select Account --",[19024,19147],"</option>\n                    {expenseAccounts.map((acc) => (\n                      <option key={acc.code} value={acc.code}>\n                        {acc.code} - {acc.name}",[19148,19194],[19215,19272],"))}\n                  </select>\n                </div>",[19287,19336],"</div>\n\n              {/* Massive Total Amount Input */}",[19337,19388],"              <div className=\"mb-6\">",[19389,19548],"                <label className=\"block text-xs font-extrabold text-gray-800 uppercase tracking-widest mb-2\">\n                  Total Disbursement Amount",[19565,19636],"</label>\n                <div className=\"relative flex items-center shadow-sm\">",[19637,19759],"                  <span className=\"absolute left-4 text-gray-400 font-mono font-bold text-2xl\">",[19779,19803]," ₱\n                  </span>",[19822,19959],"<input\n                    type=\"number\"\n                    required\n                    min=\"0.01\"\n                    step=\"0.01\"\n                    value={amount}\n                    onChange={(e) => setAmount(parseFloat(e.target.value))}",[19960,20019],"                    placeholder=\"0.00\"",[20020,20232],"                    className=\"w-full bg-white border-2 border-[#B0DCDA] rounded-lg py-4 pl-12 pr-4 text-3xl text-gray-800 font-mono font-black focus:border-[#1B9387] outline-none transition\"",[20233,20272],"                  />",[20273,20312],[20313,20348],[20349,20350],[20351,20407],"              {/* Live VAT Calculator */}",[20422,20506],"<div className=\"p-5 bg-[#FBF8F8] border border-[#B0DCDA] rounded-lg\">",[20507,20575],"                <div className=\"flex items-center\">",[20594,20810],"<input\n                    type=\"checkbox\"\n                    id=\"isVatableDisb\"\n                    className=\"w-5 h-5 text-[#1B9387] bg-white border-[#B0DCDA] rounded cursor-pointer\"\n                    checked={isVatable}\n                    onChange={(e) => setIsVatable(e.target.checked)}",[20829,21000],"/>\n                  <label\n                    htmlFor=\"isVatableDisb\"\n                    className=\"ml-3 text-sm font-extrabold text-gray-800 cursor-pointer uppercase tracking-wide\"\n                  >\n                    Record 12% Input VAT",[21017,21040],"  </label>\n                </div>",[21041,21089],"                {isVatable && (",[21090,21230],"                  <div className=\"mt-4 pt-4 border-t border-[#B0DCDA] grid grid-cols-1 md:grid-cols-2 gap-6 items-start\">",[21231,21277],"                    <div>",[21278,21450],"                      <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1\">\n                        Supplier TIN (Required)\n                      </label>",[21473,21756],"<input\n                        type=\"text\"\n                        required\n                        placeholder=\"e.g. 123-456-789-000\"\n                        className=\"w-full bg-white border border-[#B0DCDA] rounded-md p-2.5 text-sm font-mono text-gray-800 focus:border-[#1B9387] shadow-sm\"\n                        value={payeeTin}\n                        onChange={(e) => setPayeeTin(e.target.value)}",[21778,21804],[21805,21935],"                    <div className=\"bg-white p-3 rounded border border-gray-200 text-xs shadow-sm font-mono\">",[21936,22121],"                      <div className=\"flex justify-between text-gray-500 mb-1\">\n                        <span>VAT-Inclusive Total:</span>{' '}\n                        <span>{formatCurrency(totalCashOut)}</span>",[22144,22297],"</div>\n                      <div className=\"flex justify-between text-gray-500 mb-1\">\n                        <span>Net Expense:</span> <span>{formatCurrency(netExpense)}</span>",[22320,22396],"</div>\n                      <div className=\"border-t border-gray-100 my-1\"></div>",[22397,22580],"                      <div className=\"flex justify-between text-[#1B9387] font-bold\">\n                        <span>Input VAT (12%):</span> <span>{formatCurrency(inputVat)}</span>",[22581,22628],"                      </div>",[22649,22672],[22691,22708],"</div>\n                )}",[22709,22744],[22745,22780],[22781,22782],[22783,22840],"            {/* ③ SUPPORTING INFORMATION */}",[22841,22875],[22876,23049],"              <h4 className=\"text-xs font-extrabold text-[#1B9387] uppercase tracking-widest mb-4 border-b border-gray-100 pb-2\">\n                ③ Supporting Information",[23064,23134],[23135,23173],[23192,23322],"<label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-2\">\n                    Remarks",[23341,23637],"</label>\n                  <textarea\n                    value={remarks}\n                    onChange={(e) => setRemarks(e.target.value)}\n                    rows={3}\n                    placeholder=\"Optional details...\"\n                    className=\"w-full bg-[#FBF8F8] border border-[#B0DCDA] rounded-md p-3 text-sm text-gray-800 font-medium focus:border-[#1B9387] outline-none shadow-sm resize-none\"",[23654,23677],"  />\n                </div>",[23678,23679],[23680,23718],[23719,23880],"                  <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-2\">\n                    Supporting Documents",[23899,24149],"</label>\n                  <label className=\"w-full flex items-center justify-center bg-[#FBF8F8] border border-dashed border-[#B0DCDA] hover:bg-[#E9FAFA] hover:border-[#1B9387] rounded-md p-4 text-sm font-bold text-[#1B9387] cursor-pointer transition h-14\">",[24150,24218],"                    📎 Attach Receipt / Invoice",[24239,24407],"<input\n                      type=\"file\"\n                      multiple\n                      className=\"hidden\"\n                      onChange={handleFileChange}\n                      accept=\".pdf,.jpg,.png\"\n                    />\n                  </label>",[24408,24473],"                  {attachments.length > 0 && (",[24474,24547],"                    <div className=\"mt-2 space-y-2\">",[24548,24621],"                      {attachments.map((f, i) => (",[24646,24792],"<div\n                          key={i}\n                          className=\"flex justify-between items-center bg-white border border-gray-200 rounded p-2 text-xs shadow-sm\"",[24817,24919],">\n                          <span className=\"truncate max-w-[200px] text-gray-600\">📎 {f.name}</span>",[24946,25095],"<button\n                            type=\"button\"\n                            onClick={() => removeFile(i)}\n                            className=\"text-gray-400 hover:text-red-500 font-bold px-2\"",[25096,25151],"                          >",[25180,25248],"×\n                          </button>\n                        </div>",[25249,25288],"                      ))}",[25289,25328],[25346,25364]," )}\n                </div>",[25379,25400],"</div>\n            </section>",[25401,25402],[25403,25460],"            {/* PAYMENT SUMMARY & SUBMIT */}",[25461,25535],"            <div className=\"border-t-2 border-gray-800 pt-6\">",[25536,25679],"              <h4 className=\"text-sm font-black text-gray-800 uppercase tracking-widest mb-4 text-center\">\n                Payment Summary",[25694,25812],"</h4>\n\n              <div className=\"bg-[#FBF8F8] rounded-xl p-5 mb-6 shadow-inner border border-gray-200 max-w-sm mx-auto\">",[25813,26064],"                <div className=\"flex justify-between text-sm mb-2\">\n                  <span className=\"text-gray-500 font-medium\">Vendor:</span>{' '}\n                  <span className=\"font-bold text-gray-800 truncate w-40 text-right\">\n                    {selectedPayee?.name || '—'}\n                  </span>",[26081,26378],"</div>\n                <div className=\"flex justify-between text-sm mb-2\">\n                  <span className=\"text-gray-500 font-medium\">Account:</span>{' '}\n                  <span className=\"font-bold text-gray-800 truncate w-40 text-right\">\n                    {selectedExpenseData\n                      ? `${selectedExpenseData.code} - ${selectedExpenseData.name}`\n                      : '—'}\n                  </span>",[26395,26690],"</div>\n                <div className=\"flex justify-between text-sm mb-2\">\n                  <span className=\"text-gray-500 font-medium\">Source:</span>{' '}\n                  <span className=\"font-bold text-gray-800 truncate w-40 text-right\">\n                    {selectedSourceData\n                      ? `${selectedSourceData.code} - ${selectedSourceData.name}`\n                      : '—'}\n                  </span>",[26707,26788],"</div>\n\n                {/* 🔥 VAT Summary explicitly surfaced before hitting Submit */}",[26789,26857],"                {isVatable && totalCashOut > 0 && (",[26858,26897],"                  <>",[26898,27006],"                    <div className=\"border-t border-dashed border-gray-300 my-2\"></div>",[27007,27246],"                    <div className=\"flex justify-between text-sm mb-1\">\n                      <span className=\"text-gray-500 font-medium\">Net Expense:</span>{' '}\n                      <span className=\"font-bold text-gray-800\">{formatCurrency(netExpense)}</span>",[27267,27490],"</div>\n                    <div className=\"flex justify-between text-sm mb-2\">\n                      <span className=\"text-[#1B9387] font-medium\">Input VAT (12%):</span>{' '}\n                      <span className=\"font-bold text-[#1B9387]\">{formatCurrency(inputVat)}</span>",[27511,27531],"</div>\n                  </>",[27532,27567],[27568,27569],[27570,27670],"                <div className=\"border-t border-dashed border-gray-300 my-3\"></div>",[27671,27918],"                <div className=\"flex justify-between text-lg font-black text-gray-800\">\n                  <span className=\"uppercase tracking-widest\">Total</span>{' '}\n                  <span className=\"font-mono text-[#1B9387]\">{formatCurrency(totalCashOut)}</span>",[27919,27956],[27971,27993],"</div>\n\n              <button",[27994,28040],"                type=\"submit\"",[28041,28108],"                disabled={!isFormValid || loading}",[28109,28285],"                className={`w-full py-4 rounded-lg font-black uppercase tracking-widest transition shadow-md flex justify-center items-center space-x-2 text-sm",[28324,28336],"\n                                      isFormValid",[28438,28439],[28563,28564],[28604,28605],[28606,28636],[28653,28809],"{loading\n                  ? 'Processing...'\n                  : isFormValid\n                    ? `💸 Issue Disbursement — ${formatCurrency(totalCashOut)}`\n                    : 'Complete Required Fields to Issue'}",[28810,28848],[28849,28880],[28881,28909],"          </form>",[28910,28933],[28934,28935],[28936,29005],"        {/* 🔥 RIGHT SIDE: RECENT ACTIVITY (Now Sticky!) */}",[29014,29092],"<div className=\"w-full lg:w-96 flex flex-col space-y-4 sticky top-6\">",[29093,29196],"          <div className=\"bg-white border border-[#B0DCDA] rounded-xl p-5 shadow-sm h-full\">",[29197,29309],"            <div className=\"flex items-center justify-between border-b border-[#B0DCDA] pb-3 mb-4\">",[29310,29442],"              <h3 className=\"text-sm font-extrabold text-gray-700 uppercase tracking-wider\">\n                Recent Disbursements",[29457,29569],"</h3>\n              <span className=\"text-xs text-[#1B9387] font-bold cursor-pointer hover:underline\">\n                View All",[29584,29601],[29602,29603],[29604,29691],"            <div className=\"space-y-3 overflow-y-auto max-h-[700px] pr-1\">",[29692,29753],"              {recentVouchers.length === 0 ? (",[29754,29882],"                <p className=\"text-xs text-gray-400 italic text-center mt-8\">\n                  No recent disbursements found.",[29897,29917],"  </p>\n              ) : (",[29918,29994],"                recentVouchers.map((v: any, i: number) => (",{"messageId":"71332","fix":"71736","desc":"71334"},{"messageId":"71335","fix":"71737","desc":"71337"},[30013,30177],"<div\n                    key={i}\n                    className=\"bg-[#FBF8F8] border border-[#B0DCDA]/60 rounded-lg p-4 shadow-sm hover:border-[#1B9387] transition cursor-pointer group\"",[30196,30275],">\n                    <div className=\"flex justify-between items-center mb-2\">",[30276,30431],"                      <span className=\"text-xs font-mono font-extrabold text-[#1B9387] group-hover:underline\">\n                        {v.referenceNo}",[30454,30587],"</span>\n                      <span className=\"text-[10px] font-bold text-gray-400 uppercase\">\n                        {new Date(v.date).toLocaleDateString()}",[30610,30635],"</span>\n                    </div>",[30636,30780],"                    <p className=\"text-sm font-extrabold text-gray-800 truncate mb-1\">\n                      {v.payeeName || 'Unknown Vendor'}",[30801,30905],"</p>\n                    <div className=\"flex justify-between items-end mt-3 border-t border-gray-200 pt-2\">",[30906,31041],"                      <span className=\"text-[10px] text-emerald-600 font-bold flex items-center\">\n                        ✓ ISSUED",[31064,31183],"</span>\n                      <span className=\"text-base font-mono font-black text-rose-600\">\n                        {formatCurrency(v.amount)}",[31206,31231],[31232,31275],[31276,31311],"                ))",[31312,31343],[31344,31375],[31376,31403],[31404,31427],[31428,31447],[31448,31449],[31450,31489],"      {/* CONFIRMATION MODAL */}",[31490,31525],"      {showConfirmModal && (",[31526,31667],"        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-gray-900/40 backdrop-blur-sm p-4 animate-in fade-in\">",[31668,31794],"          <div className=\"bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden border border-[#B0DCDA]\">",[31795,31877],"            <div className=\"bg-[#1B9387] p-5 text-center text-white\">",[31878,31993],"              <h2 className=\"text-xl font-black uppercase tracking-widest\">Confirm Disbursement</h2>",[31994,32122],"              <p className=\"text-sm font-medium mt-1 text-[#E9FAFA]\">\n                Review details before posting to ledger.",[32137,32154],"</p>\n            </div>",[32155,32245],"            <div className=\"p-6 space-y-4 text-sm font-medium text-gray-600\">",[32246,32440],"              <div className=\"flex justify-between border-b border-gray-100 pb-2\">\n                <span>Vendor:</span>{' '}\n                <span className=\"font-bold text-gray-800\">{selectedPayee?.name}</span>",[32455,32685],"</div>\n              <div className=\"flex justify-between border-b border-gray-100 pb-2\">\n                <span>Account to Debit:</span>{' '}\n                <span className=\"font-bold text-gray-800 truncate max-w-[200px] text-right\">\n                  {selectedExpenseData?.name}\n                </span>",[32700,32928],"</div>\n              <div className=\"flex justify-between border-b border-gray-100 pb-2\">\n                <span>Source of Funds:</span>{' '}\n                <span className=\"font-bold text-gray-800 truncate max-w-[200px] text-right\">\n                  {selectedSourceData?.name}\n                </span>",[32943,33159],"</div>\n              <div className=\"flex justify-between border-b border-gray-100 pb-2\">\n                <span>{refLabel}:</span>{' '}\n                <span className=\"font-mono font-bold text-gray-800\">\n                  {refPrefix}\n                  {refSequence.padStart(3, '0')}\n                </span>",[33174,33272],"</div>\n\n              <div className=\"bg-[#FBF8F8] p-4 rounded-lg mt-4 border border-gray-200 font-mono\">",[33273,33421],"                <div className=\"flex justify-between mb-1\">\n                  <span>Net Amount:</span> <span>{formatCurrency(netExpense)}</span>",[33438,33567],"</div>\n                <div className=\"flex justify-between mb-1\">\n                  <span>Input VAT:</span> <span>{formatCurrency(inputVat)}</span>",[33584,33654],"</div>\n                <div className=\"border-t border-gray-300 my-2\"></div>",[33655,33861],"                <div className=\"flex justify-between text-lg font-black text-[#1B9387]\">\n                  <span className=\"font-sans uppercase\">Total:</span>{' '}\n                  <span>{formatCurrency(totalCashOut)}</span>",[33862,33897],[33898,33929],[33942,34039],"</div>\n            <div className=\"p-4 bg-gray-50 border-t border-gray-200 flex justify-end space-x-3\">",[34054,34255],"<button\n                onClick={() => setShowConfirmModal(false)}\n                className=\"px-5 py-2.5 rounded-md font-bold text-gray-600 bg-white border border-gray-300 hover:bg-gray-100 transition\"\n              >\n                Cancel\n              </button>",[34270,34476],"<button\n                onClick={executeSubmit}\n                className=\"px-5 py-2.5 rounded-md font-black uppercase tracking-wider text-white bg-[#1B9387] hover:bg-[#28958B] shadow-md transition\"\n              >\n                Confirm & Issue",[34491,34508],[34509,34536],[34537,34560],[34561,34576],[34577,34578],[34579,34800],"      <NewContactModal\n        isOpen={showAddPayee}\n        onClose={() => setShowAddPayee(false)}\n        onSaveSuccess={() => {\n          loadData()\n          setStatus({ type: 'success', msg: 'Vendor successfully added!' })\n        }}\n        defaultType=\"SUPPLIER\"",[34806,34816],[34817,34824],[34826,34827],[30,31],[84,85],[114,115],[116,117],[186,187],{"messageId":"71332","fix":"71738","desc":"71334"},{"messageId":"71335","fix":"71739","desc":"71337"},[249,250],[298,299],[354,355],[385,386],[402,403],[421,422],[423,424],[441,442],[493,494],[562,563],{"messageId":"71332","fix":"71740","desc":"71334"},{"messageId":"71335","fix":"71741","desc":"71337"},[629,