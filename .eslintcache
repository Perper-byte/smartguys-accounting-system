white print:hidden\">",[34400,34449],"            {/* Header Actions */}",[34450,34578],"            <div className=\"p-6 border-b border-[#B0DCDA] flex justify-between items-center bg-[#FBF8F8] shrink-0\">",[34579,34649],"              <div className=\"flex items-center gap-4\">",[34650,34689],[34708,34772],"type=\"text\"\n                  placeholder=\"Search employees...\"",[34773,34872],"                  value={dirSearch}\n                  onChange={(e) => setDirSearch(e.target.value)}",[34873,35041],"                  className=\"w-64 bg-white border border-[#B0DCDA] rounded-md p-2.5 text-sm outline-none focus:border-[#1B9387] transition shadow-sm\"",[35042,35077],[35078,35191],"                <div className=\"flex bg-white rounded-md border border-[#B0DCDA] shadow-sm p-1\">",[35192,35288],"                  {(['ACTIVE', 'INCOMPLETE', 'ARCHIVED'] as const).map((f) => (",[35289,35337],"                    <button",[35360,35422],"key={f}\n                      onClick={() => setDirFilter(f)}",[35423,35644],"                      className={`px-4 py-1.5 text-xs font-bold rounded uppercase tracking-wider transition ${dirFilter === f ? 'bg-[#E9FAFA] text-[#1B9387]' : 'text-gray-500 hover:text-gray-800'}`}",[35665,35687],">\n                      {f}",[35708,35736],"</button>\n                  ))}",[35749,35787],"    </div>\n              </div>\n              <button",[35804,35828],"onClick={() => {\n                  setNewEmp({",[35849,35904],"id: '',\n                    firstName: '',\n                    lastName: '',",[35925,36151],"position: '',\n                    monthlySalary: '',\n                    tin: '',\n                    sss: '',\n                    philhealth: '',\n                    pagibig: ''\n                  })\n                  setIsEmpModalOpen(true)",[36168,36350],"}}\n                className=\"px-5 py-2.5 bg-[#1B9387] hover:bg-[#28958B] text-white rounded-md text-sm font-bold transition shadow-sm uppercase tracking-wider flex items-center gap-2\"",[36351,36381],[36382,36442],"                <span>+</span> Add Employee",[36443,36481],[36482,36513],[36514,36515],[36516,36564],"            {/* Directory Table */}",[36565,36628],"            <div className=\"flex-1 overflow-auto\">",[36629,36702],"              <table className=\"w-full text-left text-sm\">",[36703,36809],"                <thead className=\"bg-white border-b-2 border-gray-200 sticky top-0 z-10\">",[36810,36929],"                  <tr className=\"text-gray-500 uppercase tracking-wider text-[10px] font-extrabold\">",[36930,37012],"                    <th className=\"p-4 pl-6 w-32\">Status</th>",[37013,37094],"                    <th className=\"p-4\">Name & Position</th>",[37095,37187],"                    <th className=\"p-4 text-right\">Base Salary (₱)</th>",[37188,37273],"                    <th className=\"p-4 w-64\">Government IDs</th>",[37274,37363],"                    <th className=\"p-4 pr-6 text-right\">Actions</th>",[37364,37406],[37407,37448],[37449,37526],"                <tbody className=\"divide-y divide-gray-100\">",[37527,37599],"                  {filteredEmployees.length === 0 ? (",[37620,37758],"<tr>\n                      <td colSpan={5} className=\"p-16 text-center text-gray-400 italic\">\n                        No employees found matching criteria.",[37781,37801],[37820,37875],") : (\n                    filteredEmployees.map((emp) => {",[37876,37962],"                      const isActive = emp.is_active !== false",[37963,38054],"                      const isMissingInfo = !emp.tin || !emp.sss_no",[38055,38056],[38079,38110],"return (\n                        <tr",[38137,38273],"key={emp.id}\n                          className={`transition-colors hover:bg-gray-50 ${!isActive ? 'opacity-60 bg-gray-50/50' : ''}`}",[38298,38352],">\n                          <td className=\"p-4 pl-6\">",[38353,38461],"                            <div className=\"flex flex-col items-start gap-1.5\">",[38462,38536],"                              {isActive ? (",[38537,38775],"                                <span className=\"px-2.5 py-1 bg-emerald-50 border border-emerald-200 text-emerald-600 text-[10px] font-extrabold rounded-md uppercase tracking-wider shadow-sm\">",[38810,38842],"Active\n                                </span>",[38873,39075],") : (\n                                <span className=\"px-2.5 py-1 bg-gray-100 border border-gray-300 text-gray-500 text-[10px] font-extrabold rounded-md uppercase tracking-wider shadow-sm\">",[39109,39139]," Archived\n                                </span>",[39170,39232],")}\n                              {isActive && isMissingInfo && (",[39233,39486],"                                <span\n                                  className=\"px-2 py-0.5 bg-yellow-50 text-yellow-600 border border-yellow-200 text-[9px] font-bold rounded-sm uppercase flex items-center shadow-sm\"\n                                  title=\"Missing TIN or SSS Number\"",[39519,39569],">\n                                  ⚠️ Incomplete",[39570,39642],"                                </span>",[39643,39706],"                              )}",[39707,39770],[39771,39829],"                          </td>",[39830,39903],"                          <td className=\"p-4\">",[39904,40051],"                            <p className=\"font-extrabold text-gray-800 text-base\">\n                              {emp.first_name} {emp.last_name}",[40080,40207],"</p>\n                            <p className=\"text-xs text-[#1B9387] font-bold uppercase tracking-wider mt-0.5\">",[40238,40266],"{emp.position}\n                            </p>",[40293,40398],"</td>\n                          <td className=\"p-4 text-right font-mono text-gray-800 font-bold tabular-nums\">",[40399,40538],"                            {Number(emp.monthly_salary).toLocaleString('en-US', {\n                              minimumFractionDigits: 2",[40567,40597],"})}\n                          </td>",[40598,40691],"                          <td className=\"p-4 text-xs space-y-1.5\">",[40692,40852],"                            <div className=\"flex justify-between items-center bg-gray-50 px-2 py-1 rounded border border-gray-100\">",[40853,40988],"                              <span className=\"text-gray-500 font-bold text-[10px] uppercase\">\n                                TIN\n                              </span>",[41019,41165],"<span\n                                className={`font-mono font-bold ${emp.tin ? 'text-gray-800' : 'text-red-400'}`}\n                              >",[41198,41229],"{emp.tin || 'Missing'}\n                              </span>",[41258,41390],"</div>\n                            <div className=\"flex justify-between items-center bg-gray-50 px-2 py-1 rounded border border-gray-100\">",[41391,41526],"                              <span className=\"text-gray-500 font-bold text-[10px] uppercase\">\n                                SSS\n                              </span>",[41557,41709],"<span\n                                className={`font-mono font-bold ${emp.sss_no ? 'text-gray-800' : 'text-red-400'}`}\n                              >",[41742,41773],"{emp.sss_no || 'Missing'}",[41804,41832],"</span>\n                            </div>",[41859,41932],"</td>\n                          <td className=\"p-4 pr-6 text-right space-x-2\">",[41933,41997],"                            <button",[41998,42096],"                              onClick={() => openEditEmployee(emp)}",[42097,42321],"                              className=\"text-xs font-bold text-gray-500 hover:text-[#1B9387] bg-white border border-gray-300 hover:border-[#1B9387] px-3.5 py-2 rounded-md transition shadow-sm\"",[42322,42380],[42381,42446],"                              Edit",[42475,42513],"</button>\n                            <button",[42544,42578],"onClick={() =>\n                                setEmployeeToToggle({",[42613,42745],"id: emp.id,\n                                  name: `${emp.first_name} ${emp.last_name}`,\n                                  isActive\n                                })",[42776,42997],"}\n                              className={`text-xs font-bold px-3.5 py-2 rounded-md transition shadow-sm border ${\n                                isActive\n                                  ? 'bg-white border-gray-300 text-gray-500 hover:border-red-300 hover:text-red-600 hover:bg-red-50'",[42998,43172],"                                  : 'bg-white border-gray-300 text-gray-500 hover:border-[#1B9387] hover:text-[#1B9387] hover:bg-[#E9FAFA]'",[43173,43241],"                              }`}",[43242,43300],[43301,43396],"                              {isActive ? 'Archive' : 'Restore'}",[43397,43463],[43464,43522],[43523,43577],"                        </tr>",[43578,43625],"                      )",[43626,43669],"                    })",[43670,43709],[43710,43751],[43752,43789],[43790,43821],[43832,43849],[43850,43869],[43870,43871],[43872,43939],[43940,44007],"        {/* MODALS                                     */}",[44008,44075],[44076,44077],[44078,44126],"        {/* Add/Edit Employee Modal */}",[44127,44164],"        {isEmpModalOpen && (",[44165,44297],"          <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm print:hidden\">",[44298,44483],"            <div className=\"bg-white border border-[#B0DCDA] rounded-xl shadow-2xl w-[500px] animate-in zoom-in-95 duration-200 overflow-hidden flex flex-col max-h-[90vh]\">",[44484,44613],"              <div className=\"px-6 py-4 bg-[#FBF8F8] border-b border-[#B0DCDA] flex justify-between items-center\">",[44614,44779],"                <h3 className=\"text-lg font-extrabold text-gray-800 uppercase tracking-wide\">\n                  {newEmp.id ? 'Edit Employee' : 'Add New Employee'}",[44796,44936],"</h3>\n                <button\n                  onClick={() => setIsEmpModalOpen(false)}\n                  className=\"text-gray-400 hover:text-gray-700 text-xl font-bold\"\n                >",[44951,44972],"    ×\n                </button>",[44987,45039],"</div>\n              <div className=\"p-6 overflow-y-auto\">",[45040,45144],"                <form id=\"empForm\" onSubmit={handleSaveEmployee} className=\"space-y-4\">",[45145,45222],"                  <div className=\"grid grid-cols-2 gap-4\">",[45243,45655],"<div>\n                      <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1\">\n                        First Name *\n                      </label>\n                      <input\n                        type=\"text\"\n                        required\n                        value={newEmp.firstName}\n                        onChange={(e) => setNewEmp({ ...newEmp, firstName: e.target.value })}\n                        className=\"w-full bg-white border border-gray-300 rounded p-2 text-sm text-gray-800 font-bold focus:border-[#1B9387] outline-none shadow-sm\"\n                      />\n                    </div>",[45676,46085],"<div>\n                      <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1\">\n                        Last Name *\n                      </label>\n                      <input\n                        type=\"text\"\n                        required\n                        value={newEmp.lastName}\n                        onChange={(e) => setNewEmp({ ...newEmp, lastName: e.target.value })}\n                        className=\"w-full bg-white border border-gray-300 rounded p-2 text-sm text-gray-800 font-bold focus:border-[#1B9387] outline-none shadow-sm\"",[46108,46129],[46148,46207],"</div>\n                  <div className=\"grid grid-cols-2 gap-4\">",[46228,46669],"<div>\n                      <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1\">\n                        Position / Title *\n                      </label>\n                      <input\n                        type=\"text\"\n                        required\n                        value={newEmp.position}\n                        onChange={(e) => setNewEmp({ ...newEmp, position: e.target.value })}\n                        placeholder=\"e.g. Nurse\"\n                        className=\"w-full bg-white border border-gray-300 rounded p-2 text-sm text-gray-800 font-bold focus:border-[#1B9387] outline-none shadow-sm\"\n                      />\n                    </div>",[46690,47207],"<div>\n                      <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1\">\n                        Monthly Salary (₱) *\n                      </label>\n                      <input\n                        type=\"number\"\n                        step=\"0.01\"\n                        required\n                        value={newEmp.monthlySalary}\n                        onChange={(e) => setNewEmp({ ...newEmp, monthlySalary: e.target.value })}\n                        placeholder=\"0.00\"\n                        className=\"w-full bg-white border border-gray-300 rounded p-2 text-sm font-mono font-bold text-gray-800 focus:border-[#1B9387] outline-none shadow-sm\"\n                      />\n                    </div>",[47226,47297],"</div>\n\n                  <div className=\"pt-4 mt-4 border-t border-gray-200\">",[47298,47442],"                    <h4 className=\"text-xs font-extrabold text-gray-800 uppercase tracking-widest mb-4\">\n                      Government IDs",[47463,47524],"</h4>\n                    <div className=\"grid grid-cols-2 gap-4\">",[47525,47591],"                      {/* Masked Inputs */}",[47614,48188],"<div>\n                        <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1 flex justify-between\">\n                          BIR TIN {!newEmp.tin && <span className=\"text-red-400\">Required</span>}\n                        </label>\n                        <input\n                          type=\"text\"\n                          value={newEmp.tin}\n                          onChange={(e) => setNewEmp({ ...newEmp, tin: formatTIN(e.target.value) })}\n                          placeholder=\"000-000-000-000\"\n                          className={`w-full bg-white border rounded p-2 text-sm font-mono font-bold text-gray-800 focus:border-[#1B9387] outline-none shadow-sm ${!newEmp.tin ? 'border-red-300 bg-red-50' : 'border-gray-300'}`}\n                        />\n                      </div>",[48211,48782],"<div>\n                        <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1 flex justify-between\">\n                          SSS No. {!newEmp.sss && <span className=\"text-red-400\">Required</span>}\n                        </label>\n                        <input\n                          type=\"text\"\n                          value={newEmp.sss}\n                          onChange={(e) => setNewEmp({ ...newEmp, sss: formatSSS(e.target.value) })}\n                          placeholder=\"00-0000000-0\"\n                          className={`w-full bg-white border rounded p-2 text-sm font-mono font-bold text-gray-800 focus:border-[#1B9387] outline-none shadow-sm ${!newEmp.sss ? 'border-red-300 bg-red-50' : 'border-gray-300'}`}\n                        />\n                      </div>",[48805,49265],"<div>\n                        <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1\">\n                          PhilHealth No.\n                        </label>\n                        <input\n                          type=\"text\"\n                          value={newEmp.philhealth}\n                          onChange={(e) =>\n                            setNewEmp({ ...newEmp, philhealth: formatPHIC(e.target.value) })\n                          }\n                          placeholder=\"00-000000000-0\"\n                          className=\"w-full bg-white border border-gray-300 rounded p-2 text-sm font-mono font-bold text-gray-800 focus:border-[#1B9387] outline-none shadow-sm\"\n                        />\n                      </div>",[49288,49740],"<div>\n                        <label className=\"block text-[10px] font-extrabold text-gray-500 uppercase tracking-wider mb-1\">\n                          Pag-IBIG No.\n                        </label>\n                        <input\n                          type=\"text\"\n                          value={newEmp.pagibig}\n                          onChange={(e) =>\n                            setNewEmp({ ...newEmp, pagibig: formatHDMF(e.target.value) })\n                          }\n                          placeholder=\"0000-0000-0000\"\n                          className=\"w-full bg-white border border-gray-300 rounded p-2 text-sm font-mono font-bold text-gray-800 focus:border-[#1B9387] outline-none shadow-sm\"",[49765,49788],[49789,49832],[49851,49873],"</div>\n                </form>",[49874,49909],[49910,50025],"              <div className=\"px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end gap-3\">",[50042,50290],"<button\n                  type=\"button\"\n                  onClick={() => setIsEmpModalOpen(false)}\n                  className=\"px-5 py-2.5 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 rounded-md text-sm font-bold transition cursor-pointer shadow-sm\"\n                >\n                  Cancel\n                </button>",[50307,50561],"<button\n                  type=\"submit\"\n                  form=\"empForm\"\n                  disabled={loading}\n                  className=\"px-6 py-2.5 bg-[#1B9387] hover:bg-[#28958B] text-white font-bold rounded-md transition cursor-pointer shadow-sm uppercase tracking-wider text-sm flex items-center gap-2\"",[50578,50668],">\n                  {loading ? <span className=\"animate-spin\">↻</span> : 'Save Employee'}",[50669,50711],[50712,50747],[50748,50779],[50780,50807],[50816,50827],[50828,50829],[50830,50883],"        {/* Archive/Restore Confirmation */}",[50884,50923],"        {employeeToToggle && (",[50924,51056],[51057,51203],"            <div className=\"bg-white border border-[#B0DCDA] rounded-xl shadow-2xl p-8 w-[420px] animate-in zoom-in-95 duration-200\">",[51204,51315],"              <h3 className=\"text-xl font-extrabold text-gray-800 mb-2 uppercase tracking-wide\">",[51316,51420],"                {employeeToToggle.isActive ? 'Archive Employee?' : 'Restore Employee?'}",[51421,51455],[51456,51555],"              <p className=\"text-sm text-gray-600 mb-8 font-medium leading-relaxed\">",[51556,51615],"                {employeeToToggle.isActive ? (\n                  <>",[51636,51784],"Archive <strong className=\"text-gray-800\">{employeeToToggle.name}</strong>? They\n                    will be hidden from the active payroll run.\n                  </>",[51801,51955],") : (\n                  <>\n                    Restore <strong className=\"text-gray-800\">{employeeToToggle.name}</strong>? They\n                    will be added back to the active payroll run.",[51956,51990],"                  </>",[52005,52024],"  )}\n              </p>",[52025,52124],[52141,52371],"<button\n                  onClick={() => setEmployeeToToggle(null)}\n                  className=\"px-5 py-2.5 bg-[#FBF8F8] border border-[#B0DCDA] hover:bg-gray-100 text-gray-600 rounded-md text-sm font-bold transition cursor-pointer\"\n                >\n                  Cancel\n                </button>",[52388,52642],"<button\n                  onClick={confirmToggleStatus}\n                  className={`px-5 py-2.5 text-white rounded-md text-sm font-bold transition cursor-pointer shadow-sm ${employeeToToggle.isActive ? 'bg-red-500 hover:bg-red-600' : 'bg-[#1B9387] hover:bg-[#28958B]'}`}",[52659,52731],">\n                  {employeeToToggle.isActive ? 'Archive' : 'Restore'}",[52732,52774],[52775,52810],[52811,52842],[52843,52870],[52871,52890],[52891,52892],[52893,52947],"        {/* 🔥 PRINTABLE PAYSLIP MODAL 🔥 */}",[52948,52986],"        {selectedPayslip && (",[52987,53165],"          <div className=\"fixed inset-0 z-[60] flex items-center justify-center bg-black/60 backdrop-blur-sm print:bg-white print:static print:block print:inset-auto\">",[53166,53336],"            <div className=\"bg-white border border-gray-200 rounded-xl shadow-2xl p-10 w-[600px] print:w-full print:border-none print:shadow-none print:p-0\">",[53351,53432],"<div className=\"text-center mb-6 pb-4 border-b-2 border-gray-800\">",[53433,53552],"                <h2 className=\"text-2xl font-black text-gray-800 tracking-tight\">\n                  SMARTGUYS CLINIC",[53569,53691],"</h2>\n                <h3 className=\"text-sm font-extrabold text-gray-500 uppercase tracking-widest mt-1\">\n                  Employee Payslip",[53708,53727],"</h3>\n              </div>",[53728,53885],"              <div className=\"grid grid-cols-2 gap-4 text-sm font-medium text-gray-700 mb-8 bg-gray-50 p-4 rounded-lg border border-gray-200\">",[53886,54168],"                <div>\n                  <span className=\"text-gray-500 font-bold uppercase text-[10px] tracking-wider block\">\n                    Employee\n                  </span>\n                  <span className=\"text-base font-extrabold text-gray-800\">\n                    {selectedPayslip.employee.first_name} {selectedPayslip.employee.last_name}\n                  </span>\n                </div>",[54185,54397],"<div>\n                  <span className=\"text-gray-500 font-bold uppercase text-[10px] tracking-wider block\">\n                    Position\n                  </span>\n                  <span className=\"text-gray-800 font-bold\">\n                    {selectedPayslip.employee.position}\n                  </span>\n                </div>",[54414,54660],"<div>\n                  <span className=\"text-gray-500 font-bold uppercase text-[10px] tracking-wider block\">\n                    Payroll Period\n                  </span>\n                  <span className=\"font-mono text-gray-800 font-bold\">\n                    {new Date(selectedPayslip.date).toLocaleDateString()}\n                  </span>\n                </div>",[54677,54899],"<div>\n                  <span className=\"text-gray-500 font-bold uppercase text-[10px] tracking-wider block\">\n                    Reference No.\n                  </span>\n                  <span className=\"font-mono text-gray-800 font-bold\">\n                    {selectedPayslip.reference_no}",[54918,54935],[54950,55010],"</div>\n              <div className=\"grid grid-cols-2 gap-6 mb-8\">",[55011,55049],[55050,55213],"                  <h4 className=\"text-[10px] font-black text-blue-600 uppercase tracking-wider mb-2 border-b border-blue-200 pb-1\">\n                    Earnings",[55232,55286],"</h4>\n                  <div className=\"space-y-2 text-sm\">",[55287,55533],"                    <div className=\"flex justify-between\">\n                      <span className=\"text-gray-600\">Base Pay</span>\n                      <span className=\"font-mono text-gray-800 font-bold tabular-nums\">\n                        {formatCurrency(selectedPayslip.base_pay)}\n                      </span>",[55554,55780],"</div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-gray-600\">Overtime</span>\n                      <span className=\"font-mono text-gray-800 font-bold tabular-nums\">\n                        {formatCurrency(selectedPayslip.overtime)}\n                      </span>",[55801,56031],"</div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-gray-600\">Night Diff</span>\n                      <span className=\"font-mono text-gray-800 font-bold tabular-nums\">\n                        {formatCurrency(selectedPayslip.night_diff)}\n                      </span>",[56052,56287],"</div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-gray-600\">Other Earn.</span>\n                      <span className=\"font-mono text-gray-800 font-bold tabular-nums\">\n                        {formatCurrency(selectedPayslip.other_earnings)}",[56310,56331],[56350,56475],"</div>\n                  <div className=\"flex justify-between mt-3 pt-2 border-t border-gray-200 text-sm font-black text-blue-600\">",[56476,56630],"                    <span>GROSS PAY</span>\n                    <span className=\"font-mono tabular-nums\">\n                      {formatCurrency(selectedPayslip.gross_pay)}",[56651,56674],[56675,56714],[56715,56753],[56754,56923],"                  <h4 className=\"text-[10px] font-black text-orange-500 uppercase tracking-wider mb-2 border-b border-orange-200 pb-1\">\n                    Deductions",[56942,56996],[56997,57233],"                    <div className=\"flex justify-between\">\n                      <span className=\"text-gray-600\">SSS</span>\n                      <span className=\"font-mono text-gray-800 font-bold tabular-nums\">\n                        {formatCurrency(selectedPayslip.sss)}\n                      </span>",[57254,57484],"</div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-gray-600\">PhilHealth</span>\n                      <span className=\"font-mono text-gray-800 font-bold tabular-nums\">\n                        {formatCurrency(selectedPayslip.philhealth)}\n                      </span>",[57505,57730],"</div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-gray-600\">Pag-IBIG</span>\n                      <span className=\"font-mono text-gray-800 font-bold tabular-nums\">\n                        {formatCurrency(selectedPayslip.pagibig)}\n                      </span>",[57751,57982],"</div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-gray-600\">Cash Adv.</span>\n                      <span className=\"font-mono text-gray-800 font-bold tabular-nums\">\n                        {formatCurrency(selectedPayslip.cash_advance)}\n                      </span>",[58003,58235],"</div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-gray-600\">License Fee</span>\n                      <span className=\"font-mono text-gray-800 font-bold tabular-nums\">\n                        {formatCurrency(selectedPayslip.license_fee)}\n                      </span>",[58256,58492],"</div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-gray-600\">Other Ded.</span>\n                      <span className=\"font-mono text-gray-800 font-bold tabular-nums\">\n                        {formatCurrency(selectedPayslip.other_deductions)}\n                      </span>",[58513,58760],"</div>\n                    <div className=\"flex justify-between text-red-500 font-bold\">\n                      <span className=\"uppercase text-xs tracking-wider\">Tax W/H</span>\n                      <span className=\"font-mono tabular-nums\">\n                        {formatCurrency(selectedPayslip.tax_withheld)}",[58781,58804],"  </span>\n                    </div>",[58823,58950],"</div>\n                  <div className=\"flex justify-between mt-3 pt-2 border-t border-gray-200 text-sm font-black text-orange-600\">",[58951,59146],"                    <span>TOTAL DEDUCT</span>\n                    <span className=\"font-mono tabular-nums\">\n                      {formatCurrency(\n                        selectedPayslip.total_deductions + selectedPayslip.tax_withheld",[59169,59230],")}\n                    </span>\n                  </div>",[59231,59266],[59267,59409],"              <div cl